  flu: ["Avian influenza", "Sudden deaths, swollen head, breathing problems, drop in eating", "No treatment; report to veterinary authorities, isolate"],
  asp: ["Aspergillosis", "Open-mouth breathing, tail bobbing, voice change, weakness", "Vet-prescribed antifungals, sometimes nebulization; fix mould and dust"],
  bumble: ["Bumblefoot", "Swollen or sore foot pad, limping, scabs on the sole", "Vet cleaning of the wound, bandaging and antibiotics"],
  cocc: ["Coccidiosis", "Diarrhoea (sometimes bloody), weight loss, ruffled feathers", "Vet-prescribed anticoccidial medicine; clean, dry housing"],
  mite: ["Mites and lice", "Itching, scaly crusts, feather damage, restlessness", "Vet-approved antiparasitic treatment; clean cage and perches"],
};

