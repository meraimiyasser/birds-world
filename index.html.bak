    song_playing:"Now playing", song_live:"live",
    symtom:"Symptoms", treat:"Treatment", med_advice:"General information only — see an avian vet.",
    notes_h:"Personal notes", save:"Save", note_saved:"Note saved", unsaved:"Unsaved",
    life_list:"Life list", export_json:"Export JSON", export_csv:"Export CSV", import:"Import backup",
