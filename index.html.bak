    atlas_row:"Atlas", atlas_tax:"Classification", atlas_enrich:"Fetch Arabic name and photo", atlas_enriching:"Enriching…",
    atlas_include:"Include atlas species in search", atlas_off:"Atlas import needs a connection.", atlas_throttled:"Slowed down: too many requests.",
    atlas_noimg:"No freely licensed photo found", atlas_cleared:"Atlas data deleted", atlas_enriched:"Added",
    atlas_promote:"Log a sighting", atlas_quick:"Quick import", atlas_deep:"Deep import",
    src_guide:"Care guide", src_atlas:"Species atlas", stat_atlas:"Atlas species",
