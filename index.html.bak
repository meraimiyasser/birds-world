    geo_ok:"Position captured", geo_fail:"Location unavailable — enter it manually.",
    my_h:"My birds", add_h:"Add a bird", nick:"Name", acquired:"Acquired", sex:"Sex", ring:"Ring / ID",
    weight_h:"Weight log", w_add:"Add weight", kg:"g", no_data:"No records yet.",
    care_h:"Care tasks", due:"Due", t_done:"Done", overdue:"overdue",
    srs_h:"Review queue", srs_done:"Nothing due — you're all caught up.", again:"Again", good:"Good", easy:"Easy",
    quiz_h:"Sound & name quiz", answer:"Your answer", right:"Correct", wrong:"Wrong", next:"Next", streak:"Streak", points:"Points",
    badges:"Badges", lvl:"Level",
    wiz_h:"Which bird suits you?", wiz_next:"Next", wiz_back:"Back", wiz_result:"Your best matches", wiz_restart:"Start over",
    settings_h:"Settings", theme:"Theme", language:"Language", accent:"Accent colour", api_base:"Community sync URL (optional)",
    api_hint:"Leave empty for pure local mode. Set a REST base to push sightings and birds to a shared database.",
    storage:"Storage", clear_all:"Delete all my data", confirm_clear:"This permanently deletes favorites, notes, birds, sightings and progress on this device. Continue?",
    sync_now:"Sync now", outbox:"Queued writes", remote_ok:"Sync complete", remote_fail:"Sync failed — writes stay queued.",
    last_sync:"Last sync", offline:"Offline — using cached data.", online:"Back online.",
    compare_hint:"Tick Compare on species cards (up to 3).", radar:"Shape comparison",
    which_bird:"Which species is it?",
    copy:"Link copied", shared:"Shared", install:"Install app",

    /* atlas */
    nav_atlas:"Atlas", atlas_h:"World bird atlas", atlas_source:"Names and classification: the GBIF backbone for class Aves. Arabic names and photos: Wikidata and Wikimedia Commons. The import walks the tree family by family — one order finishes in minutes, the whole class runs longer and can be stopped at any point. Pages already fetched are kept on this device, so a stopped import does not start over.",
    atlas_sub:"Pull the global bird checklist onto this device. Imported species join search and can be photographed, described and voice-matched.",
    atlas_scope:"Scope", atlas_all:"All birds (class Aves)", atlas_order:"One order only", atlas_cap:"Maximum species",
    atlas_start:"Start import", atlas_stop:"Stop", atlas_running:"Importing…", atlas_done:"Import finished", atlas_have:"Species stored",
