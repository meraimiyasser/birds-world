const tr = (k, v) => {
  let s = (T[I18N.lang] && T[I18N.lang][k]) ?? T.en[k] ?? k;
  if (v) for (const key in v) s = s.replace(new RegExp("\\{" + key + "\\}", "g"), v[key]);
  return s;
};
const I18N = {
  lang: "en",
  apply(lang) {
    this.lang = CFG.LANGS.includes(lang) ? lang : "en";
    const root = document.documentElement;
    root.lang = this.lang; root.dir = this.lang === "ar" ? "rtl" : "ltr";
    document.querySelectorAll("[data-i18n]").forEach(n => { n.textContent = tr(n.dataset.i18n); });
    /* Static dictionary markup only — never species or user data. */
    document.querySelectorAll("[data-i18n-html]").forEach(n => { n.innerHTML = tr(n.dataset.i18nHtml); });
    localStorage.setItem("bw_lang", this.lang);
    renderNav();
  },
};

/* -------------------------------------------------------------------- 3. UTIL */
const $ = (sel, root = document) => root.querySelector(sel);
const $$ = (sel, root = document) => Array.from(root.querySelectorAll(sel));
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c]));
const clamp = (n, a, b) => Math.min(b, Math.max(a, n));
const round = (n, d = 0) => { const p = 10 ** d; return Math.round(n * p) / p; };
const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
const slug = s => String(s).normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const uniq = a => Array.from(new Set(a));
const sum = a => a.reduce((x, y) => x + y, 0);
const avg = a => (a.length ? sum(a) / a.length : 0);
const pick = a => a[Math.floor(Math.random() * a.length)];
const shuffle = a => a.map(v => [Math.random(), v]).sort((x, y) => x[0] - y[0]).map(v => v[1]);
const debounce = (fn, ms = 180) => { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; };
const nap = ms => new Promise(r => setTimeout(r, ms));
const dayKey = (d = new Date()) => new Date(d).toISOString().slice(0, 10);
const fmtDate = (iso, lang = I18N.lang) => { try { return new Date(iso).toLocaleDateString(lang === "ar" ? "ar-EG" : "en-GB", { year:"numeric", month:"short", day:"numeric" }); } catch { return iso; } };
const addDays = (iso, n) => { const d = new Date(iso); d.setDate(d.getDate() + n); return d; };
const daysBetween = (a, b) => Math.round((new Date(b) - new Date(a)) / 864e5);
const parseRange = str => { const n = String(str).match(/[\d.]+/g); if (!n) return [0, 0]; return n.length === 1 ? [+n[0], +n[0]] : [+n[0], +n[1]]; };
const num = (s, fallback = 0) => { const n = typeof s === "number" ? s : parseFloat(s); return Number.isFinite(n) ? n : fallback; };

function el(html) { const t = document.createElement("template"); t.innerHTML = html.trim(); return t.content.firstElementChild; }
function on(root, ev, sel, fn) {
  root.addEventListener(ev, e => { const hit = e.target.closest(sel); if (hit && root.contains(hit)) fn(e, hit); });
}
function download(name, text, mime = "application/json") {
  const url = URL.createObjectURL(new Blob([text], { type: mime + ";charset=utf-8" }));
  const a = el(`<a href="${url}" download="${esc(name)}"></a>`); document.body.appendChild(a); a.click();
  a.remove(); setTimeout(() => URL.revokeObjectURL(url), 4000);
}
function toCSV(rows) {
  if (!rows.length) return "";
  const head = Object.keys(rows[0]);
  const cell = v => { const s = v === null || v === undefined ? "" : typeof v === "object" ? JSON.stringify(v) : String(v);
    return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s; };
  return "\uFEFF" + [head.join(","), ...rows.map(r => head.map(h => cell(r[h])).join(","))].join("\n");
}
function bytes(n) { return n < 1024 ? n + " B" : n < 1048576 ? round(n / 1024, 1) + " KB" : round(n / 1048576, 2) + " MB"; }

/* ------------------------------------------------------------------ 7. UI KIT */
function toast(msg, kind = "info", ms = 2600) {
  const node = el(`<div data-kind="${kind}">${esc(msg)}</div>`);
  $("#toasts").appendChild(node);
  $("#live").textContent = msg;
  setTimeout(() => { node.style.transition = "opacity .25s"; node.style.opacity = "0"; setTimeout(() => node.remove(), 260); }, ms);
}
function openDlg(title, bodyHTML) {
  const d = $("#dlg"); $("#dlgTitle").textContent = title; $("#dlgBody").innerHTML = bodyHTML;
  if (!d.open) d.showModal();
  const first = d.querySelector("input,select,textarea,button:not(#dlgClose)");
  if (first) setTimeout(() => first.focus(), 30);
  return d;
}
const closeDlg = () => { const d = $("#dlg"); if (d.open) d.close(); };
function confirmDlg(msg) { return window.confirm(msg); }
function openLightbox(src, caption) {
  if (!src) return;
  const d = $("#lightbox"); $("#lbImg").src = src; $("#lbCap").textContent = caption || "";
  if (!d.open) d.showModal();
}
function rateBar(v, max = 5) {
  return `<span class="rate" role="img" aria-label="${v}/${max}">${Array.from({ length: max }, (_, i) =>
    `<i class="${i < v ? "on" : ""}"></i>`).join("")}</span>`;
}
function statBlock(items) {
  return `<div class="grid-stats">${items.map(([v, l, id]) =>
    `<div class="stat"${id ? ` id="${id}"` : ""}><b>${esc(v)}</b><span>${esc(l)}</span></div>`).join("")}</div>`;
}

/* --------------------------------------------------------- 4. SCHEMA + DATA */
