<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Birds World — Avian Field Guide</title>
<meta name="description" content="Field guide to 45 bird species with care calculators, breeding tracker, individual health records, geo sightings, real-song analysis and spaced-repetition learning. Works offline.">
<meta name="theme-color" content="#10b981">
<meta name="color-scheme" content="light dark">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%90%A6%3C/text%3E%3C/svg%3E">
<style>
/* ============ 1. TOKENS ============ */
:root{
  --h:162;
  --bg:hsl(200 30% 98%); --surface:hsl(0 0% 100%); --surface-2:hsl(200 25% 96%);
  --text:hsl(215 45% 12%); --muted:hsl(215 16% 44%); --line:hsl(205 25% 88%);
  --ac:hsl(var(--h) 75% 42%); --ac-hover:hsl(var(--h) 75% 34%); --ac-fg:#fff;
  --ac-soft:hsl(var(--h) 70% 95%);
  --warn:hsl(40 90% 92%); --warn-fg:hsl(35 85% 30%);
  --danger:hsl(0 80% 95%); --danger-fg:hsl(0 72% 32%);
  --ok:hsl(150 70% 94%); --ok-fg:hsl(155 75% 26%);
  --r-sm:8px; --r:14px; --r-lg:20px; --r-full:999px;
  --s-1:4px; --s-2:8px; --s-3:16px; --s-4:24px; --s-5:40px;
  --sh:0 1px 2px hsl(215 45% 12% / .06), 0 4px 12px hsl(215 45% 12% / .06);
  --sh-lg:0 10px 30px hsl(215 45% 12% / .14);
  --ring:0 0 0 3px hsl(var(--h) 75% 42% / .35);
  --dur:.18s; --ease:cubic-bezier(.2,.8,.3,1);
  --maxw:1240px;
}
[data-theme="dark"]{
  --bg:hsl(215 40% 8%); --surface:hsl(215 32% 13%); --surface-2:hsl(215 28% 18%);
  --text:hsl(200 25% 96%); --muted:hsl(213 18% 68%); --line:hsl(215 24% 26%);
  --ac:hsl(var(--h) 68% 52%); --ac-hover:hsl(var(--h) 72% 62%); --ac-fg:hsl(215 45% 10%);
  --ac-soft:hsl(var(--h) 45% 20%);
  --warn:hsl(35 45% 18%); --warn-fg:hsl(42 90% 78%);
  --danger:hsl(0 45% 20%); --danger-fg:hsl(0 85% 82%);
  --ok:hsl(155 40% 16%); --ok-fg:hsl(150 65% 76%);
  --sh:0 1px 2px hsl(0 0% 0% / .4); --sh-lg:0 12px 34px hsl(0 0% 0% / .5);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:hsl(215 40% 8%); --surface:hsl(215 32% 13%); --surface-2:hsl(215 28% 18%);
  --text:hsl(200 25% 96%); --muted:hsl(213 18% 68%); --line:hsl(215 24% 26%);
  --ac:hsl(var(--h) 68% 52%); --ac-hover:hsl(var(--h) 72% 62%); --ac-fg:hsl(215 45% 10%);
  --ac-soft:hsl(var(--h) 45% 20%);
  --warn:hsl(35 45% 18%); --warn-fg:hsl(42 90% 78%);
  --danger:hsl(0 45% 20%); --danger-fg:hsl(0 85% 82%);
  --ok:hsl(155 40% 16%); --ok-fg:hsl(150 65% 76%);
  --sh:0 1px 2px hsl(0 0% 0% / .4); --sh-lg:0 12px 34px hsl(0 0% 0% / .5);
}}

/* ============ 2. BASE ============ */
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{
  margin:0;font:400 16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans Arabic",sans-serif;
  background:var(--bg);color:var(--text);transition:background var(--dur) var(--ease),color var(--dur) var(--ease);
  min-height:100vh;
}
h1,h2,h3,h4{line-height:1.25;margin:0 0 var(--s-2);font-weight:750;letter-spacing:-.015em}
h1{font-size:clamp(1.6rem,1.2rem + 2vw,2.4rem)}
h2{font-size:clamp(1.25rem,1.05rem + 1vw,1.6rem)}
h3{font-size:1.08rem}
p{margin:0 0 var(--s-2)}
ul{margin:0;padding-inline-start:1.25rem}li{margin-block:var(--s-1)}
a{color:var(--ac);text-decoration:none}
a:hover{text-decoration:underline}
img{max-width:100%;display:block}
:focus-visible{outline:2px solid var(--ac);outline-offset:2px;border-radius:4px}
[hidden]{display:none !important}
.skip{position:absolute;inset-block-start:-48px;inset-inline-start:8px;z-index:200;background:var(--ac);color:var(--ac-fg);padding:8px 14px;border-radius:0 0 var(--r) var(--r);transition:inset-block-start var(--dur)}
.skip:focus{inset-block-start:0}
.sr{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms !important;transition-duration:.01ms !important}html{scroll-behavior:auto}}

/* ============ 3. LAYOUT ============ */
.shell{max-width:var(--maxw);margin:0 auto;padding-inline:var(--s-3)}
header.bar{position:sticky;top:0;z-index:100;background:color-mix(in srgb,var(--surface) 88%,transparent);backdrop-filter:saturate(1.4) blur(10px);border-bottom:1px solid var(--line)}
.bar-in{display:flex;align-items:center;gap:var(--s-3);padding-block:10px;flex-wrap:wrap}
.logo{display:flex;align-items:center;gap:var(--s-2);font-weight:800;font-size:1.15rem;color:var(--text);white-space:nowrap}
.logo:hover{text-decoration:none}
.badge{font-size:.62rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;background:var(--ac);color:var(--ac-fg);padding:3px 7px;border-radius:var(--r-full)}
nav.main{display:flex;gap:var(--s-1);overflow-x:auto;flex:1;scrollbar-width:thin}
nav.main a{padding:7px 12px;border-radius:var(--r-sm);color:var(--muted);font-weight:600;font-size:.9rem;white-space:nowrap}
nav.main a:hover{background:var(--surface-2);color:var(--text);text-decoration:none}
nav.main a[aria-current="page"]{background:var(--ac-soft);color:var(--ac)}
.acts{display:flex;gap:var(--s-2);align-items:center}
main{padding-block:var(--s-4) var(--s-5)}
.stack{display:grid;gap:var(--s-4)}
.row{display:flex;gap:var(--s-2);flex-wrap:wrap;align-items:center}
.spacer{flex:1}
footer.foot{border-top:1px solid var(--line);color:var(--muted);font-size:.82rem;padding-block:var(--s-4);text-align:center}

/* ============ 4. CONTROLS ============ */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;font:inherit;font-weight:650;font-size:.9rem;
  background:var(--ac);color:var(--ac-fg);border:1px solid var(--ac);padding:9px 15px;border-radius:var(--r);cursor:pointer;
  transition:background var(--dur) var(--ease),transform var(--dur) var(--ease),border-color var(--dur)}
.btn:hover{background:var(--ac-hover);border-color:var(--ac-hover);text-decoration:none}
.btn:active{transform:translateY(1px)}
.btn[disabled],.btn[aria-disabled=true]{opacity:.5;cursor:not-allowed}
.btn.ghost{background:transparent;color:var(--text);border-color:var(--line)}
.btn.ghost:hover{background:var(--surface-2);border-color:var(--muted)}
.btn.sm{padding:6px 11px;font-size:.82rem;border-radius:var(--r-sm)}
.btn.danger{background:var(--danger);color:var(--danger-fg);border-color:transparent}
.btn.icon{padding:0;width:38px;height:38px;border-radius:var(--r-sm);background:var(--surface);color:var(--text);border-color:var(--line);font-size:1.05rem}
.btn.icon:hover{background:var(--surface-2)}
input,select,textarea{font:inherit;color:var(--text);background:var(--surface-2);border:1px solid var(--line);border-radius:var(--r-sm);padding:10px 12px;width:100%}
input[type="checkbox"],input[type="radio"]{width:auto;accent-color:var(--ac);transform:scale(1.2)}
input[type="range"]{padding:0;accent-color:var(--ac)}
textarea{resize:vertical;min-height:88px}
label{display:block;font-weight:650;font-size:.88rem;margin-bottom:var(--s-1)}
label.inline{display:flex;align-items:center;gap:var(--s-2);font-weight:600;margin:0}
.hint{color:var(--muted);font-size:.82rem;margin:var(--s-1) 0 0}
.pill{display:inline-flex;align-items:center;gap:5px;background:var(--surface-2);border:1px solid var(--line);border-radius:var(--r-full);padding:4px 12px;font-size:.82rem;font-weight:600}
.chip{background:var(--surface);border:1px solid var(--line);color:var(--text);border-radius:var(--r-full);padding:6px 14px;font-size:.85rem;font-weight:600;cursor:pointer;transition:all var(--dur) var(--ease);white-space:nowrap}
.chip:hover{border-color:var(--ac)}
.chip[aria-pressed="true"]{background:var(--ac);color:var(--ac-fg);border-color:var(--ac)}
.rate{display:flex;gap:2px}
.rate i{width:7px;height:16px;border-radius:2px;background:var(--line)}
.rate i.on{background:var(--ac)}

/* ============ 5. SURFACES ============ */
.card,.panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--sh)}
.panel{padding:var(--s-3)}
.panel.tight{padding:var(--s-3) var(--s-3) var(--s-4)}
.hero{position:relative;overflow:hidden;border-radius:var(--r-lg);padding:var(--s-5) var(--s-4);background:
  radial-gradient(120% 140% at 100% 0%,var(--ac-soft),transparent 60%),var(--surface);border:1px solid var(--line)}
.hero h1{margin-bottom:var(--s-2)}
.hero p{color:var(--muted);max-width:62ch;margin-bottom:var(--s-3)}
.grid-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:var(--s-3)}
.stat{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:var(--s-3)}
.stat b{display:block;font-size:1.6rem;font-weight:800;letter-spacing:-.02em}
.stat span{color:var(--muted);font-size:.78rem;text-transform:uppercase;letter-spacing:.05em;font-weight:650}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(258px,1fr));gap:var(--s-3)}
.spec{position:relative;overflow:hidden;display:flex;flex-direction:column}
.spec .thumb{aspect-ratio:4/3;background:var(--surface-2);position:relative;overflow:hidden;display:grid;place-items:center;font-size:3rem;cursor:zoom-in}
.spec .thumb img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .35s var(--ease)}
.spec .thumb img.loaded{opacity:1}
.spec .body{padding:var(--s-3);display:flex;flex-direction:column;gap:var(--s-1);flex:1}
.spec .body h3{margin:0;font-size:1rem}
.spec .sci{color:var(--muted);font-size:.8rem;font-style:italic}
.spec .meta{display:flex;gap:var(--s-1);flex-wrap:wrap;margin-top:var(--s-1)}
.spec .foot{display:flex;justify-content:space-between;align-items:center;gap:var(--s-2);margin-top:auto;padding-top:var(--s-2);border-top:1px solid var(--line)}
.spec{transition:transform var(--dur) var(--ease),box-shadow var(--dur) var(--ease)}
.spec:hover{transform:translateY(-3px);box-shadow:var(--sh-lg)}
.spec:hover .thumb img{transform:scale(1.03)}
.star{position:absolute;top:8px;inset-inline-end:8px;z-index:3;width:34px;height:34px;border-radius:50%;display:grid;place-items:center;
  background:color-mix(in srgb,var(--surface) 80%,transparent);backdrop-filter:blur(6px);border:1px solid var(--line);color:var(--muted);font-size:1.05rem;cursor:pointer}
.star[aria-pressed="true"]{color:#ef4444}
.kb{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:var(--s-2)}
.kv{background:var(--surface-2);border:1px solid var(--line);border-radius:var(--r-sm);padding:10px 12px;font-size:.88rem}
.kv span{display:block;color:var(--muted);font-size:.72rem;text-transform:uppercase;letter-spacing:.05em}
.tabs{display:flex;gap:var(--s-1);overflow-x:auto;background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:5px;scrollbar-width:thin}
.tabs button{flex:1;min-width:max-content;padding:9px 12px;border-radius:var(--r-sm);font-weight:650;font-size:.88rem;color:var(--text);background:transparent;cursor:pointer;white-space:nowrap;transition:background var(--dur)}
.tabs button:hover{background:var(--surface-2)}
.tabs button[aria-selected="true"]{background:var(--ac);color:var(--ac-fg)}
.banner{border-radius:var(--r);padding:12px var(--s-3);font-size:.88rem;background:var(--surface-2);border:1px solid var(--line)}
.banner.warn{background:var(--warn);color:var(--warn-fg);border-color:transparent}
.banner.danger{background:var(--danger);color:var(--danger-fg);border-color:transparent}
.banner.ok{background:var(--ok);color:var(--ok-fg);border-color:transparent}
table{width:100%;border-collapse:collapse;font-size:.9rem}
th,td{border:1px solid var(--line);padding:10px 12px;text-align:start;vertical-align:top}
th{background:var(--surface-2);font-weight:700}
tbody tr:hover{background:var(--ac-soft)}
.table-wrap{overflow-x:auto;border-radius:var(--r);border:1px solid var(--line)}
progress{width:100%;height:8px;accent-color:var(--ac)}
canvas{max-width:100%;display:block;border-radius:var(--r-sm);background:var(--surface-2);border:1px solid var(--line);touch-action:none}
.empty{text-align:center;color:var(--muted);padding:var(--s-5) var(--s-3)}
.empty b{display:block;font-size:2rem;margin-bottom:var(--s-2)}

/* ============ 6. OVERLAYS ============ */
dialog{border:1px solid var(--line);border-radius:var(--r-lg);padding:0;background:var(--surface);color:var(--text);box-shadow:var(--sh-lg);max-width:min(920px,94vw);width:100%;max-height:90vh}
dialog::backdrop{background:hsl(215 45% 10% / .6);backdrop-filter:blur(3px)}
dialog .dh{display:flex;align-items:center;gap:var(--s-2);padding:var(--s-3);border-bottom:1px solid var(--line);position:sticky;top:0;background:var(--surface);z-index:2}
dialog .dh h2{margin:0;font-size:1.1rem;flex:1}
dialog .db{padding:var(--s-3);overflow-y:auto;max-height:calc(90vh - 66px)}
#lightbox{max-width:min(1100px,96vw)}
#lightbox img{width:100%;border-radius:var(--r-sm)}
#toasts{position:fixed;inset-block-end:16px;inset-inline:0;z-index:400;display:grid;gap:var(--s-2);justify-items:center;pointer-events:none;padding-inline:var(--s-3)}
#toasts div{pointer-events:auto;background:var(--surface);color:var(--text);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--sh-lg);padding:11px var(--s-3);font-size:.9rem;font-weight:600;max-width:min(460px,92vw);animation:pop .22s var(--ease)}
#toasts div[data-kind="error"]{background:var(--danger);color:var(--danger-fg);border-color:transparent}
#toasts div[data-kind="ok"]{background:var(--ok);color:var(--ok-fg);border-color:transparent}
@keyframes pop{from{opacity:0;transform:translateY(10px) scale(.97)}to{opacity:1;transform:none}}

/* ============ 7. FEATURE-LOCAL ============ */
.filters{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:var(--s-3)}
.rng{display:flex;align-items:center;gap:var(--s-2)}
.rng output{font-size:.8rem;font-weight:700;min-width:52px;text-align:end;font-variant-numeric:tabular-nums}
.wiz-q{font-size:1.15rem;font-weight:700;margin-bottom:var(--s-3)}
.opts{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:var(--s-2)}
.opt{text-align:start;padding:var(--s-3);border:2px solid var(--line);border-radius:var(--r);background:var(--surface);cursor:pointer;font:inherit;font-weight:600;transition:all var(--dur) var(--ease)}
.opt:hover{border-color:var(--ac);transform:translateY(-2px)}
.opt[aria-checked="true"]{border-color:var(--ac);background:var(--ac-soft)}
.opt small{display:block;color:var(--muted);font-weight:500;margin-top:3px}
.why{list-style:none;padding:0;margin:var(--s-2) 0 0;font-size:.82rem;color:var(--muted)}
.why li{padding-inline-start:18px;position:relative;margin-block:2px}
.why li::before{content:"✓";position:absolute;inset-inline-start:0;color:var(--ac);font-weight:800}
.bird-item{display:grid;grid-template-columns:auto 1fr auto;gap:var(--s-3);align-items:center;padding:var(--s-3)}
.bird-item+.bird-item{border-top:1px solid var(--line)}
.avatar{width:46px;height:46px;border-radius:50%;display:grid;place-items:center;font-size:1.5rem;background:var(--ac-soft);border:1px solid var(--line)}
.task{display:flex;gap:var(--s-2);align-items:center;padding:9px 0;border-bottom:1px dashed var(--line)}
.task:last-child{border-bottom:0}
.task.done .ttl{text-decoration:line-through;color:var(--muted)}
.task input{margin:0}
#map{width:100%;height:min(52vh,460px);cursor:crosshair}
.legend{display:flex;gap:var(--s-3);flex-wrap:wrap;font-size:.8rem;color:var(--muted);margin-top:var(--s-2)}
.legend i{display:inline-block;width:10px;height:10px;border-radius:50%;background:var(--ac);margin-inline-end:5px}
.badgegrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:var(--s-2)}
.trophy{border:1px solid var(--line);border-radius:var(--r);padding:var(--s-3);background:var(--surface);text-align:center}
.trophy[data-locked="true"]{opacity:.42;filter:grayscale(1)}
.trophy b{display:block;font-size:1.6rem}
.trophy span{font-size:.8rem;font-weight:650}
.wavebox{display:grid;gap:var(--s-2)}
.scores{font-variant-numeric:tabular-nums}
.flashcard{min-height:180px;display:grid;place-content:center;text-align:center;gap:var(--s-2);padding:var(--s-4);border:2px dashed var(--line);border-radius:var(--r-lg);background:var(--surface-2);cursor:pointer}
.flashcard b{font-size:1.35rem}
.qopt{padding:var(--s-3);border:1px solid var(--line);border-radius:var(--r);background:var(--surface-2);cursor:pointer;font:inherit;font-weight:650;text-align:center;transition:all var(--dur)}
.qopt:hover{border-color:var(--ac)}
.qopt.right{background:var(--ok);color:var(--ok-fg);border-color:transparent}
.qopt.wrong{background:var(--danger);color:var(--danger-fg);border-color:transparent}

/* ============ 7b. ATLAS / SOUND ID / ASSISTANT ============ */
.card.sm{padding:var(--s-3)}
.bar{height:9px;border-radius:var(--r-full);background:var(--surface-2);border:1px solid var(--line);overflow:hidden;margin-top:var(--s-3)}
.bar i{display:block;height:100%;background:var(--ac);border-radius:var(--r-full);transition:width .3s var(--ease)}
.arow{align-items:center;padding:var(--s-2);border:1px solid var(--line);border-radius:var(--r-sm);background:var(--surface)}
.arow img{flex:0 0 auto}
.wave{width:100%;height:150px;margin-top:var(--s-3)}
label.inline{display:inline-flex;align-items:center;gap:6px}
.feat{display:flex;gap:var(--s-3);align-items:flex-start;padding:var(--s-3);border:1px solid var(--line);border-radius:var(--r);background:var(--surface-2)}
.feat b{display:block;font-size:1.02rem}
.feat p{color:var(--muted);font-size:.85rem;margin:2px 0 6px}
.feat a{font-weight:700;font-size:.86rem}
.ai-body{white-space:pre-wrap;word-break:break-word}

/* ============ 8. RESPONSIVE / PRINT ============ */
@media (max-width:820px){
  .bar-in{gap:var(--s-2)}
  nav.main{order:3;width:100%;flex:1 1 100%}
  .hero{padding:var(--s-4) var(--s-3)}
}
@media (max-width:520px){
  .grid{grid-template-columns:1fr}
  .bird-item{grid-template-columns:auto 1fr;gap:var(--s-2)}
  .bird-item .acts{grid-column:1/-1}
}
@media print{
  header.bar,nav.main,#toasts,.acts,.tabs,.filters,#p-learn,#mapwrap,.btn,.no-print{display:none !important}
  body{background:#fff;color:#000}
  .panel,.card,.spec{box-shadow:none;border:1px solid #bbb;break-inside:avoid}
  main{padding:0}
  a[href^="http"]::after{content:" (" attr(href) ")";font-size:.75em;color:#555}
}
</style>
</head>
<body>
<a class="skip" href="#main" data-i18n="skip">Skip to content</a>

<header class="bar">
  <div class="shell bar-in">
    <a class="logo" href="#/">🐦 Birds World <span class="badge" data-i18n="badge">Field guide</span></a>
    <nav class="main" id="nav" aria-label="Main"></nav>
    <div class="acts">
      <button class="btn ghost sm" id="btnCompare">⚖️ <span data-i18n="compare">Compare</span> (<span id="compN">0</span>)</button>
      <button class="btn icon" id="btnTheme" aria-label="Switch theme">🌙</button>
      <button class="btn icon" id="btnLang" aria-label="Switch language">ع</button>
    </div>
  </div>
</header>

<main id="main" class="shell"><div id="app" class="stack"></div></main>

<footer class="foot">
  <div class="shell">
    <p data-i18n-html="foot_html">Species summaries and photos from <a href="https://en.wikipedia.org/wiki/" target="_blank" rel="noopener noreferrer">Wikipedia</a> / <a href="https://commons.wikimedia.org/" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a> under their licenses. Recordings from <a href="https://xeno-canto.org/" target="_blank" rel="noopener noreferrer">Xeno-canto</a>.</p>
    <p data-i18n="disclaimer">General information only — not veterinary advice. For laboured breathing, egg binding or sudden weakness, contact an avian veterinarian immediately.</p>
    <p class="hint"><span id="netState">●</span> <span data-i18n="localfirst">Everything you save stays on this device.</span></p>
  </div>
</footer>

<dialog id="dlg" modal>
  <div class="dh"><h2 id="dlgTitle"></h2><button class="btn icon" id="dlgClose" aria-label="Close">✕</button></div>
  <div class="db" id="dlgBody"></div>
</dialog>

<dialog id="lightbox" modal>
  <div class="dh"><h2 id="lbCap"></h2><button class="btn icon" id="lbClose" aria-label="Close">✕</button></div>
  <div class="db"><img id="lbImg" alt=""></div>
</dialog>

<div id="toasts" role="status" aria-live="polite"></div>
<div class="sr" id="live" role="log" aria-live="polite"></div>

<script>

"use strict";
/* ============================================================================
 * BIRDS WORLD — layered, dependency-free
 *   1 config   2 i18n   3 util   4 schema+data   5 store
 *   6 api      7 ui-kit 8 views  9 router        10 boot
 * ==========================================================================*/

/* ---------------------------------------------------------------- 1. CONFIG */
const CFG = Object.freeze({
  NS: "bw",
  VERSION: 1,
  LANGS: ["en", "ar"],
  MAX_COMPARE: 3,
  MAX_CARDS: 4,
  API: { wiki: "https://en.wikipedia.org/api/rest_v1/page/summary/",
         commons: "https://commons.wikimedia.org/w/api.php",
         xeno: "https://xeno-canto.org/api/3/recordings",
         xenoSite: "https://xeno-canto.org/catalogue",
         /* Verified live: both are keyless and answer cross-origin browser
            requests. GBIF gives the full backbone classification, Wikidata
            gives vernacular names (Arabic included) and a Commons file. */
         gbif: "https://api.gbif.org/v1",
         wd: "https://www.wikidata.org/w/api.php",
         sparql: "https://query.wikidata.org/sparql",
         avesKey: 212,
         /* Real recordings. Measured from the browser on 2026-10-17:
            Commons answers keyless with CORS and carries freely licensed files
            (many of them Xeno-canto mirrors). iNaturalist v2 filters by
            media_type=sound but returns sounds:[] for unauthenticated calls,
            so it only becomes a source once the user adds a read token.
            Xeno-canto v2 is retired (404) and v3 answers 401 without a key. */
         inat: "https://api.inaturalist.org",
         inatSite: "https://www.inaturalist.org",
         commonsSite: "https://commons.wikimedia.org/wiki/File:",
         thumbPx: 800, timeoutMs: 9000, sparqlTimeoutMs: 30000 },
  ATLAS: { pageSize: 100, concurrency: 4, gapMs: 60, sparqlBatch: 60, defaultCap: 6000, maxCap: 20000 },
  VOICE: { seconds: 6, fft: 1024, bands: [0.4, 0.8, 1.4, 2.4, 3.8, 6, 8.5, 12] },
  DB: { name: "birds-world", version: 1, media: "media" },
  get remote() { return store.settings.apiBase ? store.settings.apiBase.replace(/\/+$/, "") + "/api" : null; },
});

const KEYS = { fav: "favorites", note: "notes", visits: "visits", birds: "birds",
  sightings: "sightings", cards: "srs", score: "progress", saved: "savedSearches",
  settings: "settings", outbox: "outbox", wiki: "cache:wiki", credit: "cache:credit",
  atlas: "atlas:meta", ai: "ai_chat", songs: "savedSongs", ctx: "ai_ctx" };

const TRAITS = [
  ["difficulty", 1, 5, "Care difficulty"], ["noise", 1, 5, "Noise level"],
  ["space", 1, 5, "Space needed"], ["cost", 1, 5, "Running cost"],
  ["sociability", 1, 5, "Needs company"], ["longevity", 5, 80, "Years lived"],
];
const AR_TRAIT = { difficulty: "صعوبة العناية", noise: "مستوى الضجيج", space: "المساحة المطلوبة",
  cost: "تكلفة التشغيل", sociability: "الحاجة للصحبة", longevity: "سنوات العمر" };
const traitLabel = k => { const t = TRAITS.find(x => x[0] === k); return I18N.lang === "ar" ? (AR_TRAIT[k] || k) : (t ? t[3] : k); };

/* ------------------------------------------------------------------- 2. I18N */
const T = {
  en: {
    skip:"Skip to content", badge:"Field guide", compare:"Compare", disclaimer:"General information only — not veterinary advice. For laboured breathing, egg binding or sudden weakness, contact an avian veterinarian immediately.",
    localfirst:"Everything you save stays on this device.",
    nav_home:"Home", nav_birds:"Species", nav_wizard:"Find my bird", nav_mybirds:"My birds", nav_sightings:"Sightings", nav_learn:"Learn", nav_settings:"Settings",
    home_title:"Discover the wonderful world of birds", home_sub:"45 care guides plus a world atlas you can pull to thousands of species: real field recordings with licence and recorder, photo credits, feed and incubation calculators, individual health records, geo sightings, sound identification and spaced-repetition learning — all of it offline-capable.",
    stat_species:"Species", stat_groups:"Families", stat_fav:"Favorites", stat_seen:"Explored", stat_mine:"My birds", stat_sights:"Sightings",
    bird_of_day:"Bird of the day", open:"Open", search:"Search", search_ph:"Name, scientific name or origin…", filters:"Filters", sort:"Sort",
    voice_no:"Voice search is not supported in this browser.", voice_fail:"Voice input failed.", voice_listen:"Listening…",
    sto_full:"Device storage is full — delete a few photos or records.", remote_off:"Local mode: no community URL set in Settings.",
    an_block:"This recording host blocks live analysis — playback still works.", not_found:"Not found.",
    play_block:"Playback blocked by the browser.", photo_big:"Photo over 4 MB — stored, but it may fill device storage.",
    import_fail:"Import failed:", sw_update:"Update ready — reload to apply.",
    foot_html:'Species summaries and photos from <a href="https://en.wikipedia.org/wiki/" target="_blank" rel="noopener noreferrer">Wikipedia</a> / <a href="https://commons.wikimedia.org/" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a> under their licenses. Recordings from <a href="https://commons.wikimedia.org/" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>, <a href="https://xeno-canto.org/" target="_blank" rel="noopener noreferrer">Xeno-canto</a> and, with a token, <a href="https://www.inaturalist.org/" target="_blank" rel="noopener noreferrer">iNaturalist</a> — each entry keeps its own credit.',
    feed_rule:"Rules of thumb: 10–15 % of body weight in dry food, greens at roughly 40 % of that, water at about 2× dry weight. Small, fast-metabolising birds need proportionally more.",
    net_on:"online", net_off:"offline", body_g:"Body weight",
    clear:"Clear", saved_searches:"Saved searches", save_search:"Save this search", no_results:"No species match these filters.", try_wide:"Try widening the ranges or clearing the search.",
    g_all:"All", g_fav:"Favorites",
    t_overview:"Overview", t_feeding:"Feeding", t_sounds:"Sounds", t_breeding:"Breeding", t_care:"Care", t_health:"Health", t_notes:"Notes",
    origin:"Origin", size:"Size", life:"Lifespan", group:"Family", diet_tip:"Diet tip", traits:"Trait profile",
    back:"All species", print:"Print sheet", share:"Share", add_sighting:"Log a sighting", add_bird:"Add to my birds",
    calc_h:"Daily feed & water calculator", birds_count:"Number of birds", dry:"Dry food", greens:"Fresh greens", water:"Drinking water",
    breed_h:"Breeding & hatching tracker", inc_start:"Incubation start date", hatch:"Expected hatch", inc_days:"Incubation length", day_of:"Day",
    synth:"Play synthesized chirp", real:"Load real recording", search_rec:"Search recordings…", more_sounds:"More sounds", rate:"Speed",
    xeno_need_key:"Add a free Xeno-canto key for the deepest catalogue — but real recordings are searched on Wikimedia Commons first, with no key.",
    xeno_key:"Xeno-canto API key", xeno_key_hint:"Get one at xeno-canto.org/explore/api. The API v2 was retired, so a key is now mandatory for that source. A key typed here is sent from this browser only; with a community backend set, requests go through it instead so the key stays private.",
    inat_key:"iNaturalist read token", inat_key_hint:"Measured: iNaturalist returns photo URLs but an empty sounds array for anonymous calls, so its recordings only load when a read token is present. The token stays on this device and is stripped from every backup export.",
    song_h:"Real recordings", song_load:"Search real recordings", song_searching:"Searching Commons…", song_from:"Sources",
    song_none:"No freely licensed recording could be reached for this species. That does not mean the bird is silent — the open catalogue simply has nothing for it. Listen manually on Xeno-canto or iNaturalist.",
