    { k: "fluffed", en: "fluffed up, sitting low, sleepy, not singing, dull feathers, weight loss",
      ar: "منفش، ريش منفش، جالس منخفض، نعسان، لا يغرد، ريش باهت، نقص وزن",
      urg: 2, cause: { en: "The universal sign of illness in birds: infection, parasite load, cold, pain, or organ trouble.",
        ar: "العلامة العامة للمرض عند الطيور: عدوى، طفيليات، برد، ألم، أو خلل في عضو." },
      act: { en: "Heat to 28 C, reduce handling, weigh every morning, and see a vet — fluffed and quiet for a day is not 'resting'.",
        ar: "ارفع الحرارة 28 مئوية، قلل المناولة، زِن كل صباح، وراجع الطبيب؛ منفش وهادئ يومًا ليس «راحة»." } },
    { k: "mites", en: "scratching, bare skin, scabs, lice, mites, crusty beak, crusty feet, plucking feathers, feather damage",
      ar: "حكة، جلد أصلع، قشور، قمل، هوام، منقار متشقق، أقدام متقشرة، نتف الريش",
      urg: 1, cause: { en: "Scaly leg mite, red mite, feather mites, or feather-plucking from boredom.",
