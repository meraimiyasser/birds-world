      act: { en: "Stop solid food for 12 hours, warm water, vet — force-feeding an impacted crop makes it worse.",
        ar: "أوقف الطعام الصلب 12 ساعة، ماء دافئ، وراجع الطبيب؛ الإكراه على الطعام في الانضغاط يزيده." } },
    { k: "nerve", en: "twisting neck, staggering, falling off perch, seizure, circling",
      ar: "التواء الرقبة، ترنح، يسقط من المجثم، تشنج، دوران، رقبة ملتوية",
      urg: 3, cause: { en: "Newcastle/paramyxo, toxoplasmosis, head injury, deficiency.", ar: "نيوكاسل/باراميكسو، توكسوبلازما، إصابة رأس، نقص فيتامين." },
      act: { en: "Padded low perch, quiet dark box, vet immediately; isolate other birds.",
        ar: "مجثم واطئ مرفف، صندوق هادئ مظلم، طبيب فوراً، واعزل بقية الطيور." } },
    { k: "limp", en: "not standing, lame, swollen joint, limping, foot sore, bumblefoot",
      ar: "لا يقف، عرج، مفصل منتفخ، وجع القدم، دماملة",
      urg: 2, cause: { en: "Bumblefoot from dirty or narrow perches, injury, gout.", ar: "دماملة من مجثم متسخ أو ضيق، إصابة، نقرس." },
      act: { en: "Replace perch with soft rope, warm foot bath, clean and cover the foot daily, vet if there is a hard lump.",
        ar: "بدّل المجثم بحبل ناعم، حمام قدم دافئ، نظف وغطِّ القدم يومياً، وراجع الطبيب إن ظهر كتلة صلبة." } },
    { k: "moult", en: "losing feathers in spring, pin feathers, bald patch appearing symmetrically",
      ar: "تساقط ريش في الربيع، ريش إبرة، صلع متناظر",
      urg: 0, cause: { en: "Normal moult; need protein and calcium.", ar: "طق طبيعي؛ يحتاج بروتين وكالسيوم." },
      act: { en: "Do not treat it as illness: add egg-food or legume protein, keep humidity, no handling of pin feathers.",
        ar: "لا تعامله كمرض: أضف غذاء البيض أو بروتين البقوليات، حافظ على الرطوبة، ولا تلمس ريش الإبرة." } },
    { k: "poison", en: "poison, toxic, ate chocolate, avocado, onion, garlic, xylitol, Teflon, aerosol",
      ar: "تسمم، أكل شوكولاته، أفوكادو، بصل، ثوم، زيليتول، تيفال، بخاخ",
      urg: 3, cause: { en: "Avian toxins: avocado, chocolate, onion, xylitol, heated PTFE fumes, aerosols, lead, zinc.",
        ar: "سموم الطيور: الأفوكادو، الشوكولاته، البصل، الزيليتول، أبخرة التيفال الساخن، البخاخات، الرصاص، الزنك." },
      act: { en: "Remove the source, fresh air, keep warm, avian vet the same hour — do not induce vomiting at home.",
        ar: "أبعد المصدر، هواء نقي، أبقه دافئاً، طبيب الطيور في نفس الساعة؛ لا تحث على القيء في البيت." } },
    { k: "heat", en: "panting in heat, wings spread, weak in sun, hot car",
      ar: "لهثان في الحر، نشر الجناحين، إعياء في الشمس، سيارة حارة",
      urg: 3, cause: { en: "Heat stroke; birds above 35 C with no shade.", ar: "ضربة حر؛ الطيور فوق 35 مئوية بلا ظل." },
      act: { en: "Move to shade, mist legs and wings with cool (not iced) water, fan the air, vet if it is still panting after ten minutes.",
        ar: "انقله للظل، رش ساقيه وجناحيه بماء بارد (غير مثلج)، حرّك الهواء بمروحة، وراجع الطبيب إن استمر اللهثان عشر دقائق." } },
  ],
  /* One readable name per sign group: the first dictionary phrase is a search
     term, not a heading, and "scratching" reads wrong as a diagnosis title. */
  NAMES: {
    breathing: ["Breathing trouble", "صعوبة التنفس"], eggbound: ["Egg bound", "احتباس البيضة"],
    bleed: ["Bleeding", "نزيف"], noteat: ["Not eating", "لا يأكل"],
    diarrhea: ["Loose droppings", "إسهال"], fluffed: ["Fluffed and quiet", "منفش وخامل"],
    mites: ["Parasites or plucking", "طفيليات أو نتف الريش"], crop: ["Crop problem", "مشكلة الحوصلة"],
    nerve: ["Neurological signs", "أعراض عصبية"], limp: ["Legs and feet", "الرجلان والقدمان"],
    moult: ["Moulting", "الطق"], poison: ["Poisoning", "تسمم"], heat: ["Overheating", "ضربة حر"]
  },
  sName(s) { const n = this.NAMES[s.k]; return n ? this.bi(n[0], n[1])
    : this.bi(String(s.en).split(",")[0], String(s.ar).split("،")[0]); },
  /* Arabic clitics (ال و ب ل) are folded off both sides, and a two-word sign
     must appear whole: that is what keeps "ماذا يأكل؟" (what does it eat) from
     reading as "لا يأكل" (not eating), while "ولا يأكل" still counts.
     Three-word signs match on their distinctive word so that "open-mouthed
     breathing" is found from "my bird is breathing hard". */
  NEG: ["لا", "ليس", "لم", "لن", "غير", "بدون", "انعدام", "فقد", "not", "no", "never", "refuses", "stopped", "without", "cannot", "cant", "loss", "absent"],
  /* Only the definite-article cluster and the conjunction و are stripped:
     bare ب/ل/ف are part of real words here ("ببغاء" is a parrot, not "by-parrot") */
  stripAr(w) { return w.replace(/^(وال|بال|فال|لل|ال|و)/, ""); },
  toks(s) {
    /* "ريشه" (his feather) and "ريش" (feathers) must compare equal, so a
       trailing possessive ه/ي is folded off — index and query use this path */
    const fold = w => (w.length >= 4 && /[هي]$/.test(w) ? w.slice(0, -1) : w);
    return this.norm(s).split(" ").map(x => this.stripAr(x)).map(fold)
      .filter(x => x.length > 1 && !this.STOP.has(x));
  },
  /* A word that belongs to one symptom only is distinctive; one shared by
     several signs ("feathers", "ريش") is not, so a long sign cannot fire on it. */
  _df: null,
  df() {
    if (this._df) return this._df;
    const m = new Map();
    for (const s of this.SYMPTOMS) {
      const seen = new Set();
      [s.en, s.ar].forEach(txt => String(txt).split(/[,;،؛]+/).forEach(p => this.toks(p).forEach(w => seen.add(w))));
      seen.forEach(w => m.set(w, (m.get(w) || 0) + 1));
    }
    return (this._df = m);
  },
  hits(t) {
    /* t arrives already normalised from local(); re-normalising is a no-op for
       a plain word, so a raw string passed directly still compares correctly */
    const qset = new Set(this.toks(this.norm(t)));
    const df = this.df();
    const out = [];
    for (const s of this.SYMPTOMS) {
      let n = 0;
      [s.en, s.ar].forEach(txt => String(txt).split(/[,;،؛]+/).forEach(p => {
        const ws = this.toks(p);
        if (!ws.length) return;
        const present = ws.filter(w => qset.has(w));
        const neg = ws.filter(w => this.NEG.includes(w));
        const unique = present.some(w => (df.get(w) || 9) === 1 && w.length >= 4);
        const need = neg.length ? ws.length : (ws.length >= 3 ? (unique ? 1 : 2) : ws.length);
        const longest = present.length ? Math.max.apply(null, present.map(w => w.length)) : 0;
        /* a three-word sign like "falling off perch" must not fire on the noun
           "perch" alone, while a one-word sign like "ينزف" is enough by itself */
        const min = ws.length === 1 ? 4 : 6;
        if (present.length >= need && (need > 1 || longest >= min)) n++;
      }));
      if (n) out.push([s, n]);
    }
    return out.sort((a, b) => b[1] - a[1]).slice(0, 3);
  },

  /* ------------------------------------------------- whose health is it? --- */
  aboutBird(q) {
    const t = this.norm(q);
    const mine = store.birds.all();
    const byNick = mine.find(b => b.nick && t.includes(this.norm(b.nick)));
    if (byNick) return byNick;
    /* a follow-up with no name in it is about the bird we were just discussing */
    const fromCtx = this.ctxBird();
    if (fromCtx) return fromCtx;
    return mine.length === 1 ? mine[0] : null;
  },
  trend(uid) {
    const w = store.weights.all().filter(x => x.birdId === uid).map(x => num(x.grams)).filter(v => v > 0);
    if (w.length < 2) return null;
    const last = w[0], first = w[w.length - 1];
    const pct = round(100 * (last - first) / first, 1);
    return { n: w.length, pct, last, first, dir: pct < -3 ? "down" : pct > 3 ? "up" : "flat" };
  },
  /* Has this keeper written about this sign before? Weight logs and old symptom
     notes turn "watch it" into "this is the third time since March", which is
     the difference between advice and a record. */
  priorSigns(uid, hs) {
    const recs = store.symptoms.all().filter(s => !uid || s.birdId === uid);
    const out = [];
    hs.forEach(([s]) => {
      const vocab = new Set();
      String(s.en + " " + s.ar).split(/[,;،؛]+/).forEach(p => this.toks(p).forEach(w => { if (w.length >= 4) vocab.add(w); }));
      const matched = recs.filter(r => this.toks(String(r.text || "")).some(w => vocab.has(w)));
      if (matched.length) out.push({ s, n: matched.length, latest: matched[0].at, sameBird: !!uid });
    });
    return out;
  },
  /* Cross-check the matched signs against the disease list of that bird's own
     group: the guide already carries signs per disease, so scoring the overlap
     is a grounded shortlist rather than a guess from the open web. */
  groupDiseases(g, t, hs) {
    const grp = GROUPS[g];
    if (!grp || !grp.dis) return [];
    const q = new Set(this.toks(t));
    return grp.dis.map(d => {
      const info = disText(d);
      const vocab = new Set();
      String(info[1]).split(/[,;،؛]+/).forEach(p => this.toks(p).forEach(w => { if (w.length >= 4) vocab.add(w); }));
      let n = 0;
      hs.forEach(([s]) => this.toks(String(s.en + " " + s.ar)).forEach(w => { if (vocab.has(w)) n++; }));
      this.toks(String(info[1])).forEach(w => { if (q.has(w)) n += 0.5; });
      return { name: info[0], signs: info[1], treat: info[2], n };
    }).filter(x => x.n >= 2).sort((a, b) => b.n - a.n).slice(0, 3);
  },

  /* ------------------------------------------------------ answer pieces --- */
  URGENCY: [
    { cls: "info", en: "Normal, not an emergency", ar: "طبيعي وليس حالة طارئة" },
    { cls: "info", en: "Watch and treat at home", ar: "راقبه وعالجه في البيت" },
    { cls: "warn", en: "See an avian vet within 24–48 hours", ar: "راجع طبيب طيور خلال 24–48 ساعة" },
    { cls: "danger", en: "Emergency — a vet today, within hours", ar: "طارئ — طبيب اليوم، خلال ساعات" },
  ],
  langKey() { return I18N.lang === "ar" ? "ar" : "en"; },
  /* Dataset values (origin, size, lifespan) are authored in English, so Arabic
     mode translates the whole phrase when the dictionary has it, and otherwise
     swaps the unit words and any place names inside the phrase. Unmatched text
     is passed through: nothing here invents a fact. */
