    "Africa, southern Europe, South Asia": "إفريقيا وجنوب أوروبا وجنوب آسيا",
    "Antarctica": "أنتاركتيكا",
    "New Guinea and northeast Australia": "غينيا الجديدة وشمال شرق أستراليا",
    "Alpine South Island, New Zealand": "جزيرة الجنوب الألبية، نيوزيلندا"
  },
  locVal(v) {
    if (I18N.lang !== "ar" || v == null) return v;
    const s = String(v);
    if (this.ORIGIN_AR[s]) return this.ORIGIN_AR[s];
    let out = s.replace(/\byears?\b/g, "سنة").replace(/\byrs?\b/g, "سنة")
      .replace(/\bcm\b/g, "سم").replace(/\bkg\b/g, "كغ")
      .replace(/^Domesticated form of the /, "مستأنس من ").replace(/^Domesticated from /, "مستأنس من ")
      .replace(/^Bred from /, "مربّى من ");
    for (const k in this.ORIGIN_AR) if (out.includes(k)) out = out.split(k).join(this.ORIGIN_AR[k]);
    return out;
  },
  pill(r) {
    const nm = speciesName(r) || r.sci;
    return `<a class="chip" href="${hrefFor(r)}">${esc(nm)}</a>`;
  },
  facts(r) {
    const g = GROUPS[r.g];
    const rows = [[this.bi("Scientific name", "الاسم العلمي"), esc(r.sci)]];
    if (r.origin) rows.push([this.bi("Origin", "الموطن"), esc(this.locVal(r.origin))]);
    if (r.size) rows.push([this.bi("Size", "الحجم"), esc(this.locVal(r.size))]);
    if (r.life) rows.push([this.bi("Lifespan in care", "العمر في الأسر"), esc(this.locVal(r.life))]);
    if (g) rows.push([this.bi("Group", "الفصائل"), esc(I18N.lang === "ar" ? g.ar : g.en)]);
    if (g && g.incDays) rows.push([this.bi("Incubation", "التحضين"), g.incDays + " " + this.bi("days", "يوم")]);
    if (g && g.foodWeight) rows.push([this.bi("Daily food, typical bird", "الطعام اليومي لطائر نموذجي"), g.foodWeight + " " + this.bi("g", "غ")]);
    if (r.tip) rows.push([this.bi("Feeding note", "ملاحظة تغذية"), esc(r.tip)]);
    TRAITS.forEach(([k]) => {
      const v = k === "longevity" ? r.longevity : r[k];
      if (v != null) rows.push([traitLabel(k), esc(String(v) + (k === "longevity" ? " " + this.bi("yrs", "سنة") : "/5"))]);
    });
    return rows;
  },
  kv(rows) {
    return `<div class="table-wrap"><table>${rows.map(([a, b]) => `<tr><th>${esc(a)}</th><td>${b}</td></tr>`).join("")}</table></div>`;
  },

  ansTriage(q) {
    const t = this.norm(q), hs = this.hits(t);
    if (!hs.length) return null;
    const bird = this.aboutBird(q), urg = Math.max.apply(null, hs.map(x => x[0].urg)), u = this.URGENCY[urg];
    const out = [`<div class="banner ${u.cls}"><b>${esc(u[this.langKey()])}</b></div>`];
    out.push(`<p class="hint">${esc(this.bi("Signs matched from your words: ", "علامات طابقت كلماتك: "))}` +
      hs.map(([s]) => `<span class="chip">${esc(this.sName(s))}</span>`).join(" ") + `</p>`);
    if (bird) {
      const tw = this.trend(bird.id), recs = store.symptoms.all().filter(s => s.birdId === bird.id), sp = byId(bird.speciesId);
      let line = `<b>${esc(bird.nick)}</b>` + (sp ? " · " + esc(speciesName(sp)) : "");
      if (bird.sex) line += " · " + esc(this.bi(bird.sex === "M" ? "male" : "female", bird.sex === "M" ? "ذكر" : "أنثى"));
      if (bird.acquired) {
        const d = daysBetween(bird.acquired, dayKey());
        if (d >= 0) line += this.bi(` · ${d} days in your care`, ` · ${d} يوماً في رعايتك`);
      }
      line += tw ? (tw.dir === "down"
        ? this.bi(` · weight down ${Math.abs(tw.pct)}% over ${tw.n} weigh-ins (${tw.first}→${tw.last} g)`,
            ` · الوزن نزل ${Math.abs(tw.pct)}% عبر ${tw.n} قياسات (${tw.first}→${tw.last} غ)`)
        : tw.dir === "up"
          ? this.bi(` · weight up ${tw.pct}% (${tw.first}→${tw.last} g)`, ` · الوزن زاد ${tw.pct}% (${tw.first}→${tw.last} غ)`)
          : this.bi(` · weight steady around ${tw.last} g`, ` · الوزن مستقر حول ${tw.last} غ`))
        : this.bi(" · no weight log yet — weigh it today, weight is the earliest honest signal",
            " · لا يوجد سجل وزن — زِنه اليوم، فالوزن أول إشارة صادقة");
      if (recs.length) {
        const wk = recs.filter(r => daysBetween(String(r.at || "").slice(0, 10), dayKey()) <= 7).length;
        line += this.bi(` · ${recs.length} symptom notes`, ` · ${recs.length} ملاحظات عرض`) +
          (wk > 1 ? this.bi(` (${wk} in the last week)`, ` (${wk} خلال الأسبوع الأخير)`) : "") +
          this.bi(", latest: ", "، آخرها: ") + esc(String(recs[0].text || "").slice(0, 90));
      }
      out.push(`<p class="hint">${line}</p>`);
      if (tw && tw.pct <= -6 && urg < 3) out.push(`<div class="banner warn">${esc(this.bi(
        "A 6% drop in a small bird is not a rounding error — treat it as urgent.",
        "نزول 6% عند طائر صغير ليس خطأ حسابياً — اعتبره حالة عاجلة."))}</div>`);
    } else if (store.birds.all().length > 1) {
      out.push(`<p class="hint">${esc(this.bi(
        "You keep several birds — say which one by name and the answer reads that bird's own weight and symptom log.",
        "لديك عدة طيور؛ اذكر اسم الطائر لتقرأ الإجابة سجل وزنه وعوارضه هو وحده."))}</p>`);
    }
    const mine = store.birds.all();
    const sp0 = bird ? byId(bird.speciesId) : null;
    const g0 = sp0 ? sp0.g : null;
    const gd = g0 ? this.groupDiseases(g0, t, hs) : [];
    if (gd.length) {
      out.push(`<h4>${esc(this.bi("Common to this species group", "الأكثر شيوعاً في فصيلة هذا الطائر"))}</h4>`);
      out.push(gd.map(x => {
        const dk = this.diseaseIn(x.name) || Object.keys(this.SPREAD).find(k => this.norm(k) === this.norm(x.name)) || x.name;
        const sp = this.SPREAD[dk];
        const lvl = sp ? clamp(sp.lvl, 0, 3) : null;
        return `<p><b>${esc(x.name)}</b>${lvl != null && lvl >= 2 ? ` <span class="pill" style="background:var(--warn);border-color:transparent">${esc(this.bi("isolates today", "يُعزل فوراً"))}</span>` : ""} ` +
          `— ${esc(this.bi("signs", "علامات"))}: ${esc(x.signs)}. ${esc(this.bi("handling", "العلاج"))}: ${esc(x.treat)}. ` +
          `<span class="hint">${esc(this.bi("to the others", "للبقية"))}: ${esc(sp ? this.bi(this.DISLVL[lvl][0], this.DISLVL[lvl][1]) :
            this.bi("not classified in the guide", "غير مصنّف في الدليل"))}</span></p>`;
      }).join(""));
      out.push(`<p class="hint">${esc(this.bi(
        "Shortlisted from the guide's own disease list for this group by sign overlap — a vet confirms it with tests.",
        "قائمة مختصرة من جدول أمراض الفصيلة في الدليل بحسب تطابق العلامات — والطبيب البيطري يؤكد بالفحص."))}</p>`);
    }
    const askedDis = this.diseaseIn(q);
    if (askedDis) out.push(this.ansDisease(askedDis, sp0));
    const prior = this.priorSigns(bird ? bird.id : null, hs);
    if (prior.length) {
      out.push(`<h4>${esc(this.bi("From your own log", "من سجلّك أنت"))}</h4>`);
      out.push(`<ul>` + prior.map(p => `<li>${esc(this.sName(p.s))} — ` +
        esc(this.bi(`${p.n} earlier note${p.n > 1 ? "s" : ""}, latest ${fmtDate(String(p.latest || new Date().toISOString()))}`,
          `${p.n} ملاحظات سابقة${p.n > 1 ? "" : ""}، آخرها ${fmtDate(String(p.latest || new Date().toISOString()))}`)) +
        `</li>`).join("") + `</ul>`);
      if (prior.length >= 2) out.push(`<p class="hint">${esc(this.bi(
        "The same signs came back: whatever fixed it last time is worth repeating, and whatever caused it is still in the room.",
        "العلائق عادت: ما أصلح المرة الماضية يستحق التكرار، والسبب الذي أدخلها لا يزال في المكان."))}</p>`);
    }
    const flock = mine.length;
    if (flock > 1 && urg >= 2) {
      out.push(`<div class="banner ${urg === 3 ? "danger" : "warn"}">${esc(this.bi(
        `You log ${flock} birds: move this one out of the shared room now, keep it warm and quiet, and do not return it before 30 disease-free days.`,
        `لديك ${flock} طيراً مسجلاً: انقل هذا الطائر من الغرفة المشتركة الآن، أبقِه دافئاً هادئاً، ولا تعده قبل ثلاثين يوماً بلا عوارض.`))}</div>`);
    }
    hs.forEach(([s], i) => {
      out.push(`<h4>${i + 1}. ${esc(this.sName(s))} <span class="hint">${esc(this.URGENCY[s.urg][this.langKey()])}</span></h4>`);
      out.push(`<p><b>${esc(this.bi("What it usually means", "غالباً يعني"))}:</b> ${esc(s.cause[this.langKey()])}</p>`);
      out.push(`<p><b>${esc(this.bi("What to do", "ماذا تفعل"))}:</b> ${esc(s.act[this.langKey()])}</p>`);
    });
    out.push(`<p class="hint">${esc(this.bi(
      "Rule of thumb: a bird that looks ill has been ill for days. Waiting to see whether it improves is how keepers lose one.",
      "قاعدة عامة: الطائر الذي يبدو مريضاً هو مريض منذ أيام. الانتظار لنرى هل يتحسن هو كيف يفقد المربّون طيورهم."))}</p>`);
    const links = (bird ? [bird] : mine).slice(0, 4).map(b => `<a class="chip" href="#/my-bird/${encodeURIComponent(b.id)}">${esc(b.nick)}</a>`).join(" ");
    if (links) out.push(`<p class="hint">${esc(this.bi("Open the bird's log: ", "افتح سجل الطائر: "))}${links}` +
      (sp0 ? ` · <a class="chip" href="${hrefFor(sp0)}">${esc(this.bi("the species page", "صفحة النوع"))}</a>` : ""));
    else if (sp0) out.push(`<p class="hint">${esc(this.bi("Log this bird under My birds and the next answer reads its own weight and notes.",
      "سجّل هذا الطائر في «طيوري» لتقرأ الإجابة التالية وزنه وملاحظاته."))} <a class="chip" href="${hrefFor(sp0)}">${esc(nameFor(sp0))}</a></p>`);
    return { kind: "triage", html: out.join(""), urg, birdId: bird ? bird.id : null,
      sci: sp0 ? sp0.sci : null, id: sp0 ? sp0.id : null };
  },

  ansRecommend(q) {
    /* "which of these two is easier" is a comparison, not a wish. Two birds the
       keeper actually named means the compare table below answers it better. */
    if (/(compare|versus|\bvs\b|vs\.|مقابل|فرق|قارن|مقارن|ايهم)/.test(this.norm(q)) &&
        this.aliasAll(this.norm(q)).length >= 2) return null;
    const ws = this.wants(q);
    if (!ws.length) return null;
    const scored = SPECIES.map(b => {
      let s = 0; const why = [];
      ws.forEach(([, patch, label]) => {
        Object.entries(patch).forEach(([k, v]) => {
          if (k === "g") { if (v.includes(b.g)) { s += 2; why.push(GROUPS[b.g][this.langKey()]); } }
          else if (k === "talk") { if (b.talk) { s += 3; why.push(this.bi("mimics sound", "يقلّد الصوت")); } }
          else if (k === "sizeMax") { if (b.sizeMax <= v) { s += 2; why.push(this.bi("under " + v + " cm", "أقل من " + v + " سم")); } }
          else if (k === "longevity") { if (b.longevity >= v[0] && b.longevity <= v[1]) { s += 2; why.push(this.bi(b.longevity + " yrs", b.longevity + " سنة")); } }
          else if (Array.isArray(v)) {
            const val = b[k];
            if (val >= v[0] && val <= v[1]) { s += 2; why.push(traitLabel(k) + " " + val + "/5"); }
            else s -= Math.min(3, val < v[0] ? v[0] - val : val - v[1]);
          }
        });
      });
      return { b, s, why: uniq(why).slice(0, 4) };
    }).filter(x => x.s > 0).sort((a, b) => b.s - a.s).slice(0, 4);
    if (!scored.length) return { kind: "recommend", html: `<p class="hint">${esc(this.bi("I read your wish as: ", "قرأت رغبتك كـ: "))}` +
      ws.map(w => `<span class="chip">${esc(this.wishName(w[2]))}</span>`).join(" ") + " " + esc(this.bi(
        "but nothing in the guide fits it exactly. The wizard asks instead of guessing.",
        "لكن لا شيء في الدليل يطابقها تماماً. المعالج يسألك بدل أن يخمّن.")) + `</p>` };
    return { kind: "recommend", html: `<p class="hint">${esc(this.bi("Matched wish: ", "الرغبة المطابقة: "))}` +
      ws.map(w => `<span class="chip">${esc(this.wishName(w[2]))}</span>`).join(" ") + `</p>` +
      scored.map(x => `<div class="row"><a href="#/bird/${x.b.id}"><b>${esc(speciesName(x.b))}</b></a>` +
        `<span class="hint">${esc(x.why.join(" · "))}</span><span class="chip">${x.s}</span></div>`).join("") +
      `<p class="hint">${esc(this.bi(
        "Ranked on the trait table of the curated species only — atlas entries carry names, classification and pictures, not husbandry scores.",
        "الترتيب على جدول صفات الأنواع المنتقاة وحدها — مدخلات الأطلس تحمل اسماً وتصنيفاً وصورة، لا درجات عناية."))}</p>` };
  },

  /* --------------------------------------------- practical arithmetic --- */
  /* A keeper's real questions are quantities, not trivia: how much food for how
     many birds for how long, what cage, when do the eggs hatch, what does the
     flock eat in a month, what spreads between birds. Every number computed
     below comes from GROUPS (the guide's own husbandry figures) plus the digits
     in the question — it is the same maths the species page calculator runs, so
     the two can never disagree. Prices are deliberately absent: they differ by
     country, and this app will not invent one. */
  PRAC: [
    /* the gap between the question word and the subject is usually a number
       ("كم يطعم ٤ طيور"), so it is matched with . not \\D */
    ["food", /((كم|how much|how many|quantity|amount|grams?|kilos?).{0,24}(طعام|اكل|علف|بذر|حبيبات|ياكل|يطعم|اطعم|تطعم|يحتاج|تحتاج|يكفي|feed|food|pellet|seed|eat)|(طعام|اكل|علف|feed|food)\D{0,12}(اليوم|يوم|شهر|اسبوع|daily|month|week))/],
    ["cage", /(قفص|اقفاص|حظيره|طياره|مساحه|مقاس|مقاسات|احجام القفص|cage|aviary|coop|dimensions|bar spacing)/],
    ["breed", /(تفريخ|تكاثر|حضانه|حضين|فقس|بيض|تعشيش|تضع البيض|هج|eegg|eggs|hatch|incubat|breed|nest|clutch|fledg|wean)/],
    ["cost", /(تكلفه|تكلف|استهلاك|شهري|شهريا|مصروف|مصاريف|monthly|per month|running cost|consumption|كم يكفي|كم كيلو|كم كيس)/],
    ["escape", /(طالع من|طلع من|خرج من|خارج القفص|القفص فتح|يهرب|هروب|السقف|يطير في الغرفة|يطير في البيت|رجع للقفص|ادخله القفص|امسكه|مسك الطائر|قص الريش|قص الريشة|تقليم|مشذب|الجناحات|شذب|flew out|flying out|escape|got out|won't come back|will not come back|wing clip|clipped|flight training|come back to me|lure)/],
    ["group", /(معدي|عزل|حجر|عدوى|ينتقل|نقل المرض|مجموعه|قطيع|سرب|تجمع|بلاط|اختلاط|\u062a\u0646\u062a\u0642\u0644|\u0627\u0646\u062a\u0642\u0627\u0644|\u0644\u0644\u0627\u0646\u0633\u0627\u0646|\u0628\u0634\u0631|\u0646\u0627\u0642\u0644|contagi|quarantin|infect|spread|flock|together|other birds|new bird|human|zoonotic|to people)/]
  ],
  PRACNAME: {
    food: ["Food and water", "الطعام والماء"], cage: ["Cage and space", "القفص والمساحة"],
    breed: ["Breeding calendar", "تقويم التفريخ"], cost: ["Monthly consumption", "الاستهلاك الشهري"],
    escape: ["Out of the cage", "خارج القفص"],
    group: ["Keeping them together", "التجمّع والعدوى"]
  },
  /* Transmission route per disease name as authored in GROUPS/D, with a level:
     3 spreads fast through the collection, 2 needs contact or shared water,
     1 comes from the environment, 0 is not infectious at all. zo = can reach
     the people in the room. */
  SPREAD: {
    "PBFD": { lvl: 3, zo: false, en: "Droppings, feather dust and shared bowls; an infected bird sheds virus for life.", ar: "الفضلات وغبار الريش والأوعية المشتركة؛ الطائر المصاب يفرز الفيروس مدى حياته." },
    "Psittacosis": { lvl: 3, zo: true, en: "Inhaled dried droppings or feather dust; reaches humans — handle with gloves and a mask.", ar: "استنشاق فضلات أو غبار ريش جاف؛ ينتقل للإنسان — تداوله وقفازات وكمامة." },
    "Egg binding": { lvl: 0, zo: false, en: "Not infectious — calcium, light and body condition.", ar: "غير معدٍ — كالسيوم وإضاءة وحالة جسدية." },
    "Avian pox": { lvl: 2, zo: false, en: "Mosquito bites and contact through skin wounds; the dry form also drifts in dust.", ar: "لدغ البعوض والاحتكاك عبر جروح الجلد، والنوع الجاف ينتقل بالغبار أيضاً." },
    "Air sac mites": { lvl: 2, zo: false, en: "Direct contact and shared perches; migrate between birds at night.", ar: "التلامس المباشر والمجاثم المشتركة؛ تنتقل بين الطيور ليلاً." },
    "Coccidiosis": { lvl: 2, zo: false, en: "Damp litter laden with droppings; needs 1–2 days in warm wet bedding to become infective.", ar: "فرشة رطبة مليئة بالفضلات؛ تحتاج يوماً أو يومين في الدفء والرطوبة لتصبح مُعدية." },
    "Canker (trichomonas)": { lvl: 2, zo: false, en: "Mouth-to-mouth feeding and shared drinking water; adults can carry it silently.", ar: "التغذية الفموية والماء المشترك؛ وقد يحملها البالغ بلا عوارض." },
    "Paramyxovirus": { lvl: 3, zo: false, en: "Droppings and respiratory discharge; survives in shared water and feed.", ar: "الفضلات والإفرازات التنفسية؛ ويعيش في الماء والعلف المشترك." },
    "Newcastle disease": { lvl: 3, zo: false, en: "Droppings, respiratory secretions, contaminated feed, boots and cages.", ar: "الفضلات والإفرازات والعلف والملابس والأقفص الملوثة." },
    "Avian influenza": { lvl: 3, zo: true, en: "Droppings and pond water; wild waterfowl carry it silently. Report a die-off to the vet authority.", ar: "الفضلات وماء البرك؛ وتحملها الطيور المائية بلا عوارض. أبلغ الطب البيطري عن النفوق." },
    "Mites and lice": { lvl: 2, zo: false, en: "Contact, nests and cracks in the loft; most bite humans too at night.", ar: "التلامس والأعشاش وشقوق الحظيرة؛ وأغلبها يلسع الإنسان ليلاً." },
    "Angel wing": { lvl: 0, zo: false, en: "Not infectious — fast growth on rich feed.", ar: "غير معدٍ — نمو سريع على غذاء دسم." },
    "Bumblefoot": { lvl: 1, zo: false, en: "From rough or dirty perches and standing droppings, not bird to bird.", ar: "من المجاثم الخشنة أو المتسخة والوقوف على الفضلات، لا من طائر لآخر." },
    "Aspergillosis": { lvl: 1, zo: false, en: "Inhaled mould spores from damp seed, bedding or a dirty loft; not passed bird to bird.", ar: "استنشاق أبغاض العفن من بذور أو فرشة رطبة أو حظيرة متسخة؛ ولا ينتقل بين الطيور." },
    "Frounce": { lvl: 1, zo: false, en: "From prey or feed carrying the protozoan; raptors catch it from wild birds.", ar: "من الفريسة أو العلف الحامل للطلائعيات؛ وتصيب الجوارح من الطيور البرية." },
    "Iron storage disease": { lvl: 0, zo: false, en: "Not infectious — diet, vitamin C and species metabolism.", ar: "غير معدٍ — الغذاء وفيتامين C واستقلاب النوع." },
    "Avian malaria": { lvl: 2, zo: false, en: "Only through mosquitoes; never directly between birds.", ar: "عبر البعوض فقط؛ ولا ينتقل مباشرة بين الطيور." }
  },
  /* How keepers actually write a disease name, in both languages and including
     the transliterations people copy from a vet's note. These are the only words
     a disease is matched on: the dictionary names themselves ("داء منقار الببغاء
     وريشه") are too generic to match a sentence against. */
  DIS_ALIAS: {
    "Coccidiosis": ["كوكسيديا", "كوكسيديوز", "coccidi", "coccidia"],
    "Psittacosis": ["ببغائية", "حمى الببغاء", "psittacosis", "chlamydia", "klamydia"],
    "PBFD": ["منقار الببغاء وريشه", "بي بي اف دي", "pbfd", "beak and feather"],
    "Avian pox": ["جدري", "جذري", "pox", "poxy"],
    "Avian influenza": ["انفلونزا", "إنفلونزا", "influenza", "bird flu"],
    "Newcastle disease": ["نيوكاسل", "لاصقة", "newcastle"],
    "Paramyxovirus": ["باراميكسو", "paramyxo"],
    "Aspergillosis": ["اسبيرجيلس", "أسبرجيلس", "فطريات الرئة", "aspergil", "mould in the lung"],
    "Bumblefoot": ["دملة", "دمامل", "bumblefoot", "foot sore"],
    "Mites and lice": ["القمل", "قمل", "القراد", "لعاث", "mites", "lice", "quafsh"],
    "Air sac mites": ["اكياس هوائية", "الأكياس الهوائية", "air sac", "syrinx mites"],
    "Canker (trichomonas)": ["كانكر", "تريكوموناس", "canker", "trichomon"],
    "Egg binding": ["احتباس البيضة", "تعليق البيضة", "egg binding", "stuck egg"],
    "Angel wing": ["الجناح الملائكي", "التواء الجناح", "angel wing"],
    "Iron storage disease": ["تراكم الحديد", "فرط الحديد", "iron storage", "hemochromatosis"],
    "Avian malaria": ["ملاريا", "malaria"],
    "Frounce": ["فرونس", "frounce"]
  },
  _disIdx: null,
  diseaseIndex() {
    if (this._disIdx) return this._disIdx;
    const idx = [], keys = Object.keys(this.SPREAD);
    const add = (txt, k) => { const n = this.norm(txt); if (n.length >= 4) idx.push([n, k]); };
    for (const k of keys) {
      add(k, k);
      (this.DIS_ALIAS[k] || []).forEach(a => add(a, k));
      const ar = typeof DIS_AR !== "undefined" && DIS_AR[k] ? DIS_AR[k][0] : null;
      if (ar) add(ar, k);
    }
    /* diseases the guide lists that have no transmission note yet stay matchable:
       answering "is X contagious" with "the guide gives no route for it" is a
       real answer, silently ignoring the name is not */
    for (const g of Object.keys(GROUPS)) (GROUPS[g].dis || []).forEach(d => {
      if (!keys.includes(d[0])) { add(d[0], d[0]); const a = typeof DIS_AR !== "undefined" && DIS_AR[d[0]] ? DIS_AR[d[0]][0] : null; if (a) add(a, d[0]); }
    });
    this._disIdx = idx.sort((a, b) => b[0].length - a[0].length);
    return this._disIdx;
  },
  diseaseIn(q) {
    const t = this.norm(q), qs = new Set(this.toks(q));
    for (const [n, k] of this.diseaseIndex()) {
      if (t.includes(n)) return k;
      const ws = this.toks(n);
      if (ws.length > 1 && ws.length <= 3 && ws.every(w => qs.has(w))) return k;
    }
    return null;
  },
  DISLVL: [["Not infectious", "غير معدٍ"], ["From the environment", "من البيئة"],
    ["Contact and shared water", "بالملامسة والماء المشترك"], ["Spreads fast through a collection", "يسري بسرعة بين التجمّع"]],
  /* One disease row, used by both the named-disease answer and the flock list.
     The level is a chip and the route its own line, so a level-0 route that
     already opens with "not infectious" is not printed twice. */
  disLine(dk, showSigns) {
    const sp = this.SPREAD[dk] || null;
    const ar = typeof DIS_AR !== "undefined" && DIS_AR[dk] ? DIS_AR[dk] : null;
    const nm = ar ? this.bi(dk, ar[0]) : this.bi(dk, (this.DIS_ALIAS[dk] || [dk])[0]);
    const lvl = sp ? clamp(sp.lvl, 0, 3) : null;
    const route = sp ? sp[this.langKey()] : (showSigns && ar ? ar[1] :
      this.bi("The guide lists this disease without a verified transmission route.", "الدليل يذكر هذا المرض بلا طريقة انتشار موثقة."));
    const chip = lvl == null ? `<span class="pill">${esc(this.bi("route not classified", "غير مصنّف الانتشار"))}</span>` :
      `<span class="pill"${lvl >= 3 ? ' style="background:var(--danger);color:var(--danger-fg);border-color:transparent"' :
        lvl === 2 ? ' style="background:var(--warn);border-color:transparent"' : ""}>${esc(this.bi(this.DISLVL[lvl][0], this.DISLVL[lvl][1]))}</span>` +
      (sp.zo ? ` <span class="pill" style="background:var(--danger);color:var(--danger-fg);border-color:transparent">${esc(this.bi("reaches humans", "ينتقل للإنسان"))}</span>` : "");
    return `<p><b>${esc(nm)}</b> ${chip}<br><span class="hint">${esc(route)}</span></p>`;
  },
  ansDisease(dk, r) {
    const sp = this.SPREAD[dk] || null, ar = typeof DIS_AR !== "undefined" && DIS_AR[dk] ? DIS_AR[dk] : null;
    const lvl = sp ? clamp(sp.lvl, 0, 3) : null;
    const out = [`<h4>🦠 ${esc(this.bi("This disease", "هذا المرض"))}</h4>` + this.disLine(dk, true)];
    if (ar && ar[1]) out.push(this.kv([[this.bi("Signs the guide lists", "العوارض كما يوردها الدليل"), ar[1]],
      [this.bi("Treatment", "العلاج"), ar[2]]]));
    const flock = store.birds.all().length;
    const reach = ["This guide lists no transmission route for it",
      "No — this one is not passed between birds.",
      "Not bird to bird: it comes from the shared environment, so fixing the environment stops it.",
      "Yes, by contact, shared water or fouled litter — isolate the sick one and change the bowls.",
      "Yes, fast — through air, dust or droppings. Treat the whole collection as exposed."];
    const reachAr = ["الدليل لا يذكر طريقة انتشار لهذا المرض",
      "لا؛ فهذا المرض لا ينتقل بين الطيور.",
      "لا تنتقل من طائر لآخر: مصدرها البيئة المشتركة، بإصلاحها يتوقف.",
      "نعم؛ بالملامسة أو الماء المشترك أو الفرشة الملوثة؛ اعزل المريض وغيّر الأوعية.",
      "نعم وبسرعة؛ عبر الهواء أو الغبار أو الفضلات. اعتبر التجمّع كله مخالطاً."];
    const lv = lvl == null ? 0 : lvl + 1;
    const spreadWord = lvl >= 2 ?
      this.bi("reaches them all before signs show", "يصلها كلها قبل ظهور العوارض") :
      this.bi("does not move between birds, so the flock is not the risk", "لا ينتقل بين الطيور فالتجمّع ليس هو الخطر");
    const mine = flock > 1 ?
      this.bi(flock + " birds are logged here, and a level " + lv + " disease " + spreadWord + ".",
        "سجلّك يضم " + flock + " طائراً، ومرضاً بمستوى " + lv + " " + spreadWord + ".") :
      this.bi("One bird logged so far, so the risk is to future arrivals — every new bird still quarantines.",
        "طائر واحد في السجل؛ الخطر على القادمين الجدد، وكل جديد يُحجر.");
    out.push(this.kv([
      [this.bi("Can it reach the others?", "هل يصل لباقي الطيور؟"), this.bi(reach[lv], reachAr[lv])],
      [this.bi("Quarantine", "الحجر"), this.bi(
        "30 days in a separate room with its own air, water and cloth; healthy birds are cared for first and the sick ones last, hands and boots between every group",
        "ثلاثون يوماً في غرفة مستقلة بهوائها ومائها وقماشها؛ السليمة تُخدم أولاً والمريضة أخيراً، واليدان والحذاء بين كل مجموعة")],
      [this.bi("Your collection", "تجمّعك"), mine]
    ]));
    const list = r && GROUPS[r.g] && GROUPS[r.g].dis ? GROUPS[r.g].dis.map(d => disText(d)[0]) : [];
    if (list.length) {
      const known = list.some(x => this.diseaseIn(x) === dk || this.norm(x).includes(this.norm(dk)));
      out.push(`<p class="hint">${known ? esc(this.bi("This one is on the guide's list for " + speciesName(r) + "'s group.", "هذا المرض ضمن قائمة الدليل لفصيلة " + speciesName(r) + ".")) :
        esc(this.bi("For this species' group the guide lists: " + list.join("، ") + ".", "أما قائمة الدليل لفصيلة هذا النوع: " + list.join("، ") + "."))} ` +
        esc(this.bi("Vaccines and medicines stay a vet's call.", "والتطعيم والدواء قرار بيطري.")) + `</p>`);
    }
    return out.join("");
  },
  /* Cage sizing is a rule of thumb, not a standard: the floor is a bird that can
     spread its wings and fly between perches. The species' own body length sets
     the length, the space score sets the class (cage below 4, aviary above). */
  cageFor(r) {
    const L = r.sizeMax || r.sizeMin || 25;
    const five = v => Math.round(v / 5) * 5;
    const table = { 1: [60, 40, 50], 2: [80, 50, 60], 3: [110, 60, 80] };
    if ((r.space || 3) >= 4) {
      const l = clamp(round(Math.max(r.space === 5 ? 3 : 2, L * 0.045), 1), 2, 12);
      return { aviary: true, l, w: round(Math.max(1.5, l * 0.6), 1), h: round(Math.max(2, l * 0.9), 1), L };
    }
    const sp = clamp(r.space || 2, 1, 3), t = table[sp];
    return { aviary: false, l: Math.max(t[0], five(L * 3)), w: Math.max(t[1], five(L * 1.6)), h: Math.max(t[2], five(L * 1.4)), L,
      bars: L < 18 ? 1.2 : L < 35 ? 1.9 : L < 70 ? 2.5 : 3.8 };
  },
  ansPractice(q) {
    const t = this.norm(q);
    const hits = this.PRAC.filter(([, re]) => re.test(t)).map(x => x[0]);
    if (!hits.length) return null;
    const f = this.figures(q);
    const bird = this.aboutBird(q);
    const spBird = bird ? byId(bird.speciesId) : null;
    const cand = this.findSpecies(q);
    /* a weighted guess is not a species the keeper named. It may still lend a
       body weight to the food maths, but it must not set a cage size, an
       incubation date or a disease list, and it must not enter the context. */
    const guessed = !spBird && this._guessed;
    const r = spBird || (!guessed ? cand[0] : null) || null;
    const dk = hits.includes("group") ? this.diseaseIn(q) : null;
    const g = r ? GROUPS[r.g] : null;
    const base = g ? g.foodWeight : 10;
    /* figures carried from the previous question: "وكم يحتاج من الماء؟" repeats
       the weight and the flock size the keeper already typed */
    const cf = (this.ctxGet() || {}).fig || {};
    const carried = f.grams == null && cf.grams != null;
    const carriedN = f.birds == null && f.pairs == null && cf.birds != null;
    const given = f.grams != null ? f.grams : (carried ? cf.grams : null);
    const body = given != null ? given : (g ? base * 6 : null);
    /* Food and cost are arithmetic — without a weight they have nothing to say.
       The rest (the cage, the calendar, the flock, a bird that is out of the
       cage) answers from the guide alone, so it is never thrown away just
       because the keeper typed no numbers. */
    const numericOnly = hits.every(h => h === "food" || h === "cost");
    const n = clamp(Math.round(f.pairs ? f.pairs * 2 : (f.birds != null ? f.birds : (carriedN ? cf.birds : 1))), 1, 20000);
    const out = [];
    /* "how much does a bird eat?" with neither a species nor a weight is still a
       real question. Silence is not an answer, so give the rule itself and name
       the one number that turns it into grams. */
    if (body == null && !r && !dk && numericOnly) out.push(
      `<h4>🍚 ${esc(this.bi("Food and water", "الطعام والماء"))}</h4>` + this.kv([
        [this.bi("Dry food", "الطعام الجاف"), this.bi(
          "12 % of the bird's body weight every day, in a 10–15 % window.",
          "١٢٪ من وزن الطائر كل يوم، في حدود بين ١٠ و١٥٪.")],
        [this.bi("Greens", "الخضار"), this.bi(
          "40 % of that dry weight — weighed, not measured by handful.",
          "٤٠٪ من وزن الطعام الجاف؛ بالوزن لا بالقبضة.")],
        [this.bi("Water", "الماء"), this.bi(
          "about 25 % of body weight a day; more in heat and through breeding.",
          "نحو ٢٥٪ من وزن الجسم يومياً؛ ويزيد في الحرّ وخلال التفريخ.")],
        [this.bi("Give me one number", "أعطني رقماً واحداً"), this.bi(
          "Name the bird and its weight — \"كم يأكل بدجي وزنه 40 غ؟\" — and this becomes grams a day, a week and a month.",
          "سمِّ الطائر ووزنه — \"كم يأكل بدجي وزنه 40 غ؟\" — فتتحول الإجابة إلى جرامات يوماً وأسبوعاً وشهراً.")]]));

    let who = r ? `<p class="hint">${this.pill(r)}` + (bird ? ` <span class="chip">${esc(bird.nick)}</span>` : "") + `</p>` :
      dk ? `<p class="hint">${esc(this.bi(
        "Answering about the disease you named, whatever the species.", "أجيب عن المرض الذي سمّيته، مهما كان النوع."))}</p>` :
      `<p class="banner warn">${esc(this.bi(
        "Your words did not name a species, so only the numbers you typed are used here. Name the bird (budgie, canary, الكاسكو…) for cage size, hatch dates and its group's diseases.",
        "لم يسمِّ سؤالك نوعاً، فاستخدمتُ أرقامك وحدها هنا. اذكر الطائر (بدجي، كناري، الكاسكو…) لتحصل على مقاس القفص وتواريخ الفقس وأمراض فصيلته."))}</p>`;
    /* an answer that applies to every species is still an answer: say it plainly
       instead of earning the warning a numbers-only food question gets */
    if (!r && !dk && body == null) who = `<p class="hint">${esc(this.bi(
      "This applies to every species here. Name the bird (budgie, canary, African grey…) and the answer adds its own cage size and its flock's diseases.",
      "هذا ما ينطبق على كل الأنواع. سمِّ الطائر (بدجي، كناري، رمادي…) فتضيف الإجابة مقاس قفصه وأمراض فصيلته."))}</p>`;
    const kgTxt = v => v >= 1000 ? round(v / 1000, 2) + " kg" : round(v, v < 10 ? 1 : 0) + " g";
    const grams = body == null ? null : body;

    if (hits.includes("food") && grams != null) {
      const perBird = Math.max(2, grams * 0.12);
      const dry = round(n * perBird, 1), green = round(dry * 0.4, 1), water = n * Math.round(grams * 0.25);
      const period = f.months ? f.months * 30 : f.weeks ? f.weeks * 7 : f.days ? f.days : 0;
      const rows = [[this.bi("Body weight used", "وزن الطائر المستخدم"), round(grams, 1) + " " + this.bi("g", "غ") +
        (f.grams != null ? "" : this.bi(carried ? " (from your previous question)" : " (the guide's typical bird for this group)",
          carried ? " (من سؤالك السابق)" : " (نموذج الدليل لهذه الفصيلة)"))],
      [this.bi("Birds counted", "عدد الطيور"), n + (carriedN ? this.bi(" (from your previous question)", " (من سؤالك السابق)") : "")]];
      rows.push([this.bi("Dry food, all birds", "الطعام الجاف للكل"), `${dry} ` + this.bi("g/day", "غ/يوم")]);
      rows.push([this.bi("Greens", "الخضار"), `${green} ` + this.bi("g/day", "غ/يوم")]);
      rows.push([this.bi("Water", "الماء"), `${water} ` + this.bi("ml/day", "مل/يوم")]);
      rows.push([this.bi("One week", "أسبوع"), kgTxt(dry * 7) + " " + this.bi("dry food", "طعام جاف")]);
      rows.push([this.bi("One month (30 days)", "شهر (٣٠ يوماً)"), kgTxt(dry * 30) + " " + this.bi("dry food", "طعام جاف")]);
      if (period) rows.push([this.bi("For the period you asked", "للمدة التي سألت عنها"),
        `${period} ` + this.bi("days → ", "يوماً ← ") + kgTxt(dry * period) + this.bi(", ", "، و") + round(water * period / 1000, 1) + this.bi(" L water", " لتر ماء")]);
      out.push(`<h4>🍚 ${esc(this.bi("Food and water", "الطعام والماء"))}</h4>` + this.kv(rows) +
        `<p class="hint">${esc(this.bi(
          "Rule of thumb: dry food at 12 % of body weight (10–15 % window), greens 40 % of that, water about 25 % of body weight. Weigh the dish, not the bird's appetite — leftovers tell you the true intake.",
          "قاعدة عملية: الطعام الجاف ١٢٪ من وزن الجسم (بين ١٠ و١٥٪)، والخضار ٤٠٪ منه، والماء نحو ٢٥٪ من وزن الجسم. زِن الطبق لا شهيّة الطائر؛ فالباقي يخبرك بالأكل الحقيقي."))}</p>`);
    }

    if (hits.includes("cage")) {
      if (!r) out.push(`<h4>📏 ${esc(this.bi("Cage and space", "القفص والمساحة"))}</h4><p class="hint">${esc(this.bi(
        "Name the species and this answers with real centimetres — space depends on body length, not on taste.",
        "سمِّ النوع فتُجيب هذه الفقرة بالسنتيمترات؛ فالمساحة تُحسب من طول الطائر لا من الذوق."))}</p>`);
      else {
        const c = this.cageFor(r);
        const rows = c.aviary
          ? [[this.bi("Flying enclosure", "قفص طيران"), `${c.l} × ${c.w} × ${c.h} ` + this.bi("m (L×W×H)", "م (طول×عرض×ارتفاع)")]]
          : [[this.bi("Minimum cage", "الحد الأدنى للقفص"), `${c.l} × ${c.w} × ${c.h} ` + this.bi("cm (L×W×H)", "سم (طول×عرض×ارتفاع)")],
            [this.bi("Bar spacing", "تباعد القضبان"), c.bars + " " + this.bi("cm", "سم")]];
        if (n > 2 || f.pairs) rows.push([this.bi("For this many birds", "لهذا العدد"), this.bi(
          `one enclosure per pair — a shared box makes two cocks fight and one hen stop laying`,
          `قفص طيران لكل زوج — القفص المشترك يجعل الذكرين يتقاتلان ويجعل الأنثى تكف عن الوضع`)]);
        rows.push([this.bi("Perches", "المجاثم"), this.bi(
          `2 levels, ${c.aviary ? "different diameters along a flight path" : "one at each end so the bird flies between them"}`,
          `مستويان، ${c.aviary ? "بأقطار مختلفة على مسار الطيران" : "واحد عند كل طرف ليطير الطائر بينهما"}`)]);
        rows.push([this.bi("Placement", "الوضع"), this.bi(
          `eye level of the room, out of draughts and kitchen fumes, with a dark quiet sleep block`,
          `بمستوى نظر الغرفة، بعيداً عن التيارات ودخان المطبخ، مع نوم مظلم هادئ`)]);
        out.push(`<h4>📏 ${esc(this.bi("Cage and space", "القفص والمساحة"))}</h4>` + this.kv(rows) +
          `<p class="hint">${esc(this.bi(
            `Derived from a body length of ${c.L} cm and the guide's space score of ${r.space || 3}/5: length ≥ 3× the bird, height enough to spread the wings. Practical floor, not a legal standard.`,
            `مشتقة من طول جسم ${c.L} سم ودرجة المساحة ${r.space || 3}/5 في الدليل: الطول ≥ ٣ أضعاف الطائر، والارتفاع يسمح بفرد الجناحين. حدّ عملي وليس مواصفة قانونية.`))}</p>`);
      }
    }

    if (hits.includes("breed")) {
      if (!g) out.push(`<h4>🥚 ${esc(this.bi("Breeding calendar", "تقويم التفريخ"))}</h4><p class="hint">${esc(this.bi(
        "Which species? Incubation length changes from 13 to 30 days across the guide.",
        "أي نوع؟ مدة التحضين تتراوح بين ١٣ و٣٠ يوماً في هذا الدليل."))}</p>`);
      else {
        const dm = String(this.digits(q)).match(/(\d{4})-(\d{2})-(\d{2})/);
        const start = dm ? `${dm[1]}-${dm[2]}-${dm[3]}` : dayKey();
        const inc = g.incDays, day = daysBetween(start, dayKey());
        const marks = [[0, "Egg set", "البيضة"], [Math.round(inc / 3), "Turning established", "انتظام قلب البيض"],
          [Math.round(inc * 2 / 3), "Pipping window", "اقتراب الفقس"], [inc, "Hatch", "الفقس"],
          [inc + 21, "Fledging (typical)", "الترييش"], [inc + 45, "Weaning checkpoint", "الفطام"]];
        const eggs = f.eggs != null ? clamp(Math.round(f.eggs), 1, 40) : null;
        const rows = marks.map(([d, en, ar]) => [`${d < day ? "✅" : "⏳"} ${esc(this.bi(en, ar))}`,
          fmtDate(addDays(start, d).toISOString()) + this.bi(` · day ${d}`, ` · اليوم ${d}`)]);
        rows.push([this.bi("Incubation for this group", "التحضين لهذه الفصيلة"), inc + " " + this.bi("days", "يوماً")]);
        if (eggs) rows.push([this.bi("Clutch expectation", "متوقع من البيض"),
          `${eggs} ` + this.bi("eggs → ≈", "بيضة ← ≈") + round(eggs * 0.7, 1) + this.bi(" fledged (typical 70 %)", " تفقيس (٧٠٪ عادة)")]);
        const lead = this.bi(
          `Counting from ${fmtDate(new Date(start).toISOString())}` + (day >= 0 ? ` — day ${Math.max(0, Math.min(day, inc))} today.` : " — that date is still ahead."),
          `احتساباً من ${fmtDate(new Date(start).toISOString())}` + (day >= 0 ? ` — نحن في اليوم ${Math.max(0, Math.min(day, inc))}.` : " — ذلك التاريخ لم يأتِ بعد."));
        out.push(`<h4>🥚 ${esc(this.bi("Breeding calendar", "تقويم التفريخ"))}</h4><p class="hint">` + esc(lead) + `</p>` +
          this.kv(rows) +
          `<p class="hint">${esc(this.bi(
            "Dates only. Clutch size, nest box size and pairing age are not verified in this dataset, so they are not guessed here — the species page has what the guide does know.",
            "تواريخ فقط. عدد البيض ومقاس صندوق العش وعمر الاقتران غير موثّقة في هذه البيانات فلا تُخمَّن هنا؛ صفحة النوع تحمل ما يعرفه الدليل."))}</p>`);
      }
    }

    if (hits.includes("cost") && grams != null) {
      if (grams == null) out.push(`<h4>💰 ${esc(this.bi("Monthly consumption", "الاستهلاك الشهري"))}</h4><p class="hint">${esc(this.bi(
        "Give the body weight or the species and the number of birds.", "اذكر وزن الطائر أو نوعه وعدد الطيور."))}</p>`);
      else {
        const dry = n * Math.max(2, grams * 0.12), month = dry * 30;
        const rows = [[this.bi("Dry food per month", "الطعام الجاف في الشهر"), round(month / 1000, 2) + " " + this.bi("kg", "كغ")],
        [this.bi("In 1 kg bags", "بأكياس الكيلوغرام"), "≈" + Math.ceil(month / 1000) + " " + this.bi("bags", "كيساً")],
        [this.bi("In 25 kg sacks", "بأكياس الـ٢٥ كغ"), round(month / 25000, 2) + " " + this.bi("sack", "كيس")],
        [this.bi("Water per month", "الماء في الشهر"), round(n * Math.round(grams * 0.25) * 30 / 1000, 1) + " " + this.bi("litres", "لتراً")],
        [this.bi("Greens per month", "الخضار في الشهر"), round(month * 0.4 / 1000, 2) + " " + this.bi("kg", "كغ")]];
        out.push(`<h4>💰 ${esc(this.bi("Monthly consumption", "الاستهلاك الشهري"))}</h4>` + this.kv(rows) +
          `<p class="hint">${esc(this.bi(
            `Consumption, not cost: ${n} bird${n > 1 ? "s" : ""} of ${round(grams, 0)} g at 12 % of body weight. Prices change by country and season, so the app converts them — multiply these kilograms by your local feed price.`,
            `استهلاك لا سعر: ${n} ${n > 1 ? "طيور" : "طائر"} بوزن ${round(grams, 0)} غ، والطعام الجاف ١٢٪ من وزن الجسم. الأسعار تختلف بين البلدان والفصول، فاضرب هذه الكيلوغرامات في سعر العلف عندك.`))}</p>`);
      }
    }

    if (hits.includes("escape")) {
      const c = r ? this.cageFor(r) : null;
      const flyer = r && (r.space || 3) >= 4;
      const rows = [
        [this.bi("How it actually happens", "كيف يحدث فعلياً"), this.bi(
          "Almost never a locked door that opened: the bird is sitting on the rim or the top perch when the door swings, or it startles at a noise and goes through the gap before you blink.",
          "نادراً ما يُفتح باب مقفل: الطائر يكون جالساً على حافة الباب أو المجثم العلوي وقت الفتح، أو يفزع من صوت فيمرّ من الفتحة قبل أن ترمش.")],
        [this.bi("Door and latch", "الباب والقفل"), this.bi(
          "A bolt that drops into a tube, or one carabiner through the door and frame eyes, beats any hook a bird can lift. Train one habit: the bird is inside and the door closes on its own weight before you let go.",
          "مزلاج يسقط في أنبوب، أو مشبك كارابينا واحدة عبر عين الباب والإطار، أقوى من أي خطاف يرفعه الطائر. وعلّم عادة واحدة: أبقِه داخل القفص ولا تترك الباب حتى يغلق بثقله.")],
        [this.bi("Perch position", "مكان المجثم"), this.bi(
          "Move the top perch and the toy ladder away from the door so nothing lands in the doorway while it is open.",
          "نقل المجثم العلوي وسُلّم الألعاب بعيداً عن الباب حتى لا يقف شيء في فتحة الباب وهو مفتوح.")],
        [this.bi("Bar spacing", "تباعد القضبان"), c && c.bars ? this.bi(
          `This bird is kept at ${c.bars} cm bars; a head that fits squeezes the body through, so a mismatched cage is an escape waiting for a surprise.`,
          `هذا النوع يُربّى على تباعد ${c.bars} سم؛ والرأس الذي يمرّ يمرّ معه الجسد، فالقفص غير المناسب هروب مؤجّل حتى أول فزعة.`) :
          this.bi("Name the species and this line gives the spacing its head cannot pass.", "سمِّ النوع فتُحدَّد هذه السطور المسافة التي لا يعبر رأسها.")],
        [this.bi("Clip, honestly", "التقليم بصدق"), flyer ? this.bi(
          "Not for this one: the guide scores it as a flyer that needs room, and clipping a bird you cannot exercise in a cage trades escape for atrophy and a broken chest.",
          "لا يصلح لهذا النوع: الدليل يصفه أنه طائر مساحة يحتاج الطيران، وتقليمه بدل توفير القفص الكبير يبدّل الهروب بضمور العضلة وصدمة الصدر.") :
          this.bi(
          "Trimming the primaries of ONE wing stops height, not running: the bird still flutter-flies to the curtain and still walks out of an open door. Only on a fully feathered adult, only one side, and never in a breeding season or on a bird that has not learned to land. It grows back with the moult.",
          "قص ريشات الطيران في جناح واحد يمنع الارتفاع لا الحركة: الطائر ما زال يرفرف إلى الستارة وما زال يخرج من الباب المفتوح. يُجرى على البالغ مكتمل الريش، على جهة واحدة فقط، ولا يُجرى في موسم التكاثر ولا على طائر لم يتعلم الهبوط. ويعود الريش مع القلش.")],
        [this.bi("The real fix is recall", "والحل الحقيقي هو النداء"), this.bi(
          "Feed the staple from your hand for a week, then call a fixed word before the dish, then open the cage only in a closed room and let the bird earn the food by stepping up. A bird that comes when called at home comes when called at the window.",
          "قدّم الغذاء الأساسي من يدك أسبوعاً، ثم نادِ كلمة ثابتة قبل الطبق، ثم لا تفتح القفص إلا في غرفة مغلقة ودع الطائر يأكل من يدك بعد أن يصعد عليها. الذي يستجيب في بيته يستجيب عند الشباك.")],
        [this.bi("Proof the room first", "احرس الغرفة قبل الطائر"), this.bi(
          "Windows and doors shut, fans off, mirrors and reflective glass covered, toilet lids down, cats and dogs out of the room — before the cage door is touched, every time.",
          "النوافذ والأبواب مغلقة، والمراوح مطفأة، والمرايا والزجاج العاكس مستورة، وأغطية الحمام منزَّلة، والقطط والكلاب خارج الغرفة — قبل لمس باب القفص، في كل مرة.")]];
      out.push(`<h4>🚪 ${esc(this.bi("Out of the cage", "خارج القفص"))}</h4>` + this.kv(rows));
      const back = [
        [this.bi("Stop the chase", "أوقف المطاردة"), this.bi(
          "Chasing makes you the predator: the more you step, the further it flies, and a panicked bird in a room breaks its chest on the fan or the glass.",
          "المطاردة تجعلك المفترس: كلما تقدمت طار أبعد، والطائر المذعور في غرفة يكسر صدره بالمروحة أو بالزجاج.")],
        [this.bi("Close the space", "ضيّق المساحة"), this.bi(
          "One room, doors shut, lights low, perches and curtains within reach only — a dim room slows the flight and shortens the distance.",
          "غرفة واحدة، أبواب مغلقة، إضاءة منخفضة، والمجاثم والستائر في متناول الطيران فقط — الإضاءة الخافتة تُبطئ الرحلة وتقصّر المسافة.")],
        [this.bi("Bribe, do not grab", "أطعم لا تمسك"), this.bi(
          "Put the cage on the floor below it with its own food and water in sight, sit still, read aloud or whistle its caged mate's call. This app's sound library plays the species' own call — that is what brings a lost bird down.",
          "ضع القفص على الأرض تحته مباشرة مع طعامه ومائه في مرمى بصره، واجلس ساكناً واقرأ بصوت مسموع أو صفّر نداء رفيقه المقفص. مكتبة الصوت في هذا التطبيق تشغّل نداء النوع نفسه — وهذا ما ينزل الطائر الضائع.")],
        [this.bi("Timing", "التوقيت"), this.bi(
          "Hunger and tiredness do the work: most birds come down on their own within an hour or at dusk. Cover it with a light cloth once it lands, then carry the perch, not the bird.",
          "الجوع والتعب يقومان بالعمل: أغلبها ينزل من نفسه خلال ساعة أو وقت المغرب. ولمّا ينزل غطّه بقماش خفيف واحمل المجثم لا الطائر.")]];
      out.push(`<h4>🪶 ${esc(this.bi("If it is already out", "وإن كان خارجاً الآن"))}</h4>` + this.kv(back) +
        `<p class="hint">${esc(this.bi(
          "Prevention here is husbandry, not gadgetry: a bird kept at the right cage size, let out to fly in a safe room on a schedule, and fed from your hand does not need to escape.",
          "الوقاية تربية لا حِيَل: طائر في قفص بمقاسه، ويُخرج ليطير في غرفة آمنة بموعد ثابت، ويأكل من يدك — لا يحتاج أن يهرب."))}</p>`);
    }

    if (hits.includes("group")) {
      if (dk) out.push(this.ansDisease(dk, r));
      else if (!r) out.push(`<h4>🦠 ${esc(this.bi("Keeping them together", "التجمّع والعدوى"))}</h4><p class="hint">${esc(this.bi(
        "Name the species or the disease — the contagious list is written per group, and a named disease answers on its own.",
        "سمِّ النوع أو المرض؛ فقائمة الأمراض المعدية مكتوبة لكل فصيلة، والمرض المسمّى يُجاب عنه وحده."))}</p>`);
      else {
        const list = GROUPS[r.g].dis || [];
        const rows = list.map(d => this.disLine(this.diseaseIn(d[0] + " " + disText(d)[0]) || d[0], false)).join("");
        const flock = store.birds.all().length;
        out.push(`<h4>🦠 ${esc(this.bi("Keeping them together", "التجمّع والعدوى"))}</h4>` +
          `<p class="hint">${esc(this.bi("Diseases the guide lists for " + speciesName(r) + "'s group:", "أمراض يسردها الدليل لفصيلة " + speciesName(r) + ":"))}</p>` + rows +
          this.kv([[this.bi("New bird", "الطائر الجديد"), this.bi("30 days in a separate room, no shared air or water, then a vet check before it joins the collection",
            "ثلاثون يوماً في غرفة مستقلة بلا هواء أو ماء مشترك، ثم فحص بيطري قبل إدخاله التجمّع")],
          [this.bi("Order of care", "ترتيب العناية"), this.bi("healthy birds first, sick ones last, hands and boots between every group",
            "الطيور السليمة أولاً والمريضة أخيراً، واليدان والقدمان بين كل مجموعة")],
          [this.bi("Quarantine the sick one", "عزل المريض"), this.bi("one cage, one cloth, one bowl set, out of the room's airflow",
            "قفص واحد وقماشه وأوعيته، وخارج مجرى هواء الغرفة")]]) +
          (flock > 1 ? `<p class="hint">${esc(this.bi(
            `Your log holds ${flock} birds — a fast-spreading disease here reaches all of them in days. New arrivals go into a separate room before anything else.`,
            `سجلّك يضم ${flock} طائراً؛ وأي مرض يسري بسرعة هنا يصلها كلها خلال أيام. الجديد يدخل غرفة منفصلة قبل كل شيء.`))}</p>` : "") +
          `<p class="hint">${esc(this.bi(
            "Routes are the guide's own disease notes; vaccination and medicine remain a vet's call.",
            "طرق الانتشار هي ملاحظات الدليل عن هذه الأمراض؛ والتطعيم والدواء قرار بيطري."))}</p>`);
      }
    }

    if (!out.length) return null;
    return { kind: "practice", sci: r ? r.sci : null, id: r && !r.atlas ? r.id : null, birdId: bird ? bird.id : null,
      html: who + out.join("") + `<p class="hint">${esc(this.bi(
        "Calculated on this device from the guide's husbandry table and your figures. Ask a follow-up — the species stays in context.",
        "حُسب على هذا الجهاز من جدول العناية في الدليل وأرقامك. تابع بالسؤال؛ يبقى النوع في السياق."))}</p>` };
  },

  findSpecies(q) {
    const t = this.norm(q);
    this._fromCtx = false; this._guessed = false;
    /* market names are direct hits: resolve them before any fuzzy path, and keep
       every one the sentence contains so a comparison has both birds */
    const byAlias = this.aliasAll(t).map(sci =>
      SPECIES.find(x => x.sci === sci) || (Atlas.get ? Atlas.get(sci) : null)).filter(Boolean);
    if (byAlias.length) return byAlias.slice(0, 3);
    const hit = SPECIES.filter(b => (b.en && t.includes(this.norm(b.en))) ||
      (b.ar && this.norm(b.ar).length > 3 && t.includes(this.norm(b.ar))) ||
      (b.sci && this.norm(b.sci).length > 5 && t.includes(this.norm(b.sci))));
    if (hit.length) return hit.slice(0, 2);
    /* clitics differ between "الببغاء" and the stored "ببغاء", so compare
       de-prefixed name words instead of raw substrings */
    const qset = new Set(this.toks(q));
    const phrase = SPECIES.filter(b => [b.ar, b.en].filter(Boolean)
      .some(n => { const ws = this.toks(n); return ws.length && ws.length <= 3 && ws.every(w => qset.has(w)); }));
    if (phrase.length) return phrase.slice(0, 2);
    /* "budgies" is not a substring of "budgerigar", so a shared stem is tried
       before falling back to the semantic index: five letters when that finds
       anything, otherwise four, which is what links budgie to budgerigar */
    const deplural = w => (w.length >= 5 && /s$/.test(w) ? w.slice(0, -1) : w);
    const wordsOf = b => this.norm([b.en, b.ar, b.sci].filter(Boolean).join(" "))
      .split(" ").filter(w => w.length > 4).map(deplural);
    const qt = this.norm(q).split(" ").filter(w => w.length > 4 && !this.STOP.has(w)).map(deplural);
    const byPre = n => SPECIES.filter(b => qt.some(x => x.length >= n &&
      wordsOf(b).some(w => w.length >= n && x.slice(0, n) === w.slice(0, n))));
    const stem = byPre(5).length ? byPre(5) : byPre(4);
    if (stem.length) return stem.slice(0, 2);
    const sem = this.semantic(q, 2).map(x => x.r).filter(Boolean);
    const atl = Atlas.match(q, 2).filter(a => !sem.some(s => s.sci === a.sci));
    const found = sem.concat(atl).slice(0, 2);
    /* reached only when no stored name, plural, stem or phrase matched: this is
       a weighted guess over descriptions, not a name hit, and it is labelled as
       one wherever it is shown */
    if (found.length) { this._fromCtx = false; this._guessed = true; return found; }
    /* nothing in the question names a bird: it is a follow-up about whatever the
       last answer was about. A back-reference ("هو", "مثله", "it", "another") or a
       bare question of two or three words reuses the topic; a long sentence with
       no cue at all is a new subject and gets no answer rather than a wrong one. */
    const c = this.ctxSpecies();
    if (!c) { this._fromCtx = false; return []; }
    const wc = this.norm(q).split(" ").filter(Boolean).length;
    const cue = /(هو|هي|هذا|هذه|ذلك|تلك|انه|ايضا|مثله|مثلها|غيره|الاخير|الثاني|الاول|نفسه|then|it|its|this|that|they|them|another|other|same|instead|also|him|her)/i.test(this.norm(q));
    this._fromCtx = cue || wc <= 4;
    return this._fromCtx ? [c] : [];
  },
  ansFacts(q) {
    const rs = this.findSpecies(q);
    if (!rs.length) return null;
    const fromCtx = this._fromCtx ? `<p class="hint">${esc(this.bi(
      "Answering about the species from the previous question — name another one to switch.",
      "أجيب عن النوع المذكور في السؤال السابق؛ سمِّ نوعاً آخر للانتقال إليه."))}</p>` : "";
    const guess = this._guessed ? `<p class="banner warn">${esc(this.bi(
      "No stored name matched your words: this is the closest weighted match in the descriptions, not a name you gave. Confirm it or name the species.",
      "لم تطابق أي تسمية محفوظة كلماتك: هذا أقرب ترجيح من الأوصاف، وليس اسماً ذكرته. تحقق منه أو سمِّ النوع."))}</p>` : "";
    return { kind: "facts", sci: rs[0].sci, id: rs[0].atlas ? null : rs[0].id, html: fromCtx + guess + rs.map(r => `<h4>${esc(speciesName(r))} <span class="hint">${esc(r.sci)}</span></h4>` +
      this.kv(this.facts(r)) + (r.atlas ? `<p class="hint">${esc(this.bi(
        "Atlas entry: name, classification and picture only — husbandry numbers are not verified for it.",
        "مدخل أطلس: اسم وتصنيف وصورة فقط — أرقام العناية غير موثّقة له."))}</p>` : "")).join("") };
  },
  ansCompare(q) {
    if (!/(compare|versus|\bvs\b|vs\.|difference|better than|worse than|مقابل|ايهم|فرق|قارن|مقارن|خير من|افضل من|اسهل من)/i.test(this.norm(q))) return null;
    const rs = this.findSpecies(q).slice(0, 2);
    /* the second column has to be a different bird: if only one name was found,
       the semantic runner-up is used, never the same species again */
    if (rs.length < 2) {
      const have = new Set(rs.map(r => r.sci));
      const sem = this.semantic(q, 6).map(x => x.r).filter(r => r && !have.has(r.sci));
      if (sem.length) rs.push(sem[0]);
    }
    if (rs.length < 2) return null;
    const head = `<tr><th></th>${rs.map(r => `<th>${esc(speciesName(r))}</th>`).join("")}</tr>`;
    const body = TRAITS.map(([k]) => `<tr><th>${esc(traitLabel(k))}</th>${rs.map(r =>
      `<td>${r[k] != null ? r[k] : "—"}</td>`).join("")}</tr>`).join("");
    const lbl = { size: ["Size", "الحجم"], life: ["Lifespan", "العمر"], origin: ["Origin", "الموطن"], tip: ["Feeding note", "ملاحظة تغذية"] };
    const extra = Object.keys(lbl).map(f => `<tr><th>${esc(this.bi(lbl[f][0], lbl[f][1]))}</th>${rs.map(r =>
      `<td>${esc(this.locVal(r[f]) || "—")}</td>`).join("")}</tr>`).join("");
    return { kind: "compare", html: `<div class="table-wrap"><table>${head}${body}${extra}</table></div>` };
  },
  ansSearch(q) {
    const hits = this.semantic(q, 7);
    if (!hits.length) return null;
    return { kind: "search", html: `<p class="hint">${esc(this.bi(
      "Closest matches in the data on this device, by word weight:",
      "أقرب المطابقات في بيانات هذا الجهاز، بترجيح الكلمات:"))}</p>` +
      hits.map(x => `<div class="row">${this.pill(x.r)}<span class="chip">${round(x.s, 2)}</span></div>`).join("") };
  },
  HELP() {
    const ex = [["Why is my bird fluffed up and not eating?", "لماذا طائري منفش الريش ولا يأكل؟"],
      ["A quiet small cheap bird for an apartment", "طائر صغير هادئ رخيص للشقة"],
      ["How long do budgies live and what do they eat?", "كم يعيش الاسترالي وماذا يأكل؟"],
      ["Compare canary and zebra finch", "قارن بين الكناري والزيبرا"]];
    const pick = I18N.lang === "ar" ? 1 : 0;
    return `<p class="hint">${esc(this.bi("Ask in your own words. Some things it answers well:", "اسلوبك مقبول. أمثلة تجيب عنها جيداً:"))}</p>` +
      `<ul>${ex.map(e => `<li><button class="btn ghost sm qex" data-q="${esc(e[pick])}">${esc(e[pick])}</button></li>`).join("")}</ul>`;
  },
  /* "how long does X live, what does X eat" is a facts question even when the
     sentence also contains a symptom word ("يأكل" matches "لا يأكل"), so the
     fact intent is detected first and reorders the answer chain */
  FACTINT: /(how long|lifespan|life span|what (does|do|can|should).*?(eat|feed|given)|can .*?eat|where .*?live|how big|how (much|heavy)|when .*?(breed|lay|hatch)|do they|are they|كم (يعيش|تعيش|يبلغ|تبلغ|وزن|تكلف|يستغرق)|ماذا (ياكل|يات|يطعم|يفعل)|اين (يعيش|تعيش)|متى (يتكاثر|تضع|يفقس)|هل (ياكل|يات|يتكلم|يمكن))/i,
  factIntent(q) { return this.FACTINT.test(this.norm(q)); },
  /* Each answer writes what it was about into the persisted context, so the next
     sentence can be "وكم يحتاج من الأكل؟" with no name in it. Nothing is written
     when the answer resolved no species and no bird. */
  remember(ans, q) {
    const patch = {};
    if (ans.sci) patch.sci = ans.sci;
    if (ans.id) patch.id = ans.id;
    if (ans.birdId) patch.birdId = ans.birdId;
    if (q) {
      const f = this.figures(q);
      if (f.grams != null || f.birds != null) patch.fig = { grams: f.grams, birds: f.birds };
    }
    if (Object.keys(patch).length) this.ctxSet(patch);
  },
  local(q) {
    const chain = this.factIntent(q)
      ? [this.ansPractice, this.ansFacts, this.ansCompare, this.ansTriage, this.ansRecommend, this.ansSearch]
      : [this.ansTriage, this.ansPractice, this.ansRecommend, this.ansCompare, this.ansFacts, this.ansSearch];
    this._fromCtx = false;
    for (const fn of chain) {
      const ans = fn.call(this, q);
      if (ans) { ans.engine = "local"; this.remember(ans, q); return ans; }
    }
    return { kind: "help", engine: "local", html: this.HELP() };
  },

  /* ------------------------------------------------ cloud bridge (opt-in) */
  /* Every endpoint here speaks the OpenAI chat-completions shape, which is what
     stream() above already sends. The local entries are the two servers keepers
     run on their own machine, where no key leaves the device — both need to be
     told to accept requests from a browser origin, so the hint says so. */
  PRESETS: [
    { k: "openai", base: "https://api.openai.com/v1", model: "gpt-4o-mini", key: true,
      en: "OpenAI", ar: "OpenAI" },
    { k: "openrouter", base: "https://openrouter.ai/api/v1", model: "openai/gpt-4o-mini", key: true,
      en: "OpenRouter", ar: "OpenRouter" },
    { k: "groq", base: "https://api.groq.com/openai/v1", model: "llama-3.1-8b-instant", key: true,
      en: "Groq", ar: "Groq" },
    { k: "ollama", base: "http://localhost:11434/v1", model: "qwen2.5:7b", key: false,
      en: "Ollama on this machine", ar: "Ollama على هذا الجهاز" },
    { k: "lmstudio", base: "http://localhost:1234/v1", model: "local-model", key: false,
      en: "LM Studio", ar: "LM Studio" }
  ],
  cfg() {
    const s = store.settings;
    return { base: (s.aiBase || "").trim().replace(/\/+$/, ""), key: (s.aiKey || "").trim(), model: (s.aiModel || "").trim() };
  },
  cloudOn() { const c = this.cfg(); return !!(c.base && c.model); },
  pack(q) {
    const bits = [], bird = this.aboutBird(q);
    if (bird) {
      const sp = byId(bird.speciesId), tw = this.trend(bird.id);
      const recs = store.symptoms.all().filter(s => s.birdId === bird.id);
      bits.push(this.bi("My bird ", "طائري ") + bird.nick + ": " +
        (sp ? speciesName(sp) + " (" + sp.sci + ")" : this.bi("species unknown", "النوع غير معروف")) +
        (tw ? this.bi(`, weight ${tw.first}→${tw.last} g over ${tw.n} weigh-ins`, `، الوزن ${tw.first}→${tw.last} غ عبر ${tw.n} قياسات`)
          : this.bi(", no weight logged", ", لا وزن مسجل")) +
        this.bi(`, ${recs.length} symptom notes`, `، ${recs.length} ملاحظات عرض`) +
        (recs[0] ? ": " + String(recs[0].text).slice(0, 160) : ""));
    }
    this.semantic(q, 5).forEach(x => {
      const r = x.r, rg = r.g ? GROUPS[r.g] : null;
      bits.push([speciesName(r) || r.sci, r.sci, r.origin, r.size, r.life, r.tip,
        rg ? rg.en : "",
        rg && rg.incDays ? this.bi(`incubation ${rg.incDays} days, typical daily food ${rg.foodWeight} g`, `التحضين ${rg.incDays} يوماً، والطعام اليومي النموذجي ${rg.foodWeight} غ`) : "",
        r.noise != null ? `noise ${r.noise}/5 difficulty ${r.difficulty}/5 cost ${r.cost}/5 sociability ${r.sociability}/5 space ${r.space}/5` : ""]
        .filter(Boolean).join(" | "));
    });
    /* the cloud model sees the same running topic and the same parsed numbers the
       local arithmetic used, so a follow-up does not restart from zero */
    const c = this.ctxSpecies();
    if (c) bits.push(this.bi("Topic of the previous answer on this device: ", "موضوع الإجابة السابقة على هذا الجهاز: ") +
      [speciesName(c), c.sci].filter(Boolean).join(" / "));
    const fg = this.figures(q);
    if (fg.raw.length) bits.push(this.bi("Numbers written by the user: ", "الأرقام التي كتبها المستخدم: ") +
      fg.raw.map(x => x.v + (x.u ? " " + x.u : "")).join(", "));
    const hs = this.hits(this.norm(q));
    if (hs.length) bits.push(this.bi("Local triage: ", "فرز محلي: ") +
      this.URGENCY[Math.max.apply(null, hs.map(x => x[0].urg))][this.langKey()]);
    return bits.join("\n");
  },
  sys(q) {
    const L = I18N.lang === "ar"
      ? "أنت مساعد تربية الطيور داخل دليل يعمل بلا إنترنت. أجب بالعربية في أقل من 180 كلمة، نصاً واضحاً، دون اختلاق حقائق عن الأنواع. " +
        "استخدم كتلة الأدلة المحلية أدناه فقط؛ وما لا تغطِّه قل إنك غير متأكد منه. لا تخترع أسعاراً ولا جرعات دواء ولا أحكاماً قانونية. " +
        "إن كان السؤال عن كمية أكل أو مساحة قفص أو موعد فقس، احسب من الأرقام المكتوبة في السؤال ومن أرقام الدليل واذكر القاعدة المستخدمة. " +
        "عند أي احتمال طارئ اذكر زيارة طبيب طيور وأعطِ الإجراء الآمن المؤقت. الأدلة:\n"
      : "You are the bird-keeping assistant inside an offline-first guide. Answer in English, under 180 words, plain prose, no invented species facts. " +
        "Rely only on the local evidence block below; where it is silent, say you are unsure. Never invent prices, drug doses or legal claims. " +
        "For food quantity, cage size or hatch dates, compute from the numbers the user wrote and the guide figures, and name the rule you used. " +
        "For anything that could be an emergency, name an avian vet and give the safe interim step. Evidence:\n";
    return L + this.pack(q) + "\n" + (I18N.lang === "ar" ? "سؤال المستخدم: " : "User question: ") + q;
  },
  async stream(q, onToken, signal) {
    const c = this.cfg();
    if (!c.base || !c.model) throw new Error(this.bi("No model configured in Settings.", "لم تُضبط نموذج في الإعدادات."));
    const url = /chat\/completions$/.test(c.base) ? c.base : c.base + "/chat/completions";
    const headers = { "Content-Type": "application/json", "Accept": "text/event-stream" };
    if (c.key) headers["Authorization"] = "Bearer " + c.key;
    const res = await fetch(url, {
      method: "POST", headers, signal,
      body: JSON.stringify({ model: c.model, stream: true, temperature: 0.3,
        messages: [{ role: "system", content: this.sys(q) }, { role: "user", content: q }] })
    });
    if (!res.ok || !res.body) {
      let txt = ""; try { txt = String(await res.text() || "").slice(0, 180); } catch { /* opaque error body */ }
      throw new Error("HTTP " + res.status + (txt ? " — " + txt : ""));
    }
    const rd = res.body.getReader(), dec = new TextDecoder();
    let buf = "", got = 0;
    for (;;) {
      const r = await rd.read();
      if (r.done) break;
      buf += dec.decode(r.value, { stream: true });
      const lines = buf.split("\n"); buf = lines.pop();
      for (const raw of lines) {
        const line = raw.trim();
        if (line.indexOf("data:") !== 0) continue;
        const js = line.slice(5).trim();
        if (js === "[DONE]") return got;
        try {
          const o = JSON.parse(js);
          const ch = (o.choices || [])[0];
          const d = ch && ((ch.delta && ch.delta.content) || (ch.message && ch.message.content)) || "";
          if (d) { got += d.length; onToken(d); }
        } catch { /* keep-alive or partial frame */ }
      }
    }
    return got;
  },
  /* One tiny non-streaming completion: proves the address resolves, the browser
     is allowed to call it (CORS), the key is accepted and the model exists. The
     report is what the server actually answered, never a guess. */
  async test() {
    const c = this.cfg();
    if (!c.base || !c.model) throw new Error(this.bi("Base URL and model name are both required.", "يلزم عنوان النموذج واسمه معاً."));
    const url = /chat\/completions$/.test(c.base) ? c.base : c.base + "/chat/completions";
    const headers = { "Content-Type": "application/json" };
    if (c.key) headers["Authorization"] = "Bearer " + c.key;
    const t0 = Date.now();
    let res;
    try {
      res = await fetch(url, { method: "POST", headers,
        body: JSON.stringify({ model: c.model, stream: false, max_tokens: 8, temperature: 0,
          messages: [{ role: "user", content: "Reply with exactly: ready" }] }) });
    } catch (e) {
      throw new Error(this.bi("The browser could not reach it — check the address, and for a local server allow this origin (OLLAMA_ORIGINS / LM Studio CORS).",
        "لم يصل المتصفح للنموذج — راجع العنوان، ولو كان النموذج محلياً اسمح لهذا المصدر بالوصول (OLLAMA_ORIGINS أو إعداد CORS في LM Studio)."));
    }
    const txt = await res.text().catch(() => "");
    if (!res.ok) {
      const why = res.status === 401 || res.status === 403 ? this.bi("key rejected", "المفتاح مرفوض")
        : res.status === 404 ? this.bi("model or path not found", "النموذج أو المسار غير موجود")
        : res.status === 429 ? this.bi("rate limited", "تجاوز معدل الطلبات") : "";
      throw new Error("HTTP " + res.status + (why ? " — " + why : "") + (txt ? " · " + String(txt).slice(0, 140) : ""));
    }
    let echo = "";
    try { const o = JSON.parse(txt); const ch = (o.choices || [])[0]; echo = String((ch && ((ch.message && ch.message.content) || ch.text)) || "").trim(); }
    catch { echo = txt.slice(0, 40); }
    return { ms: Date.now() - t0, echo: echo.slice(0, 40), model: c.model };
  },
};

/* ----------------------------------------------------------- SEARCH ENGINE */
function fuzzyScore(query, text) {
  const q = query.toLowerCase().trim(), t = (text || "").toLowerCase();
  if (!q) return 1;
  if (t === q) return 100;
  if (t.startsWith(q)) return 60 - t.length / 100;
  const idx = t.indexOf(q);
  if (idx >= 0) return 40 - idx / 20;
  const words = q.split(/\s+/).filter(Boolean);
  const hitAll = words.every(w => t.includes(w));
  if (hitAll) return 25 + words.length * 4;
  let i = 0; for (const ch of t) if (ch === q[i]) i++;
  return i === q.length ? 12 - idx : (words.some(w => t.includes(w.slice(0, 4))) ? 6 : 0);
}
const FILTER_DEFAULT = () => ({ g: "all", sort: "name", size: [0, 300], life: [0, 80], noise: [1, 5], difficulty: [1, 5], cost: [1, 5],
  src: "guide", page: 0, ord: "all", aImg: false, aAr: false });
let filters = FILTER_DEFAULT();

function searchSpecies(q, f = filters) {
  const hay = b => [speciesName(b), b.en, b.ar, b.sci, b.origin, GROUPS[b.g].en, GROUPS[b.g].ar, b.tip,
    AI.aliasOf(b.sci).join(" ")].filter(Boolean).join(" • ");
  let out = SPECIES.filter(b => {
    if (f.g === "fav" ? !isFav(b.id) : (f.g !== "all" && b.g !== f.g)) return false;
    if (b.sizeMax < f.size[0] || b.sizeMin > f.size[1]) return false;
    if (b.lifeMax < f.life[0] || b.lifeMin > f.life[1]) return false;
    if (b.noise < f.noise[0] || b.noise > f.noise[1]) return false;
    if (b.difficulty < f.difficulty[0] || b.difficulty > f.difficulty[1]) return false;
    if (b.cost < f.cost[0] || b.cost > f.cost[1]) return false;
    return true;
  });
  if (q.trim()) out = out.map(b => ({ b, s: Math.max(fuzzyScore(q, speciesName(b)), fuzzyScore(q, b.en), fuzzyScore(q, b.sci), fuzzyScore(q, b.origin) * .7) }))
    .filter(x => x.s > 0).sort((x, y) => y.s - x.s).map(x => x.b);
  else {
    const cmp = { name: (x, y) => speciesName(x).localeCompare(speciesName(y)),
      small: (x, y) => x.sizeMin - y.sizeMin || speciesName(x).localeCompare(speciesName(y)),
      big: (x, y) => y.sizeMax - x.sizeMax,
      long: (x, y) => y.lifeMax - x.lifeMax,
      easy: (x, y) => x.difficulty - y.difficulty || y.lifeMax - x.lifeMax,
      quiet: (x, y) => x.noise - y.noise || speciesName(x).localeCompare(speciesName(y)),
      social: (x, y) => y.sociability - x.sociability || speciesName(x).localeCompare(speciesName(y)) };
    out = out.slice().sort(cmp[f.sort] || cmp.name);
  }
  return out;
}

/* ---------------------------------------------------- RECOMMENDATION ENGINE */
const WIZ = [
  { k: "home", q: { en: "Where will the bird live?", ar: "أين سيعيش الطائر؟" }, o: [
    ["flat-quiet", { en: "Apartment, quiet neighbours", ar: "شقة بجيران هادئين" }, { noise: [1, 2] }],
    ["house", { en: "House with a garden or aviary", ar: "بيت مع حديقة أو حظيرة" }, { space: [1, 5] }],
    ["yard", { en: "Free-range yard / coop", ar: "فناء حر و حظيرة" }, { space: [3, 5], g: ["po", "wa", "do"] }],
    ["room", { en: "One shared room, noise is fine", ar: "غرفة مشتركة والضجيج مقبول" }, { noise: [1, 5] }],
  ]},
  { k: "time", q: { en: "Hours of daily attention you can give", ar: "كم ساعة اهتمام يومية تعطيه؟" }, o: [
    ["little", { en: "Under 30 minutes", ar: "أقل من ٣٠ دقيقة" }, { sociability: [1, 2], difficulty: [1, 2] }],
    ["some", { en: "30–90 minutes", ar: "من ٣٠ إلى ٩٠ دقيقة" }, { difficulty: [1, 3] }],
    ["lots", { en: "2 hours or more", ar: "ساعتان أو أكثر" }, { sociability: [3, 5] }],
    ["team", { en: "Several people share the care", ar: "عدة أشخاص يتقاسمون العناية" }, { difficulty: [4, 5] }],
  ]},
  { k: "exp", q: { en: "Experience with birds", ar: "خبرتك مع الطيور" }, o: [
    ["first", { en: "First bird ever", ar: "أول طائر لي" }, { difficulty: [1, 2] }],
    ["some", { en: "Had birds before", ar: "ربّيت طيوراً من قبل" }, { difficulty: [1, 4] }],
    ["good", { en: "Confident with husbandry", ar: "لديّ خبرة جيدة في التربية" }, { difficulty: [2, 5] }],
    ["pro", { en: "Breeder / licensed handler", ar: "مُربٍّ أو مرخّص" }, { difficulty: [3, 5] }],
  ]},
  { k: "want", q: { en: "What do you want most from it?", ar: "ما أكثر ما تريده منه؟" }, o: [
    ["talk", { en: "Talking or whistling", ar: "الكلمات أو الصفير" }, { talk: true }],
    ["song", { en: "Song and beauty", ar: "الغناء والجمال" }, { noise: [2, 4], g: ["fi", "so"] }],
    ["pet", { en: "A hands-on companion", ar: "رفيق يمسك باليد" }, { sociability: [4, 5] }],
    ["eggs", { en: "Eggs or a breeding project", ar: "بيض أو مشروع تفريخ" }, { g: ["po", "wa", "do"], space: [3, 5] }],
  ]},
  { k: "years", q: { en: "How long do you want a commitment of?", ar: "لأي مدة تريد الالتزام؟" }, o: [
    ["short", { en: "Up to 8 years", ar: "حتى ٨ سنوات" }, { longevity: [0, 8] }],
    ["mid", { en: "10–25 years", ar: "من ١٠ إلى ٢٥ سنة" }, { longevity: [10, 25] }],
    ["life", { en: "As long as I live", ar: "طالما عشت" }, { longevity: [25, 90] }],
  ]},
  { k: "budget", q: { en: "Running-cost budget", ar: "ميزانية مصروف التشغيل" }, o: [
    ["low", { en: "Keep it cheap", ar: "بأقل تكلفة" }, { cost: [1, 2] }],
    ["mid", { en: "Moderate", ar: "متوسطة" }, { cost: [1, 4] }],
    ["open", { en: "Cost is not a limit", ar: "التكلفة ليست حدّاً" }, { cost: [1, 5] }],
  ]},
];

function recommend(answers) {
  const hard = [], soft = [];
  Object.values(answers).forEach(choices => {
    (choices || []).forEach(choice => Object.entries(choice.w || {}).forEach(([k, v]) => {
      if (k === "g") { const gs = v.slice(); hard.push(b => gs.includes(b.g)); }
      else if (k === "talk") hard.push(b => b.talk);
      else soft.push([k, v]);
    }));
  });
  const scoreOf = b => {
    let s = 0; const why = [];
    soft.forEach(([k, range]) => {
      const [lo, hi] = range, v = b[k];
      if (v >= lo && v <= hi) { s += 3; why.push(traitLabel(k) + " " + v + "/5"); }
      else s -= Math.min(4, v < lo ? lo - v : v - hi);
    });
    if (b.talk) why.push(I18N.lang === "ar" ? "قد يقلّد الصوت" : "May mimic sound");
    if (b.noise <= 2) why.push(I18N.lang === "ar" ? "هادئ نسبياً" : "Relatively quiet");
    if (b.difficulty <= 2) why.push(I18N.lang === "ar" ? "سهل العناية" : "Easy to care for");
    if (b.cost <= 2) why.push(I18N.lang === "ar" ? "تكلفة تشغيل منخفضة" : "Low running cost");
    return { b, score: round(s, 1), why: uniq(why).slice(0, 4) };
  };
  const strict = SPECIES.map(scoreOf).filter((r, i) => hard.every(t => t(SPECIES[i])));
  if (strict.length >= 3) return strict.sort((x, y) => y.score - x.score);
  /* Answers can contradict (a talking waterfowl): rank everything with a penalty
   * per unmet constraint instead of returning nothing. */
  return SPECIES.map(b => {
    const r = scoreOf(b), unmet = hard.filter(t => !t(b)).length;
    if (unmet) {
      r.score -= unmet * 8;
      r.why.unshift(I18N.lang === "ar" ? "يطابق بعض إجاباتك فقط" : "Partial match only");
    }
    return r;
  }).sort((x, y) => y.score - x.score);
}

/* -------------------------------------------------- SPACED REPETITION (SM-2) */
const SRS = {
  grade(card, q) {
    const g = card || { interval: 0, ease: 2.5, reps: 0, due: 0, lapses: 0 };
    if (q < 1) return { ...g, interval: q === 0 ? 0 : 1, ease: Math.max(1.3, g.ease - .2), reps: g.reps + 1, lapses: g.lapses + 1, due: Date.now() + (q === 0 ? 6e4 : 6e5) };
    const nI = g.reps === 0 ? 1 : g.reps === 1 ? 6 : round(g.interval * (q === 2 ? g.ease : g.ease * .78), 0);
    const days = clamp(q === 2 ? nI : Math.max(1, nI * .6), 1, 365);
    return { ...g, interval: days, ease: clamp(g.ease + (q === 2 ? .12 : -.2), 1.3, 3.2), reps: g.reps + 1, due: Date.now() + days * 864e5 };
  },
  due() { const now = Date.now(); return Object.entries(store.cards).filter(([, c]) => c.due <= now).map(([id, c]) => ({ id, c })).slice(0, 20); },
  count() { const now = Date.now(); return Object.values(store.cards).filter(c => c.due <= now).length; },
  apply(id, q) { store.cards[id] = this.grade(store.cards[id], q); store.progress.reviews++; award(q >= 1 ? q * 3 : 1); store.persist(); },
};

const BADGES = [
  ["explorer", "🧭", 5, b => store.visits.size >= b, { en: "Explored 5 species", ar: "استكشف ٥ أنواع" }],
  ["curator", "📚", 15, b => store.visits.size >= b, { en: "Explored 15 species", ar: "استكشف ١٥ نوعاً" }],
  ["completionist", "🏆", SPECIES.length, b => store.visits.size >= b, { en: "Explored every species", ar: "استكشف كل الأنواع" }],
  ["keeper", "🪺", 1, b => store.birds.all().length >= b, { en: "Registered a bird", ar: "سجّل طائراً" }],
  ["flock", "🐓", 5, b => store.birds.all().length >= b, { en: "Five birds in your flock", ar: "٥ طيور في مربيتك" }],
  ["ornithologist", "🗺️", 10, b => store.sightings.all().length >= b, { en: "10 logged sightings", ar: "١٠ مشاهدات مسجلة" }],
  ["scholar", "🎓", 20, b => store.progress.reviews >= b, { en: "20 reviews done", ar: "٢٠ مراجعة منجزة" }],
  ["quizmaster", "🧠", 3, b => store.progress.streak >= b, { en: "Streak of 3 correct", ar: "٣ إجابات صحيحة متتالية" }],
];
function award(n) {
  const p = store.progress, today = dayKey();
  if (p.lastDay !== today) { p.lastDay = today; }
  p.points += n; p.best = Math.max(p.best, p.streak);
  const earned = BADGES.filter(([id, , need, test]) => !p["un_" + id] && test(need));
  earned.forEach(([id, e, , , name]) => { p["un_" + id] = true; toast(e + " " + (name[I18N.lang] || name.en), "ok", 3200); });
  store.persist();
}

