  pa: { diet:["الحبيبات الجيدة أساسًا مع خلطة بذور","خضروات طازجة يوميًا وقليل من الفاكهة","ماء نظيف طازج كل يوم"],
    care:["قفص واسع يسمح بفرد الجناحين","تواصل يومي وتحفيز ذهني","نوم هادئ ومظلم من ١٠ إلى ١٢ ساعة"] },
  fi: { diet:["خلطة بذور جيدة مخصّصة للشرشير","خضروات ورقية ومبشورة طازجة","عظم حبار وحصى صغيرة"],
    care:["قفص طيران واسع — المساحة الأفقية أهم","وضع هادئ بعيدًا عن تيارات الهواء","هواء نظيف: لا دخان ولا رذاذ معطّر"] },
  do: { diet:["خلطة حبوب: ذرة وبازلاء وقمح وشعير","حصى ومكمل معدني","ماء طازج يوميًا"],
    care:["حظيرة جافة جيدة التهوية","تنظيف الزرق يوميًا","عزل الطيور الجديدة ثلاثين يومًا"] },
  po: { diet:["علف كامل مطابق للعمر والغرض","حصى وقشر محار لصلابة القشر","ماء نظيف متاح دائمًا"],
    care:["حظيرة جافة واقية من المفترسات","صناديق تعشيش ومكان للاستحمام بالتراب","أمن حيوي صارم: موطئ معقّم وتقليل الزوار"] },
  wa: { diet:["علف بط وإوز أو حبوب (وليس الخبز)","خضروات ونباتات مائية","ماء يكفي لغمر الرأس فيه"],
    care:["ماء نظيف للسباحة والاستحمام","فرشة جافة ليلًا","حماية من المفترسات عند حافة البركة"] },
  ra: { diet:["فرائس كاملة: سماني وقوارض وكتاكيت يوم واحد","لحم طازج أو مذاب بطريقة سليمة فقط","ماء نظيف للاستحمام"],
