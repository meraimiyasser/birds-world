};
const DIS_AR = {
  "PBFD":["داء منقار الببغاء وريشه","تشوّه الريش وتغيّر المنقار","لا علاج؛ عزل صارم"],
  "Psittacosis":["الببغائية (حمى الببغاء)","براز أخضر مائل للصفرة وإفرازات العين","مضاد حيوي بوصفة بيطرية (منتقل للإنسان — اغسل اليدين)"],
  "Egg binding":["احتباس البيضة","أنثى منفوشة جالسة على الأرض مع تلاشٍ وانتفاخ البطن","طارئ: تدفئة وهدوء ثم بيطري فوري (كالسيوم وإخراج البيضة بمساعدة)"],
  "Avian pox":["جُدري الطيور","ثآليل وقشور على الوجه أو الأقدام أو داخل الفم","لا علاج نوعي؛ عناية داعمة بيطرية وعزل ومكافحة البعوض"],
  "Avian influenza":["إنفلونزا الطيور","نفوق مفاجئ وتورّم الرأس وصعوبة تنفس وقلة الأكل","لا علاج؛ يُبلَّغ الطب البيطري وتُعزل الطيور"],
  "Aspergillosis":["التهاب رئوي فطري (أسبرجيلس)","تنفس بفم مفتوح واهتزاز الذيل وتغيّر الصوت ووهن","مضادات فطرية بوصفة بيطرية وأحيانًا استنشاق؛ عالج العفن والغبار"],
  "Bumblefoot":["دملة باطن القدم","تورّم أو قرحة في باطن القدم وعرج وقشور","تنظيف بيطري للجرح وضماد ومضاد حيوي"],
  "Coccidiosis":["داء الكوكسيديا","إسهال قد يكون مدممًا ونقص وزن وريش منفوش","دواء مضاد للكوكسيديا بوصفة بيطرية؛ مسكن جاف ونظيف"],
  "Mites and lice":["القمل والقراد","حكة وقشور وتلف الريش وعدم استقرار","علاج مضاد للطفيليات معتمد؛ نظّف القفص والمجاثم"],
  "Air sac mites":["قراد الأكياس الهوائية","طقطقة عند التنفس واهتزاز الذيل","علاج مضاد للطفيليات"],
  "Canker (trichomonas)":["الكانكر (التريكوموناس)","تقرّحات صفراء جبنية في الحلق","دواء مضاد للطلائعيات"],
  "Paramyxovirus":["الباراميكسوفيروس","التواء الرقبة والرعشة","تطعيم وعزل"],
  "Newcastle disease":["داء نيوكاسل","عطاس وإسهال أخضر","تطعيم وعزل"],
  "Angel wing":["الجناح الملائكي","التواء ريش الجناح إلى الخارج","جبيرة مبكرة مع تصحيح الغذاء"],
  "Frounce":["الفرونس","تقرّحات صفراء داخل الفم","دواء مضاد للطلائعيات"],
  "Iron storage disease":["مرض تراكم الحديد","نقص وزن وانتفاخ البطن","غذاء منخفض الحديد مع فيتامين C"],
  "Avian malaria":["ملاريا الطيور","وهن وشحوب اللثة","علاج مضاد للملاريا مع مكافحة البعوض"],
};
