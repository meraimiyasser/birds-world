const ROUTES = [
  ["#/", "home"], ["#/birds", "browse"], ["#/bird/", "detail"], ["#/find", "wizard"],
  ["#/my-birds", "birds"], ["#/my-bird/", "bird"], ["#/sightings", "sightings"],
  ["#/learn", "learn"], ["#/atlas", "atlas"], ["#/identify", "identify"], ["#/ai", "ai"],
  ["#/settings", "settings"],
];
const NAV = [["#/", "nav_home"], ["#/birds", "nav_birds"], ["#/find", "nav_wizard"],
  ["#/my-birds", "nav_mybirds"], ["#/sightings", "nav_sightings"], ["#/atlas", "nav_atlas"],
  ["#/identify", "nav_id"], ["#/ai", "nav_ai"], ["#/learn", "nav_learn"], ["#/settings", "nav_settings"]];

function renderNav() {
  $("#nav").innerHTML = NAV.map(([href, k]) => {
    const cur = location.hash === href || (href !== "#/" && location.hash.startsWith(href + "/"));
    return `<a href="${href}"${cur ? ' aria-current="page"' : ""}>${esc(tr(k))}</a>`;
  }).join("");
  $("#btnLang").textContent = I18N.lang === "ar" ? "EN" : "ع";
  $("#btnTheme").textContent = store.settings.theme === "dark" ? "☀️" : store.settings.theme === "light" ? "🌙" : "🌗";
}
const setCompN = () => { $("#compN").textContent = store.compare.length; };

function statCards() {
  return statBlock([
    [SPECIES.length, tr("stat_species")], [Atlas.count(), tr("stat_atlas"), "stAtlas"], [Object.keys(GROUPS).length, tr("stat_groups")],
    [store.favs.size, tr("stat_fav")], [store.visits.size + "/" + SPECIES.length, tr("stat_seen")],
    [store.birds.all().length, tr("stat_mine")], [store.sightings.all().length, tr("stat_sights")],
  ]);
}
const birdOfDay = () => SPECIES[Math.floor(Date.now() / 864e5) % SPECIES.length];

function cardHTML(b) {
  const g = GROUPS[b.g];
  return `<article class="card spec" data-id="${b.id}">
    <button class="star" data-fav="${b.id}" aria-pressed="${isFav(b.id)}" aria-label="${esc(tr("stat_fav"))}">${isFav(b.id) ? "♥" : "♡"}</button>
    <a class="thumb" href="#/bird/${b.id}" data-zoom="${b.id}" aria-label="${esc(speciesName(b))}">
      <div class="ph">${g.e}</div><img alt="${esc(speciesName(b))}" loading="lazy" decoding="async">
    </a>
    <div class="body">
      <h3><a href="#/bird/${b.id}">${esc(speciesName(b))}</a></h3>
      <div class="sci">${esc(b.sci)}</div>
      <div class="meta"><span class="pill">${g.e} ${esc(I18N.lang === "ar" && g.ar ? g.ar : g.en)}</span>
        <span class="pill">📏 ${esc(b.size)}</span><span class="pill">⏳ ${esc(b.life)}</span></div>
      <div class="foot">
        <label class="inline"><input type="checkbox" class="cmp" data-cmp="${b.id}" ${store.compare.includes(b.id) ? "checked" : ""}> ${esc(tr("compare"))}</label>
        <a class="btn sm ghost" href="#/bird/${b.id}">${esc(tr("open"))}</a>
      </div>
    </div></article>`;
}
async function hydrateCards(root) {
  if (!root) return;
  const ids = uniq($$("[data-id]", root).map(n => n.dataset.id));
  for (const id of ids) {
    const b = byId(id), box = root.querySelector('.spec[data-id="' + id + '"] .thumb');
    if (b && box) loadPhoto(box, b);
  }
}

/* ------------------------------------------------------------------- HOME */
function viewHome() {
  document.title = "Birds World — " + tr("nav_home");
  const b = birdOfDay(), g = GROUPS[b.g], due = SRS.count();
  app.innerHTML = `
  <section class="hero">
    <h1>${esc(tr("home_title"))}</h1><p>${esc(tr("home_sub"))}</p>
    <div class="row">
      <a class="btn" href="#/birds">${esc(tr("nav_birds"))} →</a>
      <a class="btn ghost" href="#/find">✨ ${esc(tr("wiz_h"))}</a>
      <a class="btn ghost" href="#/sightings">🗺️ ${esc(tr("nav_sightings"))}</a>
      <span class="spacer"></span>
      ${due ? `<a class="btn sm ghost" href="#/learn">🎓 ${esc(tr("srs_h"))} (${due})</a>` : ""}
    </div>
  </section>

  ${statCards()}

  <section class="panel">
    <h2>${esc(tr("caps_h"))}</h2>
    <div class="grid">
      ${[["#/atlas", "🌍", "feat_atlas", "feat_atlas_d"], ["#/identify", "🎙️", "feat_id", "feat_id_d"],
         ["#/ai", "🤖", "feat_ai", "feat_ai_d"]]
        .map(([href, e, t, d]) => `<div class="feat"><span style="font-size:1.7rem">${e}</span>
          <div><b>${esc(tr(t))}</b><p>${esc(tr(d))}</p><a href="${href}">${esc(tr("open"))} →</a></div></div>`).join("")}
    </div>
  </section>

  <section class="panel">
    <div class="row" style="align-items:flex-start">
      <div class="thumb" style="width:150px;aspect-ratio:4/3;border-radius:var(--r);overflow:hidden;position:relative;background:var(--surface-2);display:grid;place-items:center;font-size:3rem" id="dod">
        <div class="ph">${g.e}</div><img alt="${esc(speciesName(b))}"></div>
      <div style="flex:1;min-width:200px">
        <h2>🌟 ${esc(tr("bird_of_day"))}</h2>
        <h3 style="margin-bottom:2px"><a href="#/bird/${b.id}">${esc(speciesName(b))}</a></h3>
        <p class="hint"><i>${esc(b.sci)}</i> · ${esc(b.origin)}</p>
        <p id="dodText" class="hint">…</p>
        <div class="row"><a class="btn sm" href="#/bird/${b.id}">${esc(tr("open"))}</a>
          <button class="btn sm ghost" data-fav="${b.id}" aria-pressed="${isFav(b.id)}">${isFav(b.id) ? "♥" : "♡"} ${esc(tr("stat_fav"))}</button>
          <button class="btn sm ghost" data-audition="${b.id}">🔊 ${esc(tr("synth"))}</button></div>
      </div>
    </div>
  </section>

  <section class="panel">
    <h2>${esc(tr("nav_birds"))}</h2>
    <div class="chips row" id="gchips">
      ${[["all", tr("g_all")], ["fav", tr("g_fav")]].map(([k, l]) => `<button class="chip" aria-pressed="${filters.g === k}" data-g="${k}">${esc(l)}</button>`).join("")}
      ${Object.entries(GROUPS).map(([k, v]) => `<button class="chip" aria-pressed="${filters.g === k}" data-g="${k}">${v.e} ${esc(I18N.lang === "ar" && v.ar ? v.ar : v.en)}</button>`).join("")}
    </div>
    <div class="grid" id="grid" style="margin-top:var(--s-3)"></div>
  </section>`;
  const drawHome = () => {
    const items = searchSpecies("", filters).slice(0, 12);
    $("#grid").innerHTML = items.map(cardHTML).join("");
    hydrateCards($("#grid"));
    $$("#gchips .chip").forEach(c => c.setAttribute("aria-pressed", String(filters.g === c.dataset.g)));
  };
  on($("#gchips"), "click", ".chip", (e, c) => { filters.g = c.dataset.g; drawHome(); });
  $("#dodText").textContent = "";
  wikiSummary(b.wiki).then(w => { if (w && w.text) $("#dodText").textContent = w.text.slice(0, 220) + (w.text.length > 220 ? "…" : ""); });
  loadPhoto($("#dod"), b);
  /* atlas rows live in IndexedDB, so the stat lands one tick after the first paint */
  Atlas.load().then(rows => { const el = $("#stAtlas b"); if (el) el.textContent = rows.length; });
  drawHome();
  wireCatalogueClicks(app);
}

/* ----------------------------------------------------------------- BROWSE */
/* One list, two sources. The care guide holds the species with measured
   husbandry traits; the atlas holds every world species imported on this
   device — names, classification, photos and recordings, but no care numbers.
   Atlas cards say that plainly instead of showing invented pills, and they page
   so thousands of rows never hit the DOM at once. */
const ATLAS_PAGE = 60;

function atlasFiltered(f) {
  const q = (f.q || "").trim();
  let rows = q ? Atlas.match(q, Atlas.rows.length) : Atlas.rows.slice();
  if (f.ord && f.ord !== "all") rows = rows.filter(r => r.order === f.ord);
  if (f.aImg) rows = rows.filter(r => !!r.img);
  if (f.aAr) rows = rows.filter(r => !!r.ar);
  if (!q) {
    const key = r => String(speciesName(r) || r.sci).toLowerCase();
    rows = rows.map(r => [key(r), r]).sort((a, b) => (a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : 0)).map(x => x[1]);
  }
  return rows;
}

function atlasCardHTML(r) {
  const u = "#/atlas/" + encodeURIComponent(r.sci), nm = speciesName(r) || r.sci;
  return `<article class="card spec">
    <a class="thumb" href="${u}" aria-label="${esc(nm)}">
      <div class="ph">🌍</div><img alt="${esc(nm)}" loading="lazy" decoding="async"${r.img
        ? ` src="${esc(r.img)}" onload="this.classList.add('loaded')" onerror="this.hidden=true"` : ""}>
    </a>
    <div class="body">
      <h3><a href="${u}">${esc(nm)}</a></h3>
      <div class="sci">${esc(r.sci)}</div>
      <div class="meta"><span class="pill">🧬 ${esc(r.family || "—")}</span>${r.order ? `<span class="pill">${esc(r.order)}</span>` : ""}${r.ar ? '<span class="pill">🗣</span>' : ""}</div>
      <div class="foot"><span class="hint">${esc(tr("atlas_no_care"))}</span>
        <span class="row"><button class="btn sm ghost" data-asight="${esc(r.sci)}" aria-label="${esc(tr("atlas_promote"))}">📍</button>
        <a class="btn sm ghost" href="${u}">${esc(tr("open"))}</a></span></div>
    </div></article>`;
}

function viewBrowse() {
  document.title = tr("nav_birds") + " — Birds World";
  const f = filters, q = f.q || "";
  app.innerHTML = `
  <section class="panel">
    <h2>${esc(tr("nav_birds"))} <span class="hint" style="display:inline" id="srcCount">(${SPECIES.length})</span></h2>
    <div class="row" id="srcRow"></div>
    <div class="row" style="margin:var(--s-3) 0">
      <input id="q" type="search" placeholder="${esc(tr("search_ph"))}" value="${esc(q)}" aria-label="${esc(tr("search"))}">
      <button class="btn ghost" id="voice" aria-label="Voice">🎙️</button>
      <button class="btn ghost" id="reset">${esc(tr("clear"))}</button>
    </div>
    <details class="panel" style="box-shadow:none" ${f.open ? "open" : ""} id="fpanel">
      <summary style="font-weight:700;cursor:pointer">${esc(tr("filters"))}</summary>
      <div class="filters" id="careFilters" style="margin-top:var(--s-3)">
        <div><label>${esc(tr("group"))}</label><select id="f-g">
          <option value="all">${esc(tr("g_all"))}</option><option value="fav">${esc(tr("g_fav"))}</option>
          ${Object.entries(GROUPS).map(([k, v]) => `<option value="${k}"${f.g === k ? " selected" : ""}>${v.e} ${esc(v.en)}</option>`).join("")}</select></div>
        <div><label>${esc(tr("sort"))}</label><select id="f-sort">
          ${[["name", "Name"], ["small", "Smallest first"], ["big", "Largest first"], ["long", "Longest lived"], ["easy", "Easiest care"], ["quiet", "Quietest"], ["social", "Most social"]]
            .map(([k, l]) => `<option value="${k}"${f.sort === k ? " selected" : ""}>${l}</option>`).join("")}</select></div>
        <div><label>📏 ${esc(tr("size"))} (cm)</label><div class="rng"><input type="range" id="f-size" min="0" max="300" step="5" value="${f.size[1]}"><output id="o-size">–</output></div></div>
        <div><label>⏳ ${esc(tr("life"))} (yr)</label><div class="rng"><input type="range" id="f-life" min="0" max="80" step="1" value="${f.life[1]}"><output id="o-life">–</output></div></div>
        <div><label>🔊 ${esc(traitLabel("noise"))}</label><div class="rng"><input type="range" id="f-noise" min="1" max="5" value="${f.noise[1]}"><output id="o-noise">≤5</output></div></div>
        <div><label>🎯 ${esc(traitLabel("difficulty"))}</label><div class="rng"><input type="range" id="f-diff" min="1" max="5" value="${f.difficulty[1]}"><output id="o-diff">≤5</output></div></div>
        <div><label>💰 ${esc(traitLabel("cost"))}</label><div class="rng"><input type="range" id="f-cost" min="1" max="5" value="${f.cost[1]}"><output id="o-cost">≤5</output></div></div>
      </div>
      <div class="filters" id="atlasFilters" style="margin-top:var(--s-3)" hidden>
        <div><label>🧬 ${esc(tr("atlas_ord"))}</label><select id="f-ord"></select></div>
        <label class="inline"><input type="checkbox" id="f-aimg" ${f.aImg ? "checked" : ""}> ${esc(tr("atlas_only_img"))}</label>
        <label class="inline"><input type="checkbox" id="f-aar" ${f.aAr ? "checked" : ""}> ${esc(tr("atlas_only_ar"))}</label>
      </div>
      <div class="row" style="margin-top:var(--s-3)" id="savedRow">
        <button class="btn sm ghost" id="saveSearch">＋ ${esc(tr("save_search"))}</button>
        <div id="savedList" class="row"></div>
      </div>
    </details>
  </section>
  <div class="row"><span class="hint" id="count"></span></div>
  <div class="grid" id="grid"></div>
  <div class="row" id="pager"></div>
  <div id="atPool"></div>`;

  const isAtlas = () => f.src === "atlas" && Atlas.rows.length > 0;

  const drawSrc = () => {
    const nA = Atlas.rows.length;
    $("#srcRow").innerHTML =
      `<button class="btn sm${f.src === "guide" ? "" : " ghost"}" data-src="guide">🪶 ${esc(tr("src_guide"))} · ${SPECIES.length}</button>` +
      `<button class="btn sm${f.src === "atlas" ? "" : " ghost"}" data-src="atlas"${nA ? "" : " disabled"}>🌍 ${esc(tr("src_atlas"))} · ${nA}</button>` +
      (nA ? `<span class="hint">${esc(tr("atlas_pick_src"))}</span>`
        : `<span class="hint">${esc(tr("atlas_none"))} <a href="#/atlas">${esc(tr("atlas_h"))} →</a></span>`);
    if (!nA) return;
    const byOrder = new Map();
    for (const r of Atlas.rows) if (r.order) byOrder.set(r.order, (byOrder.get(r.order) || 0) + 1);
    $("#f-ord").innerHTML = `<option value="all">${esc(tr("atlas_all_orders"))} (${Atlas.rows.length})</option>` +
      [...byOrder.entries()].sort((a, b) => b[1] - a[1]).map(([o, n]) =>
        `<option value="${esc(o)}"${f.ord === o ? " selected" : ""}>${esc(o)} (${n})</option>`).join("");
  };

  const drawAtlas = () => {
    const rows = atlasFiltered(f);
    const pages = Math.max(1, Math.ceil(rows.length / ATLAS_PAGE));
    f.page = clamp(f.page, 0, pages - 1);
    const at = f.page * ATLAS_PAGE;
    const cut = rows.slice(at, at + ATLAS_PAGE);
    $("#grid").innerHTML = cut.length ? cut.map(atlasCardHTML).join("")
      : `<div class="empty" style="grid-column:1/-1"><b>🌍</b>${esc(tr("no_results"))}<br><span class="hint">${esc(tr("try_wide"))}</span></div>`;
    $("#count").textContent = rows.length + " / " + Atlas.rows.length + (f.q.trim() ? " · " + tr("atlas_found") : "");
    $("#atPool").innerHTML = "";
    $("#pager").innerHTML = pages > 1
      ? `<button class="btn sm ghost" data-p="-1"${f.page ? "" : " disabled"}>← ${esc(tr("pg_prev"))}</button>` +
        `<span class="hint">${esc(tr("atlas_page"))} ${f.page + 1} / ${pages}</span>` +
        `<button class="btn sm ghost" data-p="1"${f.page >= pages - 1 ? " disabled" : ""}>${esc(tr("pg_next"))} →</button>`
      : "";
  };

  const draw = () => {
    f.q = $("#q").value;
    $("#careFilters").hidden = isAtlas();
    $("#atlasFilters").hidden = !isAtlas();
    $("#savedRow").hidden = isAtlas();
    $("#srcCount").textContent = "(" + (isAtlas() ? Atlas.rows.length : SPECIES.length) + ")";
    if (isAtlas()) return drawAtlas();
    const items = searchSpecies(f.q, f);
    $("#grid").innerHTML = items.length ? items.map(cardHTML).join("")
      : `<div class="empty" style="grid-column:1/-1"><b>🪶</b>${esc(tr("no_results"))}<br><span class="hint">${esc(tr("try_wide"))}</span></div>`;
    $("#count").textContent = items.length + " / " + SPECIES.length;
    $("#pager").innerHTML = "";
    /* guide mode still offers atlas hits, but in their own panel: they have no
       care traits to rank or display, and mixing them into the grid would
       imply data we do not have */
    $("#atPool").innerHTML = (store.settings.includeAtlas && f.q.trim() && Atlas.rows.length)
      ? atlasList(Atlas.match(f.q.trim(), 24), tr("atlas_include")) : "";
    hydrateCards($("#grid"));
    $("#o-size").textContent = f.size[1] + " cm"; $("#o-life").textContent = f.life[1] + " yr";
    $("#o-noise").textContent = "≤" + f.noise[1]; $("#o-diff").textContent = "≤" + f.difficulty[1]; $("#o-cost").textContent = "≤" + f.cost[1];
  };
  const drawSaved = () => {
    $("#savedList").innerHTML = store.saved.all().map(s =>
      `<button class="chip" data-load="${s.id}">${esc(s.name)}</button>`).join("");
  };
  $("#q").addEventListener("input", debounce(() => { filters.page = 0; draw(); }, 140));
  ["f-g", "f-sort"].forEach(id => $("#" + id).addEventListener("change", e => {
    filters[id === "f-g" ? "g" : "sort"] = e.target.value; draw();
  }));
  const rng = (id, key, max) => $("#" + id).addEventListener("input", e => { filters[key] = [filters[key][0], +e.target.value]; draw(); });
  rng("f-size", "size"); rng("f-life", "life"); rng("f-noise", "noise"); rng("f-diff", "difficulty"); rng("f-cost", "cost");
  $("#f-ord").addEventListener("change", e => { filters.ord = e.target.value; filters.page = 0; draw(); });
  $("#f-aimg").addEventListener("change", e => { filters.aImg = e.target.checked; filters.page = 0; draw(); });
  $("#f-aar").addEventListener("change", e => { filters.aAr = e.target.checked; filters.page = 0; draw(); });
  $("#fpanel").addEventListener("toggle", e => { filters.open = e.target.open; });
  $("#reset").onclick = () => {
    const keep = { g: filters.g, src: filters.src };
    filters = Object.assign(FILTER_DEFAULT(), keep); viewBrowse();
  };
  $("#saveSearch").onclick = () => {
    const name = window.prompt(tr("save_search"), filters.q || tr("g_all"));
    if (!name) return;
    store.saved.add({ name, state: JSON.parse(JSON.stringify(filters)) }); drawSaved(); toast(tr("note_saved"), "ok");
  };
  on($("#savedList"), "click", "[data-load]", (e, n) => {
    const s = store.saved.get(n.dataset.load); if (!s) return;
    filters = Object.assign(FILTER_DEFAULT(), s.state); viewBrowse();
  });
  on($("#srcRow"), "click", "[data-src]", (e, n) => {
    if (n.dataset.src === "atlas" && !Atlas.rows.length) return;
    filters.src = n.dataset.src; filters.page = 0; draw();
  });
  on($("#pager"), "click", "[data-p]", (e, n) => {
    filters.page += +n.dataset.p; drawAtlas();
    $("#grid").scrollIntoView({ block: "start", behavior: "smooth" });
  });
  $("#voice").onclick = () => startVoice(t => { $("#q").value = t; filters.page = 0; draw(); });
  drawSrc(); draw(); drawSaved(); wireCatalogueClicks(app);
  Atlas.load().then(rows => {
    if (!rows.length || !location.hash.startsWith("#/birds")) return;
    drawSrc();
    if (filters.src === "atlas") drawAtlas();
    else if (store.settings.includeAtlas) draw();
  });
}
function startVoice(apply) {
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR) { toast(tr("voice_no"), "warn"); return; }
  const rec = new SR();
  rec.lang = I18N.lang === "ar" ? "ar-SA" : "en-US"; rec.interimResults = false;
  rec.onresult = e => apply(e.results[0][0].transcript);
  rec.onerror = () => toast(tr("voice_fail"), "error");
  try { rec.start(); toast(tr("voice_listen"), "info", 1400); } catch { /* already running */ }
}

/* --------------------------------------------------------- reading answers ---
   Voice input above is the keeper's side; this is the guide speaking back. The
   browser picks the Arabic voice when it has one, and an answer is flattened to
   text through DOMParser so markup never reaches the throat. Voices load
   asynchronously in Chrome, so an empty list is retried once after they arrive. */
let speakWant = null;
function htmlToText(html) {
  try { return new DOMParser().parseFromString(String(html || ""), "text/html").body.textContent.trim(); }
  catch { return String(html || "").replace(/<[^>]+>/g, " "); }
}
function speechVoices() { return window.speechSynthesis ? window.speechSynthesis.getVoices() : []; }
function pickVoice() {
  const vs = speechVoices();
  if (!vs.length) return null;
  const want = I18N.lang === "ar" ? /^ar\b|^ara/i : /^en/i;
  return vs.find(v => want.test(String(v.lang || ""))) || null;
}
function speak(text) {
  const S = window.speechSynthesis;
  if (!S) { toast(tr("ai_speak_no"), "warn"); return false; }
  const clean = String(text || "").replace(/\s+/g, " ").trim().slice(0, 1400);
  if (!clean) return false;
  S.cancel();
  const utter = () => {
    const u = new SpeechSynthesisUtterance(clean);
    const v = pickVoice();
    if (v) u.voice = v;
    u.lang = I18N.lang === "ar" ? (v ? v.lang : "ar-SA") : (v ? v.lang : "en-GB");
    u.rate = clamp(num(store.settings.speakRate, 1), 0.6, 1.6);
    u.onend = u.onerror = () => { speakWant = null; };
    S.speak(u);
  };
  if (speechVoices().length) utter();
  else {
    speakWant = utter;
    /* Chrome reports an empty voice list until the engine finishes loading:
       speak on that event, or on a short timer, whichever comes first */
    S.onvoiceschanged = () => { if (speakWant) { const f = speakWant; speakWant = null; f(); } };
    setTimeout(() => { if (speakWant) { const f = speakWant; speakWant = null; f(); } }, 600);
  }
  return true;
}
function stopSpeak() { if (window.speechSynthesis) { window.speechSynthesis.cancel(); speakWant = null; } }

function wireCatalogueClicks(root) {
  on(root, "click", "[data-asight]", (e, n) => logSighting(Atlas.get(n.dataset.asight) || { sci: n.dataset.asight }));
  on(root, "click", "[data-fav]", (e, n) => {
    e.preventDefault();
    const on = toggleFav(n.dataset.fav);
    $$('[data-fav="' + n.dataset.fav + '"]').forEach(x => { x.setAttribute("aria-pressed", String(on)); if (x.classList.contains("star")) x.textContent = on ? "♥" : "♡"; });
    if (filters.g === "fav" || location.hash === "#/") (location.hash === "#/" ? viewHome : viewBrowse)();
  });
  on(root, "change", "[data-cmp]", (e, n) => {
    const id = n.dataset.cmp;
    if (store.compare.includes(id)) store.compare = store.compare.filter(x => x !== id);
    else if (store.compare.length >= CFG.MAX_COMPARE) { n.checked = false; toast(tr("compare_hint"), "warn"); return; }
    else store.compare.push(id);
    setCompN();
  });
  on(root, "click", "[data-zoom]", (e, n) => {
    const img = n.querySelector("img");
    if (img && img.naturalWidth) { e.preventDefault(); openLightbox(img.src, speciesName(byId(n.dataset.zoom))); }
  });
  if (!root._audWired) {
    root._audWired = true;
    on(root, "click", "[data-audition]", async (e, n) => {
      const b = byId(n.dataset.audition); if (!b) return;
      /* the list button plays a real voice when the session already found one
         for this species, and the synthesized pitch only as the fallback */
      const known = Song.mem.get(slug(b.sci)) || [];
      if (known.length) {
        if (!auditionAudio) auditionAudio = new Audio();
        if (await Song.play(known[0], auditionAudio, null, null)) return;
      }
      playChirp(GROUPS[b.g].synthPitch);
    });
  }
}
let auditionAudio = null;

/* --------------------------------------------------------------- COMPARE */
function openCompare() {
  if (!store.compare.length) { toast(tr("compare_hint"), "warn"); return; }
  const rows = [["Scientific name", b => "<i>" + esc(b.sci) + "</i>"], ["Origin", b => esc(b.origin)],
    ["Size", b => esc(b.size)], ["Lifespan", b => esc(b.life)],
    ["Family", b => GROUPS[b.g].e + " " + esc(GROUPS[b.g].en)], ["Diet", b => esc(b.tip)],
    ["Care difficulty", b => rateBar(b.difficulty)], ["Noise", b => rateBar(b.noise)],
    ["Space", b => rateBar(b.space)], ["Cost", b => rateBar(b.cost)], ["Social", b => rateBar(b.sociability)]];
  const birds = store.compare.map(byId).filter(Boolean);
  openDlg(tr("compare") + " — " + birds.length, `
    <div class="table-wrap"><table><thead><tr><th>${esc(tr("traits"))}</th>
      ${birds.map(b => `<th>${esc(speciesName(b))}</th>`).join("")}</tr></thead>
      <tbody>${rows.map(([l, f]) => `<tr><th>${esc(l)}</th>${birds.map(b => `<td>${f(b)}</td>`).join("")}</tr>`).join("")}</tbody>
    </table></div>
    <h3 style="margin-top:var(--s-4)">${esc(tr("radar"))}</h3>
    <canvas id="radarCv" style="width:100%"></canvas>
    <div class="legend">${birds.map((b, i) => `<span><i style="background:${["var(--ac)", "#f59e0b", "#6366f1"][i]}"></i>${esc(speciesName(b))}</span>`).join("")}</div>`);
  requestAnimationFrame(() => drawRadar($("#radarCv"), birds.map(b => [b.difficulty, b.noise, b.space, b.cost, b.sociability, clamp(b.longevity / 16, 1, 5)]),
    ["Care", "Noise", "Space", "Cost", "Social", "Years"]));
}

/* ----------------------------------------------------------------- DETAIL */
function viewDetail(id) {
  const b = byId(id);
  if (!b) { app.innerHTML = `<div class="panel empty"><b>🤷</b>${esc(tr("not_found"))}<br><a href="#/birds">${esc(tr("back"))}</a></div>`; return; }
  document.title = speciesName(b) + " — Birds World";
  markVisited(id);
  const g = GROUPS[b.g], base = g.foodWeight, inc = g.incDays, today = dayKey();

  app.innerHTML = `
  <div class="row"><a class="btn ghost sm" href="#/birds">← ${esc(tr("back"))}</a>
    <button class="btn ghost sm" data-fav="${b.id}" aria-pressed="${isFav(b.id)}">${isFav(b.id) ? "♥" : "♡"} ${esc(tr("stat_fav"))}</button>
    <label class="inline"><input type="checkbox" class="cmp" data-cmp="${b.id}" ${store.compare.includes(b.id) ? "checked" : ""}> ${esc(tr("compare"))}</label>
  </div>
  <section class="panel">
    <div class="row" style="align-items:flex-start;gap:var(--s-4)">
      <div style="flex:1;min-width:260px">
        <h1>${esc(speciesName(b))}</h1>
        <p class="hint"><i>${esc(b.sci)}</i> · ${g.e} ${esc(I18N.lang === "ar" && g.ar ? g.ar : g.en)}</p>
        <div class="kb" style="margin-top:var(--s-3)">
          <div class="kv"><span>${esc(tr("origin"))}</span>${esc(b.origin)}</div>
          <div class="kv"><span>${esc(tr("size"))}</span>${esc(b.size)}</div>
          <div class="kv"><span>${esc(tr("life"))}</span>${esc(b.life)}</div>
          <div class="kv"><span>${esc(tr("diet_tip"))}</span>${esc(b.tip)}</div>
        </div>
        <div class="row" style="margin-top:var(--s-3)">
          <button class="btn sm ghost" onclick="window.print()">🖨️ ${esc(tr("print"))}</button>
          <button class="btn sm ghost" id="share">🔗 ${esc(tr("share"))}</button>
          <button class="btn sm ghost" id="logSighting">📍 ${esc(tr("add_sighting"))}</button>
          <button class="btn sm ghost" id="readAloud">🔊 ${esc(tr("ai_speak"))}</button>
          <button class="btn sm" id="addBird">🪺 ${esc(tr("add_bird"))}</button>
        </div>
      </div>
      <div style="width:min(360px,100%)">
        <div class="thumb" id="hero" data-zoom="${b.id}" style="aspect-ratio:4/3;border-radius:var(--r);overflow:hidden;position:relative;background:var(--surface-2);display:grid;place-items:center;font-size:3.4rem;cursor:zoom-in">
          <div class="ph">${g.e}</div><img alt="${esc(speciesName(b))}"></div>
        <p class="hint" id="credit">${esc(tr("search_rec"))}</p>
        <canvas id="traitRadar" style="width:100%;margin-top:var(--s-2)"></canvas>
      </div>
    </div>
  </section>

  <div class="tabs" role="tablist" id="tabs">
    ${[["ov", "t_overview"], ["di", "t_feeding"], ["au", "t_sounds"], ["br", "t_breeding"], ["ca", "t_care"], ["dz", "t_health"], ["nt", "t_notes"]]
      .map(([k, l], i) => `<button role="tab" id="tb-${k}" aria-controls="p-${k}" aria-selected="${i === 0}" data-t="${k}">${esc(tr(l))}</button>`).join("")}
  </div>
  ${[
    ["ov", `<div class="panel"><h2>${esc(tr("t_overview"))}</h2><p id="about">…</p><p class="hint" id="wlink"></p></div>`],
    ["di", `<div class="panel"><h2>${esc(tr("calc_h"))}</h2><ul>${gList(b.g,"diet").map(d => `<li>${esc(d)}</li>`).join("")}</ul>
      <div class="filters" style="margin-top:var(--s-3)">
        <div><label for="cnt">${esc(tr("birds_count"))}</label><input type="number" id="cnt" min="1" max="5000" value="1"></div>
        <div><label for="body">${esc(tr("body_g"))} (g)</label><input type="number" id="body" min="1" value="${base * 6}"></div>
        <div><label>${esc(tr("dry"))}</label><div class="kv"><b id="rDry">–</b> g/day</div></div>
        <div><label>${esc(tr("greens"))}</label><div class="kv"><b id="rGreen">–</b> g/day</div></div>
        <div><label>${esc(tr("water"))}</label><div class="kv"><b id="rWater">–</b> ml/day</div></div>
        <div><label>7 ${esc(tr("day_of"))}</label><div class="kv"><b id="rWeek">–</b> g dry food</div></div>
      </div><p class="hint">${esc(tr("feed_rule"))}</p></div>`],
    ["au", `<div class="panel"><h2>${esc(tr("t_sounds"))}</h2>
      <div class="row"><button class="btn sm" id="synth">🔊 ${esc(tr("synth"))}</button>
        <button class="btn sm ghost" id="loadRec">🎧 ${esc(tr("real"))}</button>
        <a class="btn sm ghost" target="_blank" rel="noopener noreferrer" href="https://www.youtube.com/results?search_query=${encodeURIComponent(b.en + " bird song")}">${esc(tr("more_sounds"))} ↗</a></div>
      <div id="recList" style="margin-top:var(--s-3)"></div>
      <div class="wavebox" style="margin-top:var(--s-3)">
        <audio id="player" controls crossorigin="anonymous" preload="none" style="width:100%"></audio>
        <div class="row"><label class="inline" style="margin:0">${esc(tr("rate"))}</label>
          <input type="range" id="rate" min="0.5" max="1.5" step="0.05" value="1" style="max-width:200px"><output id="rateO">1.00×</output></div>
        <canvas id="wave" style="width:100%"></canvas><canvas id="spec" style="width:100%"></canvas>
      </div></div>`],
    ["br", `<div class="panel"><h2>${esc(tr("breed_h"))}</h2>
      <div class="filters">
        <div><label for="incStart">${esc(tr("inc_start"))}</label><input type="date" id="incStart" value="${today}"></div>
        <div><label for="clutch">${esc(tr("birds_count"))} (${esc(tr("inc_days"))})</label><input type="number" id="clutch" min="1" max="12" value="4"></div>
        <div><label>${esc(tr("hatch"))}</label><div class="kv"><b id="rHatch">–</b></div></div>
        <div><label>${esc(tr("day_of"))}</label><div class="kv"><b id="rDay">–</b> / ${inc}</div></div>
      </div>
      <progress id="incBar" max="${inc}" value="0" style="margin-top:var(--s-3)"></progress>
      <div class="kb" style="margin-top:var(--s-3)" id="stages"></div></div>`],
    ["ca", `<div class="panel"><h2>${esc(tr("t_care"))}</h2><ul>${gList(b.g,"care").map(c => `<li>${esc(c)}</li>`).join("")}</ul></div>`],
    ["dz", `<div class="panel"><h2>${esc(tr("t_health"))}</h2>
      <div class="banner danger">${esc(tr("disclaimer"))}</div>
      ${g.dis.map(x => disText(x)).map(d => `<div class="banner" style="margin-top:var(--s-2)"><b>${esc(d[0])}</b><br>${esc(d[1])}<br><span class="hint">${esc(tr("treat"))}: ${esc(d[2])}</span></div>`).join("")}</div>`],
    ["nt", `<div class="panel"><h2>${esc(tr("notes_h"))}</h2>
      <textarea id="note" placeholder="${esc(tr("notes_h"))}">${esc(noteOf(id))}</textarea>
      <div class="row" style="margin-top:var(--s-2)"><button class="btn sm" id="saveNote">${esc(tr("save"))}</button><span class="hint" id="noteState"></span></div></div>`],
  ].map(([k, html], i) => `<div class="panel-host" role="tabpanel" id="p-${k}" aria-labelledby="tb-${k}"${i ? ' hidden' : ""}>${html}</div>`).join("")}`;

  /* tabs */
  $("#tabs").addEventListener("click", e => {
    const t = e.target.closest("[data-t]"); if (!t) return;
    $$("#tabs [data-t]").forEach(x => x.setAttribute("aria-selected", String(x === t)));
    $$("[id^='p-']").forEach(x => { x.hidden = x.id !== "p-" + t.dataset.t; });
  });

  /* media + credit */
  loadPhoto($("#hero"), b, 1200);
  $("#hero").addEventListener("click", () => { const i = $("#hero img"); if (i && i.naturalWidth) openLightbox(i.src, speciesName(b) + " · " + b.sci); });
  wikiSummary(b.wiki).then(w => {
    if (!w) { $("#about").textContent = tr("remote_fail"); return; }
    $("#about").textContent = w.text || tr("no_data");
    $("#wlink").innerHTML = 'Wikipedia: <a target="_blank" rel="noopener noreferrer" href="' + esc(w.page) + '">' + esc(w.page.replace(/^https?:\/\//, "")) + "</a>";
    imageCredit(b.img || b._wikiImg || w.img).then(c => {
      if (!c) { $("#credit").innerHTML = '<a target="_blank" rel="noopener noreferrer" href="' + esc(w.page) + '">Wikipedia / Wikimedia</a>'; return; }
      $("#credit").innerHTML = "📷 " + esc(c.artist || "—") + (c.license ? " · " + esc(c.license) : "") +
        ' · <a target="_blank" rel="noopener noreferrer" href="https://commons.wikimedia.org/wiki/File:' +
        encodeURIComponent(c.file) + '">Wikimedia Commons</a>';
    }).catch(() => null);
  }).catch(() => { $("#about").textContent = tr("offline"); });

  requestAnimationFrame(() => drawRadar($("#traitRadar"), [[b.difficulty, b.noise, b.space, b.cost, b.sociability, clamp(b.longevity / 16, 1, 5)]],
    ["Care", "Noise", "Space", "Cost", "Social", "Years"]));

  /* feeding calc */
  const calc = () => {
    const n = clamp(parseInt($("#cnt").value, 10) || 1, 1, 5000);
    const body = clamp(parseInt($("#body").value, 10) || base * 6, 1, 20000);
    const dry = round(n * Math.max(2, body * 0.12), 1), green = round(dry * 0.4, 1), water = n * Math.round(body * 0.25);
    $("#rDry").textContent = dry; $("#rGreen").textContent = green; $("#rWater").textContent = water; $("#rWeek").textContent = round(dry * 7, 0);
  };
  ["cnt", "body"].forEach(i => $("#" + i).addEventListener("input", debounce(calc, 120))); calc();

  /* breeding tracker */
  const breed = () => {
    const start = $("#incStart").value; if (!start) return;
    const hatch = addDays(start, inc), day = daysBetween(start, today);
    $("#rHatch").textContent = fmtDate(hatch.toISOString());
    $("#rDay").textContent = day < 0 ? "—" : Math.min(day, inc);
    $("#incBar").value = clamp(day, 0, inc);
    const marks = [[0, "Egg set", "البيضة"], [Math.round(inc / 3), "Turning established", "قلب البيض"],
      [Math.round(inc * 2 / 3), "Pipping window", "اقتراب الفقس"], [inc, "Hatch", "الفقس"], [inc + 21, "Fledging (typical)", "الترييش"], [inc + 45, "Weaning checkpoint", "الفطام"]];
    $("#stages").innerHTML = marks.map(([d, en, ar]) => {
      const date = addDays(start, d), state = day < d ? "⏳" : "✅";
      return `<div class="kv"><span>${state} ${esc(I18N.lang === "ar" ? ar : en)}</span>${fmtDate(date.toISOString())} · day ${d}</div>`;
    }).join("");
    const n = clamp(parseInt($("#clutch").value, 10) || 1, 1, 12);
    $("#stages").insertAdjacentHTML("beforeend", `<div class="kv"><span>${esc(tr("birds_count"))}</span>${n} eggs → ≈${Math.round(n * 0.7 * 10) / 10} fledged (typical 70 %)</div>`);
  };
  $("#incStart").addEventListener("change", breed); $("#clutch").addEventListener("input", debounce(breed, 120)); breed();

  /* sounds */
  $("#synth").onclick = () => playChirp(g.synthPitch);
  const player = $("#player");
  $("#rate").addEventListener("input", e => { player.playbackRate = +e.target.value; $("#rateO").textContent = (+e.target.value).toFixed(2) + "×"; });
  const renderSongs = async keepMem => {
    $("#recList").innerHTML = `<p class="hint">${esc(tr("song_searching"))}</p>`;
    if (!keepMem) Song.forget(b.sci);
    let items = [];
    try { items = await Song.for(b); } catch { items = []; }
    const links = `<a target="_blank" rel="noopener noreferrer" href="${esc(CFG.API.xenoSite + "?q=" + encodeURIComponent(b.sci))}">xeno-canto ↗</a> ·
      <a target="_blank" rel="noopener noreferrer" href="${esc(CFG.API.inatSite + "/observations?q=" + encodeURIComponent(b.sci) + "&sound=type%3Acall")}" dir=ltr>iNaturalist ↗</a>`;
    if (!items.length) {
      $("#recList").innerHTML = `<div class="banner warn">🎧 ${esc(tr("song_none"))}<br>${links}</div>
        <p class="hint">${esc(tr("song_from"))}: ${esc(Song.enabled().join(" · "))}</p>`;
      return;
    }
    $("#recList").innerHTML = `<div class="row"><span class="chip">🎧 ${esc(tr("song_found", { n: items.length }))}</span>
        <span class="spacer"></span><button class="btn sm ghost" id="recAgain">↻</button></div>` +
      songMarkup(items) +
      `<div class="row" style="margin-top:var(--s-2)">
        <button class="btn sm" id="recLib">🧬 ${esc(tr("song_lib"))}</button>
        <button class="btn sm ghost" id="recSynth">🔊 ${esc(tr("synth"))}</button>
        <span class="spacer"></span>${links}</div>`;
    wireSongs($("#recList"), items, player, $("#wave"), $("#spec"), () => renderSongs(true));
    $("#player").addEventListener("play", () => { player.playbackRate = +$("#rate").value; });
    $("#recAgain").onclick = () => renderSongs(false);
    $("#recSynth").onclick = () => playChirp(g.synthPitch);
    $("#recLib").onclick = async () => {
      $("#recLib").textContent = "…";
      let ok = null;
      try { ok = await Acoustic.addReference(b.sci); } catch { ok = null; }
      $("#recLib").textContent = "🧬 " + tr("song_lib");
      toast(ok ? tr("song_libbed") : tr("song_fail"), ok ? "ok" : "warn");
    };
  };
  $("#loadRec").onclick = renderSongs;
  player.addEventListener("pause", () => detachAnalyser());

  /* notes with autosave */
  const saveNote = silent => {
    store.notes[b.id] = $("#note").value; store.persist();
    $("#noteState").textContent = silent ? tr("note_saved") + " · " + new Date().toLocaleTimeString() : tr("note_saved");
    if (!silent) toast(tr("note_saved"), "ok", 1600);
  };
  $("#saveNote").onclick = () => saveNote(false);
  $("#note").addEventListener("input", debounce(() => saveNote(true), 900));

  /* actions */
  $("#addBird").onclick = () => openAddBird(b);
  $("#logSighting").onclick = () => logSighting(b);
  $("#readAloud").onclick = () => {
    const text = [speciesName(b), b.sci,
      tr("origin") + ": " + AI.locVal(b.origin),
      tr("size") + ": " + AI.locVal(b.size),
      tr("life") + ": " + AI.locVal(b.life),
      tr("diet_tip") + ": " + b.tip]
      .concat(gList(b.g, "diet").slice(0, 2).map(d => "• " + d)).filter(Boolean).join(". ");
    speak(text);
  };
  $("#share").onclick = async () => {
    const url = location.href, text = speciesName(b) + " (" + b.sci + ") — Birds World";
    if (navigator.share) { try { await navigator.share({ title: speciesName(b), text, url }); award(2); return; } catch { return; } }
    try { await navigator.clipboard.writeText(text + "\n" + url); toast(tr("copy"), "ok"); } catch { window.prompt(tr("copy"), url); }
  };
  wireCatalogueClicks(app);
  setCompN();
}

/* --------------------------------------------------------------- WIZARD */
let wiz = { step: 0, answers: {} };
function wizHint(w) {
  const bits = [];
  Object.entries(w).forEach(([k, v]) => {
    if (k === "g") bits.push(v.map(g => GROUPS[g].en).join("/"));
    else if (k === "talk") bits.push("talking");
    else bits.push(traitLabel(k) + " " + (Array.isArray(v) ? v[0] + "–" + v[1] : v));
  });
  return bits.join(" · ");
}
function viewWizard() {
  document.title = tr("wiz_h") + " — Birds World";
  const total = WIZ.length, at = wiz.step;
  if (at >= total) { renderWizResult(); return; }
  const Q = WIZ[at];
  const chosen = wiz.answers[Q.k];
  app.innerHTML = `<section class="panel">
    <div class="row"><h2 style="margin:0;flex:1">${esc(tr("wiz_h"))}</h2><span class="pill">${at + 1}/${total}</span></div>
    <progress value="${at}" max="${total}" style="margin-block:var(--s-3)"></progress>
    <p class="wiz-q">${esc(Q.q[I18N.lang] || Q.q.en)}</p>
    <div class="opts" id="opts">
      ${Q.o.map(([val, label, w]) => `<button class="opt" role="checkbox" aria-checked="${chosen === val}" data-val="${val}">
        ${esc(label[I18N.lang] || label.en)}<small>${esc(wizHint(w))}</small></button>`).join("")}
    </div>
    <div class="row" style="margin-top:var(--s-4)">
      <button class="btn ghost" id="back" ${at === 0 ? "disabled" : ""}>← ${esc(tr("wiz_back"))}</button>
      <span class="spacer"></span>
      <button class="btn" id="next" ${chosen ? "" : "disabled"}>${esc(at === total - 1 ? tr("wiz_result") : tr("wiz_next"))} →</button>
    </div></section>`;
  on($("#opts"), "click", ".opt", (e, n) => {
    wiz.answers[Q.k] = n.dataset.val;
    $$("#opts .opt").forEach(o => o.setAttribute("aria-checked", String(o === n)));
    $("#next").disabled = false;
  });
  $("#back").onclick = () => { wiz.step = Math.max(0, wiz.step - 1); viewWizard(); };
  $("#next").onclick = () => { wiz.step++; wiz.step >= total ? renderWizResult() : viewWizard(); };
}
function renderWizResult() {
  const picks = {};
  Object.entries(wiz.answers).forEach(([k, val]) => {
    const Q = WIZ.find(q => q.k === k); const o = Q && Q.o.find(x => x[0] === val);
    if (o) picks[k] = [{ w: o[2] }];
  });
  const top = recommend(picks).slice(0, CFG.MAX_CARDS * 2);
  app.innerHTML = `<section class="panel">
    <div class="row"><h2 style="margin:0;flex:1">✨ ${esc(tr("wiz_result"))}</h2>
      <button class="btn ghost sm" id="restart">↺ ${esc(tr("wiz_restart"))}</button></div>
    ${top.length ? `<div class="grid" id="grid">${top.map(r => cardHTML(r.b) +
      `<div class="hint" style="margin-top:-8px"><b>${r.score}</b> ${esc(tr("points"))} · ${r.why.map(w => esc(w)).join(" · ")}</div>`).join("")}</div>`
      : `<div class="empty"><b>🧭</b>${esc(tr("no_results"))}</div>`}
    <p class="hint" style="margin-top:var(--s-3)">${esc(tr("disclaimer"))}</p></section>`;
  hydrateCards($("#grid"));
  wireCatalogueClicks(app);
  $("#restart").onclick = () => { wiz = { step: 0, answers: {} }; viewWizard(); };
  if (top.length) award(4);
}

/* -------------------------------------------------------------- MY BIRDS */
function openAddBird(species) {
  openDlg(tr("add_h"), `<form id="birdForm" class="stack" style="gap:var(--s-3)">
    ${species ? `<input type="hidden" name="speciesId" value="${esc(species.id)}">` : ""}
    <div><label>${esc(tr("nick"))}</label><input name="nick" required maxlength="40" placeholder="${esc(species ? speciesName(species) : "Kiwi")}"></div>
    <div class="filters">
      <div><label>${esc(tr("group"))}</label><select name="speciesId" ${species ? "disabled" : ""}>
        ${species ? `<option value="${esc(species.id)}">${esc(speciesName(species))}</option>`
          : `<option value="">—</option>` + SPECIES.map(b => `<option value="${b.id}">${esc(b.en)}</option>`).join("")}</select></div>
      <div><label>${esc(tr("acquired"))}</label><input type="date" name="acquired" value="${dayKey()}"></div>
      <div><label>${esc(tr("sex"))}</label><select name="sex"><option value="">?</option><option>M</option><option>F</option></select></div>
      <div><label>${esc(tr("ring"))}</label><input name="ring" maxlength="24"></div>
    </div>
    <button class="btn" type="submit">${esc(tr("save"))}</button></form>`);
  $("#birdForm").addEventListener("submit", e => {
    e.preventDefault();
    const fd = Object.fromEntries(new FormData(e.target));
    if (!fd.speciesId) fd.speciesId = "";
    const rec = store.birds.add({ ...fd, createdAt: new Date().toISOString() });
    queueWrite("birds", "create", rec);
    closeDlg(); award(5); toast(tr("note_saved"), "ok");
    if (location.hash.startsWith("#/my-bird/")) route(); else viewBirds();
  });
}
function viewBirds() {
  document.title = tr("my_h") + " — Birds World";
  const rows = store.birds.all(), today = dayKey();
  const overdue = store.tasks.all().filter(t => !t.done && t.due && t.due < today);
  app.innerHTML = `<section class="panel">
    <div class="row"><h2 style="margin:0;flex:1">🪺 ${esc(tr("my_h"))}</h2>
      <button class="btn" id="add">＋ ${esc(tr("add_h"))}</button></div>
    ${statBlock([[rows.length, tr("stat_mine")],
      [uniq(rows.map(r => r.speciesId)).length, tr("stat_species")],
      [store.weights.all().length, tr("weight_h")],
      [overdue.length, tr("overdue")]])}
    ${rows.length ? `<div style="margin-top:var(--s-3)">` + rows.map(r => {
      const b = byId(r.speciesId), tasks = store.tasks.all().filter(t => t.birdId === r.id && !t.done);
      const last = store.weights.all().filter(w => w.birdId === r.id).sort((x, y) => y.at.localeCompare(x.at))[0];
      return `<div class="bird-item"><div class="avatar">${b ? GROUPS[b.g].e : "🐦"}</div>
        <div><b><a href="#/my-bird/${r.id}">${esc(r.nick)}</a></b>
          <div class="hint">${b ? esc(speciesName(b)) : "—"} · ${esc(r.sex || "?")} · ${esc(r.ring || "")} · ${esc(fmtDate(r.acquired || r.createdAt))}</div>
          <div class="hint">${last ? "⚖️ " + esc(last.grams) + " " + esc(tr("kg")) + " (" + esc(fmtDate(last.at)) + ")" : esc(tr("no_data"))}
            ${tasks.length ? " · 🗓️ " + tasks.length + " " + esc(tr("care_h")) : ""}</div></div>
        <div class="acts"><a class="btn sm ghost" href="#/my-bird/${r.id}">${esc(tr("open"))}</a>
          <button class="btn sm danger" data-del="${r.id}">✕</button></div></div>`;
    }).join("") + `</div>` : `<div class="empty"><b>🪺</b>${esc(tr("no_data"))}<br><button class="btn" id="add2">＋ ${esc(tr("add_h"))}</button></div>`}
    <p class="hint" style="margin-top:var(--s-3)">${esc(tr("localfirst"))}</p></section>`;
  $("#add").onclick = () => openAddBird(null);
  if ($("#add2")) $("#add2").onclick = () => openAddBird(null);
  on(app, "click", "[data-del]", (e, n) => {
    if (!confirmDlg(tr("confirm_clear"))) return;
    const id = n.dataset.del;
    store.birds.del(id);
    store.tasks.items = store.tasks.all().filter(t => t.birdId !== id); store.tasks.flush();
    store.weights.items = store.weights.all().filter(w => w.birdId !== id); store.weights.flush();
    store.symptoms.items = store.symptoms.all().filter(s => s.birdId !== id); store.symptoms.flush();
    queueWrite("birds", "delete", { id }); viewBirds();
  });
}

function viewBird(uidv) {
  const rec = store.birds.get(uidv);
  if (!rec) { app.innerHTML = `<div class="panel empty"><b>🤷</b>${esc(tr("no_data"))}</div>`; return; }
  const b = byId(rec.speciesId), g = b ? GROUPS[b.g] : null;
  const rawW = store.weights.all().map((w, i) => ({ w, i })).filter(x => x.w.birdId === uidv);
  /* Storage is newest-first, so same-day entries must fall back to reverse index. */
  const weights = rawW.sort((a, b) => a.w.at === b.w.at ? b.i - a.i : String(a.w.at).localeCompare(String(b.w.at))).map(x => x.w);
  const tasks = store.tasks.all().filter(t => t.birdId === uidv);
  const symp = store.symptoms.all().filter(s => s.birdId === uidv);
  const today = dayKey();
  document.title = rec.nick + " — Birds World";
  app.innerHTML = `<div class="row"><a class="btn ghost sm" href="#/my-birds">← ${esc(tr("my_h"))}</a>
    ${b ? `<a class="btn ghost sm" href="#/bird/${b.id}">${esc(speciesName(b))} ↗</a>` : ""}</div>
  <section class="panel"><div class="row" style="align-items:flex-start">
    <div class="avatar" style="width:64px;height:64px;font-size:2rem">${b ? g.e : "🐦"}</div>
    <div style="flex:1"><h1 style="margin:0">${esc(rec.nick)}</h1>
      <p class="hint">${b ? esc(b.sci) : "—"} · ${esc(tr("acquired"))}: ${esc(fmtDate(rec.acquired || rec.createdAt))} · ${esc(rec.sex || "?")} ${esc(rec.ring ? "· " + rec.ring : "")}</p></div>
    <button class="btn sm ghost" id="logW">＋ ${esc(tr("w_add"))}</button>
    <button class="btn sm ghost" id="logT">＋ ${esc(tr("care_h"))}</button>
  </div>
  ${statBlock([[weights.length, tr("weight_h")],
    [weights.length ? round(weights[weights.length - 1].grams, 1) + " " + tr("kg") : "—", "⚖️"],
    [tasks.filter(t => !t.done).length, tr("due")],
    [symp.length, tr("symtom")]])}
  <h3 style="margin-top:var(--s-4)">${esc(tr("weight_h"))}</h3>
  <canvas id="wCv" style="width:100%"></canvas>
  <div class="hint" id="wTrend"></div>
  </section>

  <section class="panel"><h2>🗓️ ${esc(tr("care_h"))}</h2>
    ${tasks.length ? tasks.map(t => `<div class="task${t.done ? " done" : ""}">
      <input type="checkbox" data-task="${t.id}" ${t.done ? "checked" : ""} aria-label="${esc(tr("t_done"))}">
      <span class="ttl" style="flex:1">${esc(t.title)}</span>
      ${t.due ? `<span class="pill${t.due < today && !t.done ? " banner danger" : ""}">${esc(tr("due"))} ${esc(fmtDate(t.due))}${t.due < today && !t.done ? " · " + esc(tr("overdue")) : ""}</span>` : ""}
      <button class="btn sm ghost" data-deltask="${t.id}">✕</button></div>`).join("")
      : `<p class="hint">${esc(tr("no_data"))}</p>`}</section>

  <section class="panel"><h2>🩺 ${esc(tr("symtom"))}</h2>
    <div class="row"><textarea id="sympText" placeholder="${esc(tr("symtom"))}" style="flex:1;min-width:220px"></textarea>
      <button class="btn" id="addSymp">${esc(tr("save"))}</button></div>
    ${symp.length ? symp.map(s => `<div class="banner" style="margin-top:var(--s-2)">${esc(s.text)}
      <div class="hint">${esc(fmtDate(s.at))} · <button class="btn sm ghost" data-delsymp="${s.id}">✕</button></div></div>`).join("")
      : `<p class="hint" style="margin-top:var(--s-2)">${esc(tr("no_data"))}</p>`}
    <p class="hint banner danger" style="margin-top:var(--s-3)">${esc(tr("disclaimer"))}</p></section>

  <section class="no-print"><div class="row">
    <button class="btn ghost sm" id="csvW">⬇ ${esc(tr("export_csv"))} (${esc(tr("weight_h"))})</button>
    <button class="btn ghost sm" id="csvAll">⬇ ${esc(tr("export_json"))}</button>
    <span class="spacer"></span><button class="btn danger sm" id="delBird">🗑 ${esc(tr("clear"))}</button>
  </div></section>`;

  drawChart($("#wCv"), weights.map(w => ({ x: w.at, y: +w.grams })), { unit: tr("kg"), label: rec.nick });
  if (weights.length > 1) {
    const first = weights[0].grams, last = weights[weights.length - 1].grams, d = last - first;
    const pct = first ? round(d / first * 100, 1) : 0;
    $("#wTrend").innerHTML = `<b>${pct > 0 ? "▲" : pct < 0 ? "▼" : "■"} ${pct}%</b> ${esc(tr("weight_h"))} · ${weights.length} × ${esc(tr("w_add"))} · ` +
      (pct < -8 ? `<span style="color:var(--danger-fg)">${esc(tr("med_advice"))}</span>` : esc(round(Math.min(...weights.map(w => w.grams)), 1) + "–" + round(Math.max(...weights.map(w => w.grams)), 1) + " " + tr("kg")));
  }
  $("#logW").onclick = () => {
    openDlg(tr("w_add"), `<form id="fW" class="stack" style="gap:var(--s-3)">
      <div><label>${esc(tr("kg"))}</label><input type="number" step="0.1" min="0.5" name="grams" required autofocus></div>
      <div><label>${esc(tr("s_date"))}</label><input type="date" name="at" value="${today}"></div>
      <button class="btn">${esc(tr("save"))}</button></form>`);
    $("#fW").addEventListener("submit", e => {
      e.preventDefault();
      const fd = Object.fromEntries(new FormData(e.target));
      const row = store.weights.add({ birdId: uidv, grams: num(fd.grams), at: fd.at || today });
      queueWrite("weights", "create", row); closeDlg(); viewBird(uidv);
    });
  };
  $("#logT").onclick = () => {
    openDlg(tr("care_h"), `<form id="fT" class="stack" style="gap:var(--s-3)">
      <div><label>${esc(tr("care_h"))}</label><input name="title" required placeholder="Wing clip / vet visit / deworm" autofocus></div>
      <div><label>${esc(tr("due"))}</label><input type="date" name="due" value="${today}"></div>
      <button class="btn">${esc(tr("save"))}</button></form>`);
    $("#fT").addEventListener("submit", e => {
      e.preventDefault();
      const fd = Object.fromEntries(new FormData(e.target));
      const row = store.tasks.add({ birdId: uidv, title: fd.title, due: fd.due, done: false });
      queueWrite("tasks", "create", row); closeDlg(); viewBird(uidv);
    });
  };
  on(app, "change", "[data-task]", (e, n) => { store.tasks.put(n.dataset.task, { done: n.checked }); viewBird(uidv); });
  on(app, "click", "[data-deltask]", (e, n) => { store.tasks.del(n.dataset.deltask); viewBird(uidv); });
  on(app, "click", "[data-delsymp]", (e, n) => { store.symptoms.del(n.dataset.delsymp); viewBird(uidv); });
  $("#addSymp").onclick = () => {
    const text = $("#sympText").value.trim(); if (!text) return;
    const s = store.symptoms.add({ birdId: uidv, text, at: new Date().toISOString() });
    queueWrite("symptoms", "create", s); $("#sympText").value = ""; viewBird(uidv);
  };
  $("#csvW").onclick = () => download(rec.nick + "-weights.csv", toCSV(weights.map(w => ({ bird: rec.nick, date: w.at, grams: w.grams }))), "text/csv");
  $("#csvAll").onclick = () => download(rec.nick + ".json", JSON.stringify({ ...rec, weights, tasks, symp }, null, 2));
  $("#delBird").onclick = () => {
    if (!confirmDlg(tr("confirm_clear"))) return;
    store.birds.del(uidv); queueWrite("birds", "delete", { id: uidv }); location.hash = "#/my-birds";
  };
}

/* ------------------------------------------------------------- SIGHTINGS */
function logSighting(species) {
  const today = dayKey();
  openDlg(tr("add_sighting"), `<form id="fS" class="stack" style="gap:var(--s-3)">
    <div><label>${esc(tr("nav_birds"))}</label><select name="speciesId" required>
      <option value="">—</option>
      ${SPECIES.map(b => `<option value="${b.id}"${species && b.id === species.id ? " selected" : ""}>${esc(b.en)} · ${esc(b.sci)}</option>`).join("")}
      ${species && !byId(species.id) ? `<option value="${esc(species.id || "")}" selected>${esc(species.en || species.sci)}</option>` : ""}</select></div>
    <div class="filters">
      <div><label>${esc(tr("s_date"))}</label><input type="date" name="date" value="${today}"></div>
      <div><label>${esc(tr("s_lat"))}</label><input type="number" step="0.0001" name="lat" id="sLat" placeholder="0.0000"></div>
      <div><label>${esc(tr("s_lng"))}</label><input type="number" step="0.0001" name="lng" id="sLng" placeholder="0.0000"></div>
    </div>
    <div class="row"><button type="button" class="btn sm ghost" id="gps">🧭 ${esc(tr("use_gps"))}</button>
      <span class="hint" id="gpsState"></span></div>
    <div><label>${esc(tr("s_notes"))}</label><textarea name="notes" maxlength="500"></textarea></div>
    <div><label>${esc(tr("s_photo"))}</label><input type="file" name="photo" accept="image/*" id="sPhoto"></div>
    <button class="btn">${esc(tr("save"))}</button></form>`);
  $("#gps").onclick = () => {
    if (!navigator.geolocation) { $("#gpsState").textContent = tr("geo_fail"); return; }
    $("#gpsState").textContent = "…";
    navigator.geolocation.getCurrentPosition(
      p => { $("#sLat").value = round(p.coords.latitude, 4); $("#sLng").value = round(p.coords.longitude, 4);
        $("#gpsState").textContent = tr("geo_ok") + " ±" + Math.round(p.coords.accuracy) + " m"; },
      () => { $("#gpsState").textContent = tr("geo_fail"); }, { enableHighAccuracy: true, timeout: 8000 });
  };
  $("#fS").addEventListener("submit", async e => {
    e.preventDefault();
    const fd = Object.fromEntries(new FormData(e.target));
    const file = $("#sPhoto").files[0];
    const who = byId(fd.speciesId) || species || null;
    const row = store.sightings.add({
      speciesId: fd.speciesId || (species && species.id) || "",
      /* atlas species have no guide id, so the Latin name is what keeps the
         sighting findable after the atlas data is deleted */
      species: (who && (who.en || who.ar)) || (who && who.sci) || "Unknown",
      sci: (who && who.sci) || "",
      date: fd.date ? new Date(fd.date).toISOString() : new Date().toISOString(),
      lat: fd.lat === "" ? null : num(fd.lat), lng: fd.lng === "" ? null : num(fd.lng),
      notes: fd.notes || "",
    });
    if (file) {
      if (file.size > 4e6) toast(tr("photo_big"), "warn");
      await idbPut("photo:" + row.id, file);
      row.photo = 1; store.sightings.flush();
    }
    queueWrite("sightings", "create", { id: row.id, species: row.species, species_id: row.speciesId, date: row.date, lat: row.lat, lng: row.lng, notes: row.notes });
    closeDlg(); award(3); toast(tr("note_saved"), "ok");
    if (location.hash.startsWith("#/sightings")) viewSightings();
  });
}
function viewSightings() {
  document.title = tr("nav_sightings") + " — Birds World";
  const rows = store.sightings.all();
  const own = rows.filter(r => !r.community), geo = rows.filter(r => Number.isFinite(+r.lat) && Number.isFinite(+r.lng));
  const life = uniq(rows.filter(r => r.speciesId).map(r => r.speciesId));
  app.innerHTML = `<section class="panel">
    <div class="row"><h2 style="margin:0;flex:1">🗺️ ${esc(tr("nav_sightings"))}</h2>
      <button class="btn" id="addS">＋ ${esc(tr("add_sighting"))}</button>
      <button class="btn ghost sm" id="expCsv">⬇ CSV</button>
      <button class="btn ghost sm" id="expJson">⬇ JSON</button></div>
    ${statBlock([[rows.length, tr("stat_sights")], [life.length, tr("life_list")],
      [geo.length, tr("s_lat") + "/" + tr("s_lng")], [own.length, tr("stat_mine")]])}
    <div id="mapwrap" style="margin-top:var(--s-3)">
      <canvas id="map" style="width:100%"></canvas>
      <div class="legend"><span><i></i>${esc(tr("stat_mine"))}</span>
        <span><i style="background:#6366f1"></i>${esc(tr("api_base"))}</span>
        <span class="hint">${esc(tr("compare_hint"))}</span></div>
    </div></section>

  <section class="panel"><h2>${esc(tr("life_list"))}</h2>
    ${life.length ? `<div class="row">${life.map(id => { const b = byId(id);
      return b ? `<button class="chip" data-go="${b.id}">${GROUPS[b.g].e} ${esc(speciesName(b))} ×${rows.filter(r => r.speciesId === id).length}</button>` : ""; }).join("")}</div>`
      : `<p class="hint">${esc(tr("no_data"))}</p>`}
    <p class="hint" style="margin-top:var(--s-3)">${esc(tr("localfirst"))}</p></section>

  <section class="panel"><h2>${esc(tr("s_notes"))}</h2><div id="log"></div></section>`;

  const drawLog = async () => {
    $("#log").innerHTML = rows.length ? rows.map(r => `<div class="bird-item">
      <div class="avatar">${(byId(r.speciesId) ? GROUPS[byId(r.speciesId).g].e : "🐦")}</div>
      <div><b>${esc(r.species)}</b> ${r.photo ? "📷" : ""}${r.community ? ' <span class="pill">🌐</span>' : ""}
        <div class="hint">${esc(fmtDate(r.date))}${Number.isFinite(+r.lat) ? " · " + round(+r.lat, 3) + ", " + round(+r.lng, 3) : ""}</div>
        ${r.notes ? `<div class="hint">${esc(r.notes)}</div>` : ""}
        <div id="ph-${r.id}" class="row" style="margin-top:4px"></div></div>
      <div class="acts">${r.speciesId ? `<a class="btn sm ghost" href="#/bird/${esc(r.speciesId)}">${esc(tr("open"))}</a>` : ""}
        <button class="btn sm danger" data-dels="${r.id}">✕</button></div></div>`).join("")
      : `<p class="hint">${esc(tr("no_data"))}</p>`;
    for (const r of rows.filter(x => x.photo).slice(0, 12)) {
      const blob = await idbGet("photo:" + r.id);
      const host = $("#ph-" + r.id);
      if (blob && host) { const url = URL.createObjectURL(blob);
        host.innerHTML = `<img src="${url}" alt="" style="width:96px;height:72px;object-fit:cover;border-radius:var(--r-sm)">`;
        host.querySelector("img").onclick = () => openLightbox(url, r.species); }
    }
    drawMap($("#map"), rows, p => toast(p.species + " · " + fmtDate(p.date) + (p.notes ? " · " + p.notes : ""), "info", 3600));
  };
  $("#addS").onclick = () => logSighting(null);
  $("#expCsv").onclick = () => download("sightings.csv", toCSV(rows.map(r => ({ species: r.species, species_id: r.speciesId, date: r.date, lat: r.lat, lng: r.lng, notes: r.notes, source: r.community ? "community" : "local" }))), "text/csv");
  $("#expJson").onclick = () => download("sightings.json", JSON.stringify(rows, null, 2));
  on(app, "click", "[data-dels]", (e, n) => { store.sightings.del(n.dataset.dels); queueWrite("sightings", "delete", { id: n.dataset.dels }); viewSightings(); });
  on(app, "click", "[data-go]", (e, n) => { location.hash = "#/bird/" + n.dataset.go; });
  drawLog();
  window.addEventListener("resize", debounce(() => { const cv = $("#map"); if (cv) drawMap(cv, rows); }, 250), { once: true });
}

/* ------------------------------------------------------------------ LEARN */
let quiz = null;
function viewLearn() {
  document.title = tr("quiz_h") + " — Birds World";
  const p = store.progress, due = SRS.count();
  app.innerHTML = `<section class="panel">
    <div class="row"><h2 style="margin:0;flex:1">🧠 ${esc(tr("quiz_h"))}</h2>
      <span class="pill">⭐ ${p.points} ${esc(tr("points"))}</span>
      <span class="pill">🔥 ${p.streak} ${esc(tr("streak"))}</span>
      <span class="pill">${esc(tr("lvl"))} ${1 + Math.floor(p.points / 60)}</span></div>
    <div class="row" style="margin-top:var(--s-3)">
      <button class="btn sm" data-mode="name">📛 ${esc(tr("nav_birds"))} ↔ ${esc(tr("traits"))}</button>
      <button class="btn sm ghost" data-mode="origin">🌍 ${esc(tr("origin"))}</button>
      <button class="btn sm ghost" data-mode="sound">🎧 ${esc(tr("t_sounds"))}</button>
      <button class="btn sm ghost" data-mode="size">📏 ${esc(tr("size"))}</button>
      ${due ? `<button class="btn sm ghost" data-mode="srs">🎓 ${esc(tr("srs_h"))} (${due})</button>` : ""}
    </div>
    <div id="quizArea" style="margin-top:var(--s-3)"><p class="hint">${esc(tr("compare_hint"))}</p></div></div>

  <section class="panel"><h2>🏅 ${esc(tr("badges"))}</h2>
    <div class="badgegrid">${BADGES.map(([id, e, need, , name]) => `<div class="trophy" data-locked="${p["un_" + id] ? "false" : "true"}">
      <b>${e}</b><span>${esc(name[I18N.lang] || name.en)}</span><div class="hint">${need}</div></div>`).join("")}</div></section>

  <section class="panel"><h2>📆 ${esc(tr("srs_h"))}</h2>
    <p class="hint">${esc(tr("srs_done"))}</p>
    <div class="row"><button class="btn sm ghost" id="seedCards">＋ ${esc(tr("srs_h"))} · ${SPECIES.length}</button></div></section>`;

  on(app, "click", "[data-mode]", (e, n) => startQuiz(n.dataset.mode));
  $("#seedCards").onclick = () => {
    const now = Date.now();
    shuffle(SPECIES).slice(0, 12).forEach((b, i) => { if (!store.cards["sp:" + b.id]) store.cards["sp:" + b.id] = { interval: 0, ease: 2.5, reps: 0, lapses: 0, due: now + i * 36e5 }; });
    store.persist(); toast(tr("note_saved"), "ok"); viewLearn();
  };

  function finish(right, chosenId) {
    store.progress.streak = right ? store.progress.streak + 1 : 0;
    store.progress.quizzes++;
    award(right ? 2 + Math.min(6, store.progress.streak) : 0);
    const host = $("#quizArea");
    host.querySelector('[data-opt="' + chosenId + '"]').classList.add(right ? "right" : "wrong");
    if (!right) host.querySelector('[data-opt="' + quiz.target.id + '"]')?.classList.add("right");
    $$('[data-opt]', host).forEach(x => { x.disabled = true; });
    host.insertAdjacentHTML("beforeend", `<div class="row" style="margin-top:var(--s-3)">
      <span class="banner ${right ? "ok" : "danger"}">${esc(right ? tr("right") : tr("wrong"))} · ${esc(speciesName(quiz.target))}</span>
      <a class="btn sm ghost" href="#/bird/${quiz.target.id}">${esc(tr("open"))} ↗</a>
      <button class="btn sm" id="qNext">${esc(tr("next"))} →</button></div>`);
    $("#qNext").onclick = () => startQuiz(quiz.mode);
    store.persist();
  }
  function ask(promptHTML, opts, keyOf) {
    $("#quizArea").innerHTML = `<p class="wiz-q">${promptHTML}</p><div class="opts" id="qOpts">
      ${opts.map(o => `<button class="qopt" data-opt="${o.id}">${esc(keyOf(o))}</button>`).join("")}</div>`;
    on($("#qOpts"), "click", "[data-opt]", (e, n) => finish(n.dataset.opt === quiz.target.id, n.dataset.opt));
  }
  async function startQuiz(mode) {
    if (mode === "srs") return startReview();
    const target = pick(SPECIES);
    const wrong = shuffle(SPECIES.filter(x => x.id !== target.id)).slice(0, 3);
    quiz = { mode, target, opts: shuffle([target, ...wrong]) };
    if (mode === "name") ask(`<i>${esc(target.sci)}</i>`, quiz.opts, o => speciesName(o));
    else if (mode === "origin") ask(`🌍 ${esc(target.origin)}`, quiz.opts, o => speciesName(o));
    else if (mode === "size") ask(`📏 ${esc(target.size)} — ${esc(tr("which_bird"))}`, quiz.opts, o => speciesName(o));
    else if (mode === "sound") {
      $("#quizArea").innerHTML = `<p class="wiz-q">🎧 ${esc(tr("t_sounds"))}</p><div class="row">
        <button class="btn sm" id="playQ">▶ ${esc(tr("synth"))}</button><span class="hint" id="qState">…</span></div>
        <div class="opts" id="qOpts" style="margin-top:var(--s-3)"></div>`;
      let recs = [];
      try { recs = await Song.for(target); } catch { recs = []; }
      const pitch = GROUPS[target.g].synthPitch;
      if (recs.length) {
        $("#qState").textContent = "🎧 " + recs.length + " · " + (Song.SRC[recs[0].src] || [""])[0];
        const q = new Audio(); q.preload = "none";
        $("#playQ").onclick = () => { Song.play(recs[0], q, null, null).then(ok => { if (!ok) playChirp(pitch); }); };
      } else { $("#qState").textContent = "🔊 " + tr("synth"); $("#playQ").onclick = () => playChirp(pitch); }
      $("#qOpts").innerHTML = quiz.opts.map(o => `<button class="qopt" data-opt="${o.id}">${esc(speciesName(o))}</button>`).join("");
      on($("#qOpts"), "click", "[data-opt]", (e, n) => finish(n.dataset.opt === target.id, n.dataset.opt));
    }
  }
  function startReview() {
    const queue = SRS.due();
    if (!queue.length) { $("#quizArea").innerHTML = `<p class="banner ok">${esc(tr("srs_done"))}</p>`; return; }
    let i = 0;
    const show = () => {
      if (i >= queue.length) { $("#quizArea").innerHTML = `<p class="banner ok">${esc(tr("srs_done"))}</p>`; toast("+" + (queue.length * 3) + " " + tr("points"), "ok"); return; }
      const b = byId(queue[i].id.slice(3)); if (!b) { i++; return show(); }
      $("#quizArea").innerHTML = `<div class="flashcard" id="card"><div><b>${esc(b.sci)}</b><br><span class="hint">${esc(tr("answer"))} · tap</span></div></div>
        <div class="row" id="grades" hidden><button class="btn danger" data-q="0">${esc(tr("again"))}</button>
          <button class="btn ghost" data-q="1">${esc(tr("good"))}</button>
          <button class="btn" data-q="2">${esc(tr("easy"))}</button></div>`;
      $("#card").onclick = () => { $("#card").innerHTML = `<div><b>${esc(speciesName(b))}</b><br><span class="hint">${esc(b.origin)} · ${esc(b.size)} · ${esc(b.life)}</span></div>`; $("#grades").hidden = false; };
      on($("#grades"), "click", "[data-q]", (e, n) => { SRS.apply(queue[i].id, +n.dataset.q); i++; show(); });
    };
    show();
  }
  startQuiz("name");
}

/* -------------------------------------------------------------- SETTINGS */
function applyTheme() {
  const pref = store.settings.theme;
  const dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
  document.documentElement.dataset.theme = pref === "auto" ? (dark ? "dark" : "light") : pref;
  document.documentElement.style.setProperty("--h", store.settings.accent);
  const meta = document.querySelector('meta[name="theme-color"]');
  if (meta) meta.content = "hsl(" + store.settings.accent + " 72% 42%)";
  renderNav();
}
async function storageInfo() {
  let used = null, quota = null;
  try { if (navigator.storage && navigator.storage.estimate) { const e = await navigator.storage.estimate(); used = e.usage; quota = e.quota; } } catch { /* not permitted */ }
  let local = 0;
  for (const k in localStorage) if (Object.prototype.hasOwnProperty.call(localStorage, k)) local += k.length + localStorage[k].length;
  return { used, quota, local: local * 2 };
}
function exportBackup() {
  /* API keys never leave the device, even in a user-initiated backup: the
     Xeno-canto key, the model key and the iNaturalist token are stripped. */
  const settings = { ...store.settings, xenoKey: "", aiKey: "", inatToken: "" };
  return JSON.stringify({ app: "birds-world", version: CFG.VERSION, at: new Date().toISOString(),
    settings, favorites: Array.from(store.favs), notes: store.notes,
    visits: Array.from(store.visits), birds: store.birds.all(), sightings: store.sightings.all(),
    tasks: store.tasks.all(), weights: store.weights.all(), symptoms: store.symptoms.all(),
    cards: store.cards, progress: store.progress, saved: store.saved.all() }, null, 2);
}
function importBackup(text) {
  const d = JSON.parse(text);
  if (!d || d.app !== "birds-world") throw new Error("unrecognised file");
  const keepKey = store.settings.xenoKey, keepAi = store.settings.aiKey, keepInat = store.settings.inatToken;
  Object.assign(store.settings, d.settings || {});
  store.settings.xenoKey = d.settings && d.settings.xenoKey ? d.settings.xenoKey : keepKey;
  store.settings.aiKey = d.settings && d.settings.aiKey ? d.settings.aiKey : keepAi;
  store.settings.inatToken = d.settings && d.settings.inatToken ? d.settings.inatToken : keepInat;
  AI.invalidate();
  store.favs = new Set(d.favorites || []); store.notes = d.notes || {}; store.visits = new Set(d.visits || []);
  store.birds.items = d.birds || []; store.sightings.items = d.sightings || [];
  store.tasks.items = d.tasks || []; store.weights.items = d.weights || []; store.symptoms.items = d.symptoms || [];
  store.cards = d.cards || {}; store.progress = Object.assign(store.progress, d.progress || {});
  store.saved.items = d.saved || [];
  ["birds", "sightings", "tasks", "weights", "symptoms", "saved"].forEach(k => store[k].flush());
  store.persist(); toast(tr("remote_ok"), "ok"); route();
}
function viewSettings() {
  document.title = tr("settings_h") + " — Birds World";
  const s = store.settings;
  app.innerHTML = `<section class="panel"><h2>⚙️ ${esc(tr("settings_h"))}</h2>
    <div class="filters">
      <div><label>${esc(tr("theme"))}</label><select id="setTheme">
        ${["auto", "light", "dark"].map(v => `<option value="${v}"${s.theme === v ? " selected" : ""}>${v}</option>`).join("")}</select></div>
      <div><label>${esc(tr("language"))}</label><select id="setLang">
        ${CFG.LANGS.map(v => `<option value="${v}"${I18N.lang === v ? " selected" : ""}>${v === "ar" ? "العربية" : "English"}</option>`).join("")}</select></div>
      <div><label>${esc(tr("accent"))}</label><div class="rng"><input type="range" id="setHue" min="0" max="360" value="${s.accent}"><output id="hueOut">${s.accent}°</output></div></div>
    </div>
    <div id="installRow" class="row" style="margin-top:var(--s-3)"></div></section>

  <section class="panel"><h2>🌐 ${esc(tr("api_base"))}</h2>
    <div class="row"><input id="setApi" placeholder="https://api.example.org" value="${esc(s.apiBase)}" style="flex:1;min-width:220px">
      <button class="btn" id="setApiSave">${esc(tr("save"))}</button>
      <button class="btn ghost" id="syncNow">🔄 ${esc(tr("sync_now"))}</button></div>
    <p class="hint">${esc(tr("api_hint"))}</p>
    <div class="row" style="margin-top:var(--s-3)"><input id="setKey" type="password" placeholder="${esc(tr("xeno_key"))}" value="${esc(s.xenoKey || "")}" style="flex:1;min-width:220px">
      <button class="btn ghost" id="setKeySave">${esc(tr("save"))}</button></div>
    <p class="hint">${esc(tr("xeno_key_hint"))}</p>
    <div class="kb" style="margin-top:var(--s-2)">
      <div class="kv"><span>${esc(tr("outbox"))}</span><b id="outN">${store.outbox.all().length}</b></div>
      <div class="kv"><span>${esc(tr("last_sync"))}</span>${s.lastSync ? esc(fmtDate(new Date(s.lastSync).toISOString())) : "—"}</div>
      <div class="kv"><span>Wiki / Commons cache</span>${cachedJSON.mem.size}</div></div></section>

  <section class="panel"><h2>🎧 ${esc(tr("song_h"))}</h2>
    <div class="row"><input id="setInat" type="password" placeholder="${esc(tr("inat_key"))}" value="${esc(s.inatToken || "")}" style="flex:1;min-width:220px" autocomplete="off">
      <button class="btn ghost" id="setInatSave">${esc(tr("save"))}</button></div>
    <p class="hint">${esc(tr("inat_key_hint"))}</p>
    <div class="kb" style="margin-top:var(--s-2)">
      <div class="kv"><span>${esc(tr("song_sources"))}</span><b>${esc(Song.enabled().join(" · "))}</b></div>
      <div class="kv"><span>${esc(tr("song_mb"))}</span><b id="songKb">${round(Song.savedBytes() / 1048576, 1)} MB · ${Song.index().length}</b></div></div>
    <div class="row" style="margin-top:var(--s-3)">
      <button class="btn ghost" id="songProbe">📊 ${esc(tr("song_probe"))}</button>
      <button class="btn danger ghost" id="songWipe">🗑 ${esc(tr("song_clear"))}</button>
      <span class="spacer"></span><span class="hint" id="songProbeOut"></span></div></section>

  <section class="panel"><h2>🤖 ${esc(tr("ai_h"))}</h2>
    <div class="row" style="margin-bottom:var(--s-3)">
      ${AI.PRESETS.map(p => `<button class="btn ghost sm" data-aip="${esc(p.k)}">${esc(I18N.lang === "ar" ? p.ar : p.en)}</button>`).join("")}
      <span class="spacer"></span><span class="hint">${esc(tr("ai_preset"))}</span></div>
    <div class="filters">
      <div><label>${esc(tr("ai_base"))}</label><input id="setAiBase" placeholder="https://api.openai.com/v1" value="${esc(s.aiBase || "")}" autocomplete="off"></div>
      <div><label>${esc(tr("ai_model"))}</label><input id="setAiModel" placeholder="gpt-4o-mini" value="${esc(s.aiModel || "")}" autocomplete="off"></div>
      <div><label>${esc(tr("ai_key"))}</label><input id="setAiKey" type="password" value="${esc(s.aiKey || "")}" autocomplete="off"></div>
    </div>
    <div class="row" style="margin-top:var(--s-3)"><button class="btn" id="setAiSave">${esc(tr("save"))}</button>
      <button class="btn ghost" id="setAiTest">🔌 ${esc(tr("ai_test"))}</button>
      <button class="btn ghost" id="setAiClear">${esc(tr("clear"))}</button>
      <span class="spacer"></span><span class="hint" id="setAiOut"></span></div>
    <div class="row" style="margin-top:var(--s-3);align-items:center">
      <label class="inline" style="margin:0"><input type="checkbox" id="setAiSpeak" ${s.aiSpeak ? "checked" : ""}> ${esc(tr("ai_auto_speak"))}</label>
      <label class="inline" style="margin:0" for="setAiRate">${esc(tr("ai_rate"))}</label>
      <input type="range" id="setAiRate" min="0.6" max="1.6" step="0.05" value="${clamp(num(s.speakRate, 1), 0.6, 1.6)}" style="max-width:170px">
      <output id="setAiRateOut">${round(num(s.speakRate, 1), 2)}×</output>
      <button class="btn ghost sm" id="setAiSay">🔊 ${esc(tr("ai_sample"))}</button></div>
    <p class="hint">${esc(tr("ai_cloud_hint"))} ${esc(tr("ai_strip"))}</p></section>

  <section class="panel"><h2>🌍 ${esc(tr("atlas_h"))}</h2>
    <label class="inline"><input type="checkbox" id="setAtlasInc" ${s.includeAtlas ? "checked" : ""}> ${esc(tr("atlas_include"))}</label>
    <div class="row" style="margin-top:var(--s-3)"><a class="btn" href="#/atlas">🌍 ${esc(tr("atlas_h"))}</a>
      <span class="hint">${esc(tr("atlas_cap"))}: <b id="setCapOut">${s.atlasCap || CFG.ATLAS.defaultCap}</b> · ${esc(tr("atlas_have"))}: <b id="setAtN">${Atlas.count()}</b></span></div>
    <p class="hint">${esc(tr("atlas_source"))}</p></section>

  <section class="panel"><h2>💾 ${esc(tr("storage"))}</h2>
    <div id="storageBox" class="hint">…</div>
    <div class="row" style="margin-top:var(--s-3)">
      <button class="btn ghost" id="expAll">⬇ ${esc(tr("export_json"))}</button>
      <label class="btn ghost" style="cursor:pointer">⬆ ${esc(tr("import"))}<input type="file" id="impFile" accept="application/json" hidden></label>
      <span class="spacer"></span><button class="btn danger" id="wipe">🗑 ${esc(tr("clear_all"))}</button></div></section>

  <section class="panel no-print"><h2>⌨️ ${esc(tr("traits"))}</h2>
    <p class="hint">/ ${esc(tr("search"))} · g+h/g/b/f/m/s/l · t ${esc(tr("theme"))} · l ${esc(tr("language"))} · Esc ${esc(tr("clear"))}</p></section>`;

  $("#setTheme").onchange = e => { s.theme = e.target.value; store.persist(); applyTheme(); };
  $("#setLang").onchange = e => { I18N.apply(e.target.value); route(); };
  $("#setHue").oninput = e => { s.accent = +e.target.value; $("#hueOut").textContent = s.accent + "°"; applyTheme(); };
  $("#setHue").onchange = () => store.persist();
  $("#setKeySave").onclick = () => {
    store.settings.xenoKey = $("#setKey").value.trim(); store.persist();
    toast(xenoConfigured() ? tr("note_saved") : "Local mode", "ok"); viewSettings();
  };
  $("#setApiSave").onclick = () => {
    s.apiBase = $("#setApi").value.trim().replace(/\/+$/, ""); store.persist();
    toast(remote.enabled() ? tr("remote_ok") : "Local mode", "ok"); viewSettings();
  };
  $("#syncNow").onclick = async () => { await remote.syncAll(); viewSettings(); };
  $("#setInatSave").onclick = () => {
    s.inatToken = $("#setInat").value.trim(); store.persist();
    toast(tr("note_saved"), "ok"); viewSettings();
  };
  $("#songWipe").onclick = async () => { await Song.wipeOffline(); toast(tr("song_removed"), "ok"); viewSettings(); };
  $("#songProbe").onclick = async () => {
    const btn = $("#songProbe"); btn.disabled = true;
    const out = await Song.probe(12, (t, f) => { $("#songProbeOut").textContent = t + "/12 · " + f; });
    $("#songProbeOut").textContent = tr("song_probe_done", { a: out.found, b: out.tested }) + (out.ex.length ? " · " + out.ex.join(", ") : "");
    btn.disabled = false;
  };
  $("#setAiSave").onclick = () => {
    s.aiBase = $("#setAiBase").value.trim().replace(/\/+$/, "");
    s.aiModel = $("#setAiModel").value.trim();
    s.aiKey = $("#setAiKey").value.trim();
    store.persist();
    toast(AI.cloudOn() ? tr("ai_cloud") : tr("ai_local"), "ok"); viewSettings();
  };
  $("#setAiClear").onclick = () => {
    s.aiBase = ""; s.aiKey = ""; s.aiModel = ""; store.persist();
    AI.invalidate(); toast(tr("ai_local"), "ok"); viewSettings();
  };
  /* Presets only fill the fields — saving stays an explicit press, because the
     address is where the keeper's questions are about to go. */
  on(app, "click", "[data-aip]", (e, n) => {
    const p = AI.PRESETS.find(x => x.k === n.dataset.aip); if (!p) return;
    $("#setAiBase").value = p.base; $("#setAiModel").value = p.model;
    if (!p.key) $("#setAiKey").value = "";
    $("#setAiOut").textContent = tr("ai_preset");
  });
  $("#setAiTest").onclick = async () => {
    s.aiBase = $("#setAiBase").value.trim().replace(/\/+$/, "");
    s.aiModel = $("#setAiModel").value.trim();
    s.aiKey = $("#setAiKey").value.trim();
    store.persist();
    const out = $("#setAiOut");
    out.textContent = tr("ai_thinking");
    try {
      const r = await AI.test();
      out.textContent = tr("ai_test_ok", { ms: r.ms, echo: r.echo || "—" });
    } catch (e2) {
      out.textContent = tr("ai_test_fail") + " " + String((e2 && e2.message) || e2);
    }
  };
  $("#setAiSpeak").onchange = e => {
    s.aiSpeak = e.target.checked; store.persist();
    if (e.target.checked) speak(I18N.lang === "ar" ? "تم تشغيل قراءة الردود بصوت عربي." : "Answer read-aloud is on.");
    else stopSpeak();
  };
  $("#setAiRate").oninput = e => {
    s.speakRate = clamp(num(e.target.value, 1), 0.6, 1.6);
    $("#setAiRateOut").textContent = round(s.speakRate, 2) + "×";
  };
  $("#setAiRate").onchange = () => store.persist();
  $("#setAiSay").onclick = () => speak(I18N.lang === "ar"
    ? "مرحباً. هذا صوت مساعد الطيور، يقرأ أرقام الأكل والمساحة ومواعيد الفقس."
    : "Hello. This is the bird assistant voice. It reads food amounts, cage sizes and hatch dates.");
  $("#setAtlasInc").onchange = e => {
    s.includeAtlas = e.target.checked; store.persist(); AI.invalidate(); toast(tr("note_saved"), "ok");
  };
  Atlas.load().then(() => { const n = $("#setAtN"); if (n) n.textContent = String(Atlas.count()); }).catch(() => null);
  $("#expAll").onclick = () => download("birds-world-backup.json", exportBackup());
  $("#impFile").onchange = e => {
    const f = e.target.files[0]; if (!f) return;
    f.text().then(importBackup).catch(err => toast(tr("import_fail") + " " + err.message, "error", 4000));
  };
  $("#wipe").onclick = () => {
    if (!confirmDlg(tr("confirm_clear"))) return;
    Object.keys(localStorage).filter(k => k.startsWith(CFG.NS + ":") || k.startsWith("bw_")).forEach(k => localStorage.removeItem(k));
    idbDel("photo:all"); location.hash = "#/"; location.reload();
  };
  storageInfo().then(i => {
    $("#storageBox").innerHTML = "localStorage: <b>" + bytes(i.local) + "</b>" +
      (i.used != null ? ` · device: <b>${bytes(i.used)}</b> / ${bytes(i.quota)} · ` +
        `<progress value="${i.used}" max="${i.quota}"></progress>` : "") +
      ` · ${store.sightings.all().filter(r => r.photo).length} 📷`;
  });
  if (deferredPrompt) showInstallButton($("#installRow"));
}

/* ---------------------------------------------------------------- 9. ROUTER */
/* Atlas rows carry no care traits, so they render as a compact list and a
   facts page of their own rather than as guide cards with invented numbers. */
function atlasList(rows, note) {
  if (!rows.length) return "";
  return `<section class="panel"><h2>🌍 ${esc(tr("atlas_row"))}</h2>
    <p class="hint">${esc(note || tr("atlas_sub"))}</p>
    <div class="stack" style="margin-top:var(--s-3)">${rows.slice(0, CFG.MAX_CARDS * 6).map(r => `<div class="row arow">
      ${r.img ? `<img loading="lazy" src="${esc(r.img)}" alt="" width="46" height="46" onerror="this.hidden=true" style="object-fit:cover;border-radius:8px">`
        : `<span class="chip">${esc(tr("atlas_noimg"))}</span>`}
      <div style="flex:1;min-width:0"><b><a href="#/atlas/${encodeURIComponent(r.sci)}">${esc(speciesName(r) || r.sci)}</a></b>
        <div class="hint"><i>${esc(r.sci)}</i> · ${esc(r.family || "")}${r.order ? " · " + esc(r.order) : ""}</div></div>
      <button class="btn sm ghost" data-asight="${esc(r.sci)}">📍 ${esc(tr("atlas_promote"))}</button></div>`).join("")}</div></section>`;
}

function viewAtlasSpecies(sci) {
  const r = Atlas.get(sci);
  if (!r) { app.innerHTML = `<div class="panel banner warn">${esc(tr("atlas_none"))}</div>`; return; }
  document.title = (speciesName(r) || r.sci) + " — Birds World";
  const links = [["Wikidata", "https://www.wikidata.org/wiki/" + (r.wd || ""), r.wd],
    ["Wikipedia", "https://en.wikipedia.org/wiki/" + encodeURIComponent(r.sci), true],
    ["GBIF", "https://www.gbif.org/species/" + r.gbif, !!r.gbif],
    ["Commons", "https://commons.wikimedia.org/wiki/Special:Search?search=" + encodeURIComponent(r.sci), true]]
    .filter(x => x[2]).map(([n, u]) => `<a class="chip" href="${esc(u)}" target="_blank" rel="noopener">${esc(n)} ↗</a>`).join("");
  app.innerHTML = `<section class="panel">
    <div class="row" style="align-items:flex-start">
      <div class="thumb" style="width:180px;aspect-ratio:4/3;border-radius:var(--r);overflow:hidden;background:var(--surface-2);display:grid;place-items:center;font-size:3rem">
        ${r.img ? `<img src="${esc(r.img)}" alt="" style="width:100%;height:100%;object-fit:cover">` : "🐦"}</div>
      <div style="flex:1;min-width:200px">
        <h2 style="margin-bottom:2px">${esc(speciesName(r) || r.sci)}</h2>
        <p class="hint"><i>${esc(r.sci)}</i></p>
        <div class="row">${links}</div>
        <div class="row" style="margin-top:var(--s-3)">
          <button class="btn sm" data-asight="${esc(r.sci)}">📍 ${esc(tr("atlas_promote"))}</button>
          <a class="btn sm ghost" href="#/identify">🎙️ ${esc(tr("id_against"))}</a>
          <a class="btn sm ghost" href="#/birds">← ${esc(tr("nav_birds"))}</a></div>
      </div></div>
    <p class="hint" style="margin-top:var(--s-3)">${esc(tr("atlas_source"))}</p></section>

    <section class="panel"><h2>🎧 ${esc(tr("song_h"))}</h2>
      <div class="row"><button class="btn sm" id="asRec">🎧 ${esc(tr("song_load"))}</button>
        <a class="btn sm ghost" href="#/identify">🎙️ ${esc(tr("id_against"))}</a></div>
      <div id="asRecList" style="margin-top:var(--s-3)"></div>
      <audio id="asPlayer" controls crossorigin="anonymous" preload="none" style="width:100%;margin-top:var(--s-2)"></audio></section>

    <section class="panel"><h2>${esc(tr("atlas_tax"))}</h2>
    <div class="kb">
      <div class="kv"><span>${esc(tr("tax_order"))}</span><b>${esc(r.order || "—")}</b></div>
      <div class="kv"><span>${esc(tr("tax_family"))}</span><b>${esc(r.family || "—")}</b></div>
      <div class="kv"><span>${esc(tr("tax_genus"))}</span><b>${esc(r.genus || "—")}</b></div>
      <div class="kv"><span>GBIF</span><b>${esc(String(r.gbif || "—"))}</b></div></div></section>`;
  wireCatalogueClicks(app);
  const ap = $("#asPlayer");
  const drawAs = async keepMem => {
    $("#asRecList").innerHTML = `<p class="hint">${esc(tr("song_searching"))}</p>`;
    if (!keepMem) Song.forget(r.sci);
    let items = [];
    try { items = await Song.for(r); } catch { items = []; }
    if (!items.length) {
      $("#asRecList").innerHTML = `<div class="banner warn">🎧 ${esc(tr("song_none"))}<br>
        <a target="_blank" rel="noopener noreferrer" href="${esc(CFG.API.xenoSite + "?q=" + encodeURIComponent(r.sci))}">xeno-canto ↗</a></div>`;
      return;
    }
    $("#asRecList").innerHTML = `<span class="chip">🎧 ${esc(tr("song_found", { n: items.length }))}</span>` + songMarkup(items);
    wireSongs($("#asRecList"), items, ap, null, null, () => drawAs(true));
  };
  $("#asRec").onclick = () => drawAs(false);
}

/* ------------------------------------------------------------ ATLAS VIEW */
async function viewAtlas() {
  document.title = tr("atlas_h") + " — Birds World";
  await Atlas.load();
  const st = await Atlas.stats();
  const cap = store.settings.atlasCap || CFG.ATLAS.defaultCap;
  app.innerHTML = `<section class="panel"><h2>🌍 ${esc(tr("atlas_h"))}</h2>
    <p class="hint">${esc(tr("atlas_sub"))}</p>
    <div class="kb" style="margin-top:var(--s-3)">
      <div class="kv"><span>${esc(tr("atlas_have"))}</span><b id="atN">${st.n}</b></div>
      <div class="kv"><span>${esc(tr("atlas_enrich"))}</span><b id="atAr">${st.withAr} / ${st.n}</b></div>
      <div class="kv"><span>${esc(tr("photo"))}</span><b id="atImg">${st.withImg}</b></div>
      <div class="kv"><span>${esc(tr("atlas_tax"))}</span><b id="atFam">${st.fams}</b></div></div>
    <div class="filters" style="margin-top:var(--s-3)">
      <div><label for="atScope">${esc(tr("atlas_scope"))}</label>
        <select id="atScope"><option value="all">${esc(tr("atlas_all"))}</option>
          <option value="order"${store.settings.atlasOrder ? " selected" : ""}>${esc(tr("atlas_order"))}</option></select></div>
      <div id="atOrderBox"${store.settings.atlasOrder ? "" : " hidden"}><label for="atOrder">${esc(tr("tax_order"))}</label>
        <select id="atOrder"><option value="">…</option></select></div>
      <div><label for="atCap">${esc(tr("atlas_cap"))}</label>
        <div class="rng"><input type="range" id="atCap" min="500" max="${CFG.ATLAS.maxCap}" step="500"
          value="${Math.max(500, Math.round(cap / 500) * 500)}"><output id="atCapOut">${Math.max(500, Math.round(cap / 500) * 500)}</output></div></div></div>
    <div class="row" style="margin-top:var(--s-3)">
      <button class="btn" id="atRun">⬇ ${esc(tr("atlas_start"))}</button>
      <button class="btn ghost" id="atStop" disabled>■ ${esc(tr("atlas_stop"))}</button>
      <button class="btn ghost" data-setcap="5000">5 000</button>
      <button class="btn ghost" data-setcap="10000">10 000</button>
      <span class="spacer"></span>
      <button class="btn danger ghost" id="atClear">🗑 ${esc(tr("atlas_clear"))}</button></div>
    <div class="bar" id="atBar" hidden><i id="atBarIn" style="width:0%"></i></div>
    <p class="hint" id="atNote">${esc(tr("atlas_source"))}</p></section>

  <section class="panel"><h2>${esc(tr("search"))}</h2>
    <div class="row"><input id="atQ" placeholder="${esc(tr("search_ph"))}" style="flex:1;min-width:220px">
      <span class="hint" id="atCount">${st.n ? Atlas.count() : ""}</span></div>
    <div id="atList" class="stack">${st.n ? "" : `<div class="empty"><b>🌍</b>${esc(tr("atlas_none"))}</div>`}</div>
    <p class="hint" style="margin-top:var(--s-3)">${esc(tr("atlas_include"))}:
      <label class="inline"><input type="checkbox" id="atInc" ${store.settings.includeAtlas ? "checked" : ""}> ${esc(tr("yes"))}</label></p>
    </section>`;

  const note = $("#atNote"), prog = st2 => {
    const bar = $("#atBar"), inn = $("#atBarIn");
    if (!bar || !inn) return;
    const p = st2.cap ? clamp(st2.pulled / st2.cap, 0, 1) : 0;
    bar.hidden = !st2.running;
    inn.style.width = Math.round(p * 100) + "%";
    note.textContent = st2.running ? tr("atlas_running") + " " + st2.pulled + "/" + st2.cap +
      (st2.fam ? " · " + st2.fam : "") + (st2.fams ? " · " + st2.doneFams + "/" + st2.fams + " ⊞" : "")
      : (st2.note || tr("atlas_done"));
  };
  $("#atCap").oninput = e => { $("#atCapOut").textContent = e.target.value; };
  on(app, "click", "[data-setcap]", (e, n) => { $("#atCap").value = n.dataset.setcap; $("#atCapOut").textContent = n.dataset.setcap; });
  /* One order at a time is how a 6,000-species atlas is reached in a sitting:
     Psittaciformes alone is a few hundred species, and the pages already
     fetched are answered from the device on the next run. */
  let orderList = null;
  const fillOrders = async () => {
    if (orderList) return orderList;
    $("#atOrder").innerHTML = `<option value="">…</option>`;
    try { orderList = await Atlas.orders(); } catch { orderList = []; }
    $("#atOrder").innerHTML = `<option value="">${esc(tr("atlas_all"))}</option>` +
      orderList.map(o => `<option value="${esc(String(o.key))}"${store.settings.atlasOrder === String(o.key) ? " selected" : ""}>${esc(o.name)}</option>`).join("");
    return orderList;
  };
  $("#atScope").onchange = async e => {
    const one = e.target.value === "order";
    $("#atOrderBox").hidden = !one;
    if (one) await fillOrders();
  };
  $("#atOrder").onchange = e => { store.settings.atlasOrder = e.target.value; store.persist(); };
  if ($("#atScope").value === "order") fillOrders();
  $("#atInc").onchange = e => { store.settings.includeAtlas = e.target.checked; store.persist(); AI.invalidate(); toast(tr("note_saved"), "ok"); };
  $("#atRun").onclick = async () => {
    $("#atRun").disabled = true; $("#atStop").disabled = false;
    store.settings.atlasCap = +$("#atCap").value; store.persist();
    const key = $("#atScope").value === "order" ? $("#atOrder").value : "";
    const name = key && $("#atOrder").selectedOptions[0] ? $("#atOrder").selectedOptions[0].textContent : "";
    if (key) store.settings.atlasOrder = key; else delete store.settings.atlasOrder;
    store.persist();
    const r = await Atlas.run({ cap: +$("#atCap").value, enrich: true, orderKey: key || undefined,
      orderName: name || undefined, onProg: prog });
    AI.invalidate();
    const nEl = $("#atN");
    if (!nEl) { toast(tr("atlas_enriched") + " " + r.added, "ok", 3600); route(); return; }
    $("#atRun").disabled = false; $("#atStop").disabled = true;
    toast(tr("atlas_enriched") + " " + r.added, "ok", 3600);
    const s2 = await Atlas.stats();
    nEl.textContent = s2.n; $("#atAr").textContent = s2.withAr + " / " + s2.n;
    $("#atImg").textContent = s2.withImg; $("#atFam").textContent = s2.fams;
    note.textContent = Atlas.state.note || tr("atlas_done"); $("#atBar").hidden = true;
    draw($("#atQ").value);
  };
  $("#atStop").onclick = () => { Atlas.stop(); };
  $("#atClear").onclick = async () => {
    if (!confirmDlg(tr("atlas_clear") + "?")) return;
    await Atlas.clear(); AI.invalidate(); toast(tr("atlas_cleared"), "info"); viewAtlas();
  };
  const rowsHTML = rows => rows.slice(0, 60).map(r => `<div class="row arow" data-sci="${esc(r.sci)}">
      ${r.img ? `<img loading="lazy" src="${esc(r.img)}" alt="" width="46" height="46" onerror="this.hidden=true" style="object-fit:cover;border-radius:8px">` : `<span class="chip">${esc(tr("atlas_noimg"))}</span>`}
      <div style="flex:1;min-width:0"><b><a href="#/atlas/${encodeURIComponent(r.sci)}">${esc(speciesName(r) || r.sci)}</a></b>
        <div class="hint">${esc(r.sci)} · ${esc(r.family || "")}${r.order ? " · " + esc(r.order) : ""}</div></div>
      <button class="btn sm ghost" data-sight="${esc(r.sci)}">📍 ${esc(tr("atlas_promote"))}</button></div>`).join("");
  const draw = q => {
    const all = Atlas.rows;
    const list = all.length ? (q.trim() ? Atlas.match(q, 60)
      : all.slice().sort((a, b) => String(speciesName(a) || a.sci).localeCompare(String(speciesName(b) || b.sci))).slice(0, 60)) : [];
    $("#atList").innerHTML = list.length ? rowsHTML(list) : `<div class="empty"><b>🔍</b>${esc(tr("no_results"))}</div>`;
    $("#atCount").textContent = String(list.length);
  };
  /* scored against every stored species, so at a five-figure atlas the field
     waits for the typing to stop before it walks the list */
  $("#atQ").oninput = debounce(e => draw(e.target.value), 140);
  on(app, "click", "[data-sight]", (e, n) => logSighting(Atlas.get(n.dataset.sight) || { sci: n.dataset.sight }));
  if (Atlas.rows.length) draw("");
}

/* ------------------------------------------------------- SOUND ID VIEW */
async function viewIdentify() {
  document.title = tr("nav_id") + " — Birds World";
  await Atlas.load();
  const es = await Acoustic.entries();
  app.innerHTML = `<section class="panel"><h2>🎙️ ${esc(tr("id_h"))}</h2>
    <p class="hint">${esc(tr("id_sub"))}</p>
    <div class="row" style="margin-top:var(--s-3)">
      <button class="btn" id="idRec">🎙 ${esc(tr("id_rec"))}</button>
      <label class="btn ghost" style="cursor:pointer">📁 ${esc(tr("id_fromfile"))}
        <input type="file" id="idFile" accept="audio/*" hidden></label>
      <button class="btn ghost" id="idTest">🧪 ${esc(tr("id_test"))}</button>
      <span class="spacer"></span><span class="hint" id="idTime"></span></div>
    <canvas id="idSpec" class="wave" height="150" aria-label="${esc(tr("id_feats"))}"></canvas>
    <div id="idOut" class="stack" style="margin-top:var(--s-3)"></div></section>

  <section class="panel"><h2>📚 ${esc(tr("id_lib"))}</h2>
    <div class="row"><label style="min-width:130px">${esc(tr("id_scope"))}</label>
      <select id="idScope">
        <option value="lib">${esc(tr("id_scope_lib"))}</option>
        <option value="fav">${esc(tr("id_scope_fav"))}</option>
        <option value="atlas"${Atlas.rows.length ? " selected" : ""}>${esc(tr("id_scope_atlas"))}</option></select>
      <button class="btn" id="idBuild">🧬 ${esc(tr("id_build"))}</button>
      <button class="btn ghost" id="idStop" disabled>${esc(tr("atlas_stop"))}</button>
      <span class="spacer"></span><button class="btn danger ghost" id="idClear">🗑 ${esc(tr("id_clearlib"))}</button></div>
    <p class="hint">${esc(tr("id_scope_hint"))}</p>
    <div class="bar" id="idBar" hidden><i id="idBarIn" style="width:0%"></i></div>
    <p class="hint" id="idLibNote">${esc(tr("id_indexed"))}: <b>${es.length}</b> ·
      ${es.reduce((a, r) => a + r.voices.length, 0)} ${esc(tr("id_lib"))}</p>
    <div id="idLib" class="grid">${es.length ? es.map(r => `<div class="card sm">
      <b>${esc(r.sci)}</b><div class="hint">${r.voices.length} ${esc(tr("id_indexed"))}</div>
      <div class="row" style="margin-top:6px"><button class="btn sm ghost" data-delref="${esc(r.sci)}">🗑</button>
        <a class="chip" href="${esc(r.voices[0].url)}" target="_blank" rel="noopener">${esc(tr("id_srclink"))}</a></div></div>`).join("")
      : `<div class="empty"><b>🎵</b>${esc(tr("id_none"))}</div>`}</div></section>`;

  const out = $("#idOut"), time = $("#idTime");
  const say = (html, kind) => { out.innerHTML = `<div class="banner ${kind || "info"}">${html}</div>`; };
  const show = fp => {
    if (!fp) return;
    say(`<b>${esc(tr("id_feats"))}</b>
      <div class="kb">${[[tr("id_pitch"), fp.dom + " kHz"], [tr("id_shape"), fp.pMed + " kHz"],
        [tr("id_rate2"), fp.rate], ["kHz max", fp.pMax], ["span", fp.span + "×"], ["voiced", Math.round(fp.voiced * 100) + "%"]]
        .map(([a, b]) => `<div class="kv"><span>${esc(a)}</span><b>${esc(String(b))}</b></div>`).join("")}</div>`, "info");
  };
  const report = async (fp, only) => {
    const q = Acoustic.quality(fp);
    if (!q.ok) { say(esc(q.why), "warn"); return; }
    show(fp);
    const rk = await Acoustic.identify(fp, only);
    if (!rk.length) { say(esc(tr("id_none")), "warn"); return; }
    const best = rk[0];
    out.insertAdjacentHTML("beforeend", `<h3>${esc(tr("id_cands"))}</h3>` + rk.slice(0, 5).map((r, i) => {
      const sp = SPECIES.find(b => b.sci === r.sci) || Atlas.get(r.sci);
      return `<div class="card sm"><div class="row">
        <b style="flex:1">${i + 1}. ${esc(sp ? speciesName(sp) : r.sci)}</b>
        <span class="chip">${r.conf}%</span><span class="hint">${esc(tr("id_conf"))} ${r.score}</span></div>
        <div class="hint">${esc(r.sci)} · ${r.agree}/${r.voices} ${esc(tr("id_indexed"))}
          ${sp && !sp.atlas ? `· <a href="#/bird/${sp.id}">${esc(tr("open"))}</a>` : ""}</div>
        <div class="kb">${r.why.map(([a, b, c]) => `<div class="kv"><span>${esc(a)}</span><b>${b}%${c ? " · " + esc(c) : ""}</b></div>`).join("")}</div>
        </div>`; }).join("") +
      `<p class="hint">${esc(tr("id_note"))}</p>`);
    const cv = $("#idSpec");
    if (cv) { const v = (best.row.voices || [])[0]; if (v) drawBands(cv, fp, v.fp); }
  };
  $("#idRec").onclick = async () => {
    if (!Acoustic.supported()) { say(esc(tr("id_mic_no")), "warn"); return; }
    try {
      const mr = await Acoustic.start();
      $("#idRec").disabled = true;
      let left = Math.round(CFG.VOICE.seconds * 2);
      time.textContent = tr("id_listening") + " " + (left / 2).toFixed(1) + "s";
      await new Promise(res => {
        const tick = setInterval(() => {
          left--; time.textContent = tr("id_listening") + " " + (left / 2).toFixed(1) + "s";
          if (left <= 0) { clearInterval(tick); res(); }
        }, 500);
      });
      try { mr.stop(); } catch { /* already stopped */ }
      const buf = await Acoustic.finish();
      $("#idRec").disabled = false; time.textContent = "";
      if (!buf) { say(esc(tr("id_noaudio")), "warn"); return; }
      await report(Acoustic.analyse(buf));
    } catch (e) {
      $("#idRec").disabled = false; time.textContent = "";
      say(esc(String((e && e.message) || e)), "warn");
    }
  };
  $("#idFile").onchange = async e => {
    const f = e.target.files[0]; if (!f) return;
    try {
      const ctx = audioCtx() || new (window.AudioContext || window.webkitAudioContext)();
      const buf = await ctx.decodeAudioData(await f.arrayBuffer());
      await report(Acoustic.analyse(buf));
    } catch (err) { say(esc(tr("id_noaudio") + " " + err.message), "warn"); }
  };
  $("#idTest").onclick = async () => {
    const want = { freq: 2600, notes: 9, dur: 2 };
    const fp = Acoustic.analyse(Acoustic.synth(want));
    const wrate = round(want.notes / want.dur, 2);
    const pass = Math.abs(fp.dom - want.freq / 1000) < 0.6 && Math.abs(fp.rate - wrate) / wrate < 0.34;
    say(`<b>${esc(tr("id_test"))}</b> · ${esc(AI.bi("expected", "المتوقع"))} ${want.freq / 1000} kHz / ${wrate} ${esc(tr("id_rate2"))}
      · ${esc(AI.bi("measured", "المقاس"))} ${fp.dom} kHz / ${fp.rate}<br>
      ${esc(pass ? tr("id_test_ok") : tr("id_test_fail"))}`, pass ? "ok" : "warn");
  };
  $("#idBuild").onclick = async () => {
    const scope = $("#idScope").value;
    const list = scope === "fav" ? SPECIES.filter(b => isFav(b.id)).map(b => b.sci)
      : scope === "atlas" ? Atlas.rows.slice(0, 40).map(r => r.sci)
      : SPECIES.map(b => b.sci);
    if (!list.length) { toast(tr("id_none"), "warn"); return; }
    $("#idBuild").disabled = true; $("#idStop").disabled = false; $("#idBar").hidden = false;
    await Acoustic.build(list, st => {
      const inn = $("#idBarIn"), note = $("#idLibNote");
      if (!inn || !note) return;
      inn.style.width = Math.round(100 * st.done / Math.max(1, st.total)) + "%";
      note.innerHTML = tr("id_building") + " " + st.done + "/" + st.total + (st.note ? " · " + esc(st.note) : "");
    });
    $("#idBuild").disabled = false; $("#idStop").disabled = true;
    const bar = $("#idBar"); if (bar) bar.hidden = true;
    /* only re-render if the user is still on this screen — the build can outlive the view */
    if (location.hash.startsWith("#/identify")) viewIdentify();
    else { const es2 = await Acoustic.entries(); toast(tr("id_indexed") + " " + es2.length, "ok", 3200); }
  };
  $("#idStop").onclick = () => { Acoustic.stopBuild(); };
  $("#idClear").onclick = async () => {
    if (!confirmDlg(tr("id_clearlib") + "?")) return;
    await Acoustic.clearLibrary(); toast(tr("id_libempty"), "info"); viewIdentify();
  };
  on(app, "click", "[data-delref]", async (e, n) => {
    await Acoustic.removeReference(n.dataset.delref); viewIdentify();
  });
}

/* ------------------------------------------------------------- AI VIEW */
const aiChat = { log: [], cancel: null, plain: [] };
const AI_KIND_KEY = { triage: "ai_triage", recommend: "ai_recommend", facts: "ai_facts",
  compare: "ai_compare", search: "ai_search", practice: "ai_practice" };
function viewAI() {
  document.title = tr("ai_h") + " — Birds World";
  const cloud = AI.cloudOn();
  app.innerHTML = `<section class="panel"><h2>🤖 ${esc(tr("ai_h"))}</h2>
    <p class="hint">${esc(cloud ? tr("ai_cloud_hint") : tr("ai_off"))}</p>
    <div class="row" style="margin-top:var(--s-3)">
      <input id="aiQ" placeholder="${esc(tr("ai_ph"))}" style="flex:1;min-width:240px" autocomplete="off">
      <button class="btn" id="aiGo">${esc(tr("ai_send"))}</button>
      <button class="btn ghost" id="aiMic" title="${esc(tr("voice_listen"))}">🎙</button>
      <button class="btn ghost" id="aiReset">↺ ${esc(tr("ai_reset"))}</button></div>
    <div class="row" style="margin-top:var(--s-2)">
      <span class="chip">${esc(tr(cloud ? "ai_cloud" : "ai_local"))}</span>
      <label class="inline" style="margin:0"><input type="checkbox" id="aiSpeak" ${store.settings.aiSpeak ? "checked" : ""}> ${esc(tr("ai_auto_speak"))}</label>
      <span id="aiCtx" class="row" style="margin:0"></span></div>
    <div class="row" style="margin-top:var(--s-2)">
      ${[["ai_triage", "لماذا طائري منفش الريش ولا يأكل؟"], ["ai_recommend", "طائر صغير هادئ رخيص للشقة"],
         ["ai_facts", "كم يعيش الببغاء الاسترالي وماذا يأكل؟"], ["ai_practice", "كم يطعم ٤ طيور وزنها ٤٥ غ في الشهر؟"],
         ["ai_compare", "قارن الكناري والزيبرا"]]
        .map(([k, q]) => `<button class="btn ghost sm qex" data-q="${esc(q)}">${esc(tr(k))}</button>`).join("")}
      </div>
    <div id="aiLog" class="stack" style="margin-top:var(--s-3)">${aiChat.log.length ? aiChat.log.join("") : `<div class="empty"><b>💬</b>${esc(tr("ai_empty"))}</div>`}</div>
    </section>`;
  const log = $("#aiLog");
  const push = html => {
    if (!aiChat.log.length) log.innerHTML = "";
    aiChat.log.push(html); log.insertAdjacentHTML("beforeend", html);
    window.scrollTo(0, document.body.scrollHeight);
  };
  const drawCtx = () => {
    const host = $("#aiCtx"); if (!host) return;
    const label = AI.ctxLabel();
    host.innerHTML = label
      ? `<span class="chip">🧠 ${esc(tr("ai_ctx"))}: ${esc(label)}</span><button class="btn ghost sm" data-clrctx>✕ ${esc(tr("ai_ctx_clear"))}</button>`
      : "";
  };
  const spkLabel = btn => {
    const S = window.speechSynthesis;
    btn.textContent = S && S.speaking ? "⏹ " + tr("ai_speak_stop") : "🔊 " + tr("ai_speak");
  };
  const ask = async raw => {
    const q = String(raw || "").trim(); if (!q) return;
    push(`<div class="card sm"><b>🧑</b> <span>${esc(q)}</span></div>`);
    $("#aiQ").value = "";
    const loc = AI.local(q);
    const src = `<span class="chip">${esc(tr(AI_KIND_KEY[loc.kind] || "ai_local"))}</span>`;
    const speakBtn = i => `<button class="btn ghost sm" data-spk="${i}">🔊 ${esc(tr("ai_speak"))}</button>`;
    if (!AI.cloudOn()) {
      const i = aiChat.plain.length;
      aiChat.plain.push(htmlToText(loc.html));
      push(`<div class="card sm">${src}<div style="margin-top:6px">${loc.html}</div>
        <div class="row" style="margin-top:6px">${speakBtn(i)}</div>
        <p class="hint">${esc(tr("ai_strip"))}</p></div>`);
      if (store.settings.aiSpeak) speak(aiChat.plain[i]);
      drawCtx();
      return;
    }
    const slot = document.createElement("div");
    slot.className = "card sm";
    const idx = aiChat.plain.length;
    aiChat.plain.push("");
    slot.innerHTML = `${src}<div class="hint">${esc(tr("ai_thinking"))}</div><div class="ai-body"></div>
      <div class="row" style="margin-top:6px">${speakBtn(idx)}</div>
      <p class="hint">${esc(tr("ai_src"))} ${esc(AI.bi("your records + ", "سجلاتك + "))}${esc(tr("atlas_h"))}.</p>`;
    if (!aiChat.log.length) log.innerHTML = "";
    aiChat.log.push("");
    log.appendChild(slot);
    const body = slot.querySelector(".ai-body");
    const ctl = new AbortController(); aiChat.cancel = ctl;
    let acc = "";
    try {
      const got = await AI.stream(q, txt => { acc += txt; body.textContent = acc; }, ctl.signal);
      if (!got) throw new Error(AI.bi("empty response", "رد فارغ"));
      aiChat.plain[idx] = acc;
      slot.querySelector(".hint").textContent = "☁ " + AI.cfg().model;
    } catch (e) {
      body.innerHTML = loc.html;
      aiChat.plain[idx] = htmlToText(loc.html);
      slot.querySelector(".hint").textContent = tr("ai_fail") + " — " + String((e && e.message) || e);
    } finally { aiChat.cancel = null; }
    if (store.settings.aiSpeak) speak(aiChat.plain[idx]);
    drawCtx();
  };
  $("#aiGo").onclick = () => ask($("#aiQ").value);
  $("#aiQ").onkeydown = e => { if (e.key === "Enter") ask(e.target.value); };
  $("#aiMic").onclick = () => startVoice(t => { $("#aiQ").value = t; ask(t); });
  $("#aiSpeak").onchange = e => { store.settings.aiSpeak = e.target.checked; store.persist(); if (!e.target.checked) stopSpeak(); };
  $("#aiReset").onclick = () => { aiChat.log = []; aiChat.plain = []; if (aiChat.cancel) aiChat.cancel.abort(); stopSpeak(); AI.ctxClear(); viewAI(); };
  on(app, "click", ".qex", (e, n) => ask(n.dataset.q));
  on(app, "click", "[data-clrctx]", () => { AI.ctxClear(); drawCtx(); });
  on(app, "click", "[data-spk]", (e, n) => {
    const S = window.speechSynthesis;
    if (S && S.speaking) { stopSpeak(); $$("[data-spk]").forEach(spkLabel); return; }
    const txt = aiChat.plain[num(n.dataset.spk, 0)] || "";
    if (!txt) return;
    if (speak(txt)) spkLabel(n);
    setTimeout(() => spkLabel(n), 900);
  });
  drawCtx();
}

function route() {
  detachAnalyser();
  stopSpeak();
  const h = location.hash || "#/";
  const detail = h.startsWith("#/bird/") ? h.slice(7) : null;
  const bird = h.startsWith("#/my-bird/") ? h.slice(10) : null;
  const view = detail ? () => viewDetail(decodeURIComponent(detail))
    : bird ? () => viewBird(bird)
    : h.startsWith("#/birds") ? viewBrowse
    : h.startsWith("#/find") ? viewWizard
    : h.startsWith("#/my-birds") ? viewBirds
    : h.startsWith("#/sightings") ? viewSightings
    : h.startsWith("#/learn") ? viewLearn
    : h.startsWith("#/atlas/") ? () => Atlas.load().then(() => viewAtlasSpecies(decodeURIComponent(h.slice(8))))
    : h.startsWith("#/atlas") ? viewAtlas
    : h.startsWith("#/identify") ? viewIdentify
    : h.startsWith("#/ai") ? viewAI
    : h.startsWith("#/settings") ? viewSettings
    : viewHome;
  /* atlas and sound-ID views await storage, so their failures arrive as a
     rejected promise rather than a thrown one — both paths show the same guard */
  const fail = err => {
    console.error(err);
    app.innerHTML = `<div class="panel banner danger">Runtime error: ${esc(err && err.message || String(err))}</div>`;
  };
  try {
    const r = view();
    if (r && typeof r.catch === "function") r.catch(fail);
  } catch (err) { fail(err); }
  renderNav(); setCompN();
  window.scrollTo(0, 0);
}

/* ----------------------------------------------------------------- 10. BOOT */
let deferredPrompt = null;
function showInstallButton(host) {
  if (!host || !deferredPrompt || store.settings.installHinted) return;
  const btn = el(`<button class="btn">⬇️ ${esc(tr("install"))}</button>`);
  btn.onclick = async () => {
    deferredPrompt.prompt();
    const { outcome } = await deferredPrompt.userChoice;
    if (outcome === "accepted") { award(10); toast(tr("install") + " ✓", "ok"); }
    deferredPrompt = null; btn.remove();
  };
  host.appendChild(btn);
}
function initChrome() {
  applyTheme();
  I18N.apply(lsGet("lang", localStorage.getItem("bw_lang")) || (document.documentElement.lang || "en"));
  $("#btnTheme").onclick = () => {
    store.settings.theme = store.settings.theme === "dark" ? "light" : store.settings.theme === "light" ? "auto" : "dark";
    store.persist(); applyTheme(); toast(tr("theme") + ": " + store.settings.theme, "info", 1400);
  };
  $("#btnLang").onclick = () => { I18N.apply(I18N.lang === "en" ? "ar" : "en"); route(); };
  $("#btnCompare").onclick = openCompare;
  $("#dlgClose").onclick = closeDlg;
  $("#lbClose").onclick = () => $("#lightbox").close();
  $("#dlg").addEventListener("click", e => { if (e.target.id === "dlg") closeDlg(); });
  $("#lightbox").addEventListener("click", e => { if (e.target.id === "lightbox") $("#lightbox").close(); });
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => { if (store.settings.theme === "auto") applyTheme(); });

  const net = () => {
    const on = navigator.onLine;
    $("#netState").textContent = "● " + tr(on ? "net_on" : "net_off");
    $("#netState").style.color = on ? "var(--ok-fg)" : "var(--danger-fg)";
    if (on && store.outbox.all().length && remote.enabled()) remote.syncAll();
    if (!remote.enabled() && store.outbox.all().length) { store.outbox.items = []; store.outbox.flush(); }
  };
  window.addEventListener("online", () => { net(); toast(tr("online"), "ok"); });
  window.addEventListener("offline", () => { net(); toast(tr("offline"), "warn"); });
  net();

  document.addEventListener("keydown", e => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName) || e.target.isContentEditable;
    if (e.key === "/" && !typing) { e.preventDefault(); if (location.hash !== "#/birds") location.hash = "#/birds"; setTimeout(() => $("#q") && $("#q").focus(), 60); return; }
    if (typing) return;
    const jump = { h: "#/", b: "#/birds", f: "#/find", m: "#/my-birds", s: "#/sightings", l: "#/learn", g: "#/settings" };
    if (e.key === "t") $("#btnTheme").click();
    else if (e.key === "y") $("#btnLang").click();
    else if (e.key === "c") openCompare();
    else if (jump[e.key] && location.hash !== jump[e.key]) location.hash = jump[e.key];
  });

  window.addEventListener("hashchange", route);
  window.addEventListener("beforeprint", () => { const t = $$("#tabs [data-t]"); if (t.length) t.forEach(x => $("#p-" + x.dataset.t).hidden = false); });

  if (DATA_ISSUES.length) {
    const bar = el(`<div class="shell"><div class="banner warn" style="margin-top:var(--s-3)">
      Data check: ${DATA_ISSUES.length} issue(s) — ${esc(DATA_ISSUES.slice(0, 3).join("; "))}</div></div>`);
    document.body.insertBefore(bar, $("main"));
  }
  if ("serviceWorker" in navigator && location.protocol !== "file:") {
    navigator.serviceWorker.register("sw.js")
      .then(r => { r.update(); r.addEventListener("updatefound", () => toast(tr("sw_update"), "info", 5000)); })
      .catch(err => console.warn("SW:", err.message));
  }
  window.addEventListener("beforeinstallprompt", e => { e.preventDefault(); deferredPrompt = e; if (location.hash.startsWith("#/settings")) viewSettings(); });
}
initChrome();
route();
</script>
</body>
</html>
