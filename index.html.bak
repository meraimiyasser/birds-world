const SPECIES = RAW.map((r, i) => {
  const [sizeMin, sizeMax] = parseRange(r.size), [lifeMin, lifeMax] = parseRange(r.life);
  return {
    id: slug(r.en) || "sp-" + i,
    en: r.en, ar: r.ar || "", sci: r.sci, g: r.g, origin: r.origin,
    size: r.size, life: r.life, sizeMin, sizeMax, lifeMin, lifeMax,
    tip: r.tip, wiki: r.en, file: r.file || "",
    img: r.file ? "https://commons.wikimedia.org/wiki/Special:FilePath/" +
      encodeURIComponent(r.file.replace(/ /g, "_")) + "?width=" + CFG.API.thumbPx : "",
    difficulty: r.t[0], noise: r.t[1], space: r.t[2], cost: r.t[3], sociability: r.t[4],
    longevity: lifeMax, talk: !!GROUPS[r.g].talk,
  };
});

function validateData() {
  const problems = [];
  const seen = new Set();
  SPECIES.forEach(b => {
    if (!b.id) problems.push("species with empty id");
    if (seen.has(b.id)) problems.push("duplicate id: " + b.id);
    seen.add(b.id);
    if (!GROUPS[b.g]) problems.push(b.id + ": unknown group " + b.g);
    TRAITS.forEach(([k, lo, hi]) => {
      const v = k === "longevity" ? b.longevity : b[k];
      if (k !== "longevity" && (!Number.isInteger(v) || v < lo || v > hi)) problems.push(b.id + ": " + k + " out of range");
    });
    if (!(b.sizeMin >= 0 && b.sizeMax >= b.sizeMin)) problems.push(b.id + ": bad size range");
  });
  return problems;
}
const DATA_ISSUES = validateData();

/* ------------------------------------------------------------------- 5. STORE */
const lsGet = (k, fallback) => { try { const v = localStorage.getItem(CFG.NS + ":" + k); return v == null ? fallback : JSON.parse(v); } catch { return fallback; } };
const lsSet = (k, v) => {
  try { localStorage.setItem(CFG.NS + ":" + k, JSON.stringify(v)); return true; }
  catch { toast(tr("sto_full"), "error", 4200); return false; }
};

class Collection {
  constructor(key) { this.key = key; this.items = lsGet(key, []); }
  all() { return this.items; }
  get(id) { return this.items.find(x => x.id === id); }
  add(rec) { const row = { id: rec.id || uid(), ...rec }; this.items.unshift(row); this.flush(); return row; }
  put(id, patch) { const i = this.items.findIndex(x => x.id === id); if (i < 0) return null;
    this.items[i] = { ...this.items[i], ...patch }; this.flush(); return this.items[i]; }
  del(id) { this.items = this.items.filter(x => x.id !== id); this.flush(); }
  flush() { lsSet(this.key, this.items); }
  reload() { this.items = lsGet(this.key, []); }
}

const store = {
  settings: Object.assign({ theme: "auto", accent: 162, apiBase: "", xenoKey: "", lastSync: 0, installHinted: false,
    aiBase: "", aiKey: "", aiModel: "", includeAtlas: false, atlasCap: CFG.ATLAS.defaultCap,
    /* iNaturalist hides sound file URLs behind authentication (measured), so a
       read token is what turns it into a usable recording source. Tokens and
       keys never leave this device and are stripped from every backup export. */
    inatToken: "", songSource: "auto", aiSpeak: false, speakRate: 1, songMaxMb: 220, atlasOrder: "" }, lsGet(KEYS.settings, {})),
  favs: new Set(lsGet(KEYS.fav, [])),
  notes: lsGet(KEYS.note, {}),
  visits: new Set(lsGet(KEYS.visits, [])),
  compare: [],
  saved: new Collection(KEYS.saved),
  birds: new Collection(KEYS.birds),
  sightings: new Collection(KEYS.sightings),
  tasks: new Collection("tasks"),
  weights: new Collection("weights"),
  symptoms: new Collection("symptoms"),
  cards: lsGet(KEYS.cards, {}),
  progress: Object.assign({ points: 0, streak: 0, best: 0, lastDay: "", reviews: 0, quizzes: 0 }, lsGet(KEYS.score, {})),
  outbox: new Collection(KEYS.outbox),
  persist() {
    lsSet(KEYS.settings, this.settings); lsSet(KEYS.fav, Array.from(this.favs));
    lsSet(KEYS.note, this.notes); lsSet(KEYS.visits, Array.from(this.visits));
    lsSet(KEYS.cards, this.cards); lsSet(KEYS.score, this.progress);
  },
};

/* Adopt data written by older builds of this project. */
(function migrate() {
  if (lsGet("version", 0) >= CFG.VERSION) return;
  const legacy = { bw_fav_pro: KEYS.fav, bw_notes_pro: KEYS.note, bw_visited: KEYS.visits, bw_sightings: KEYS.sightings };
  for (const [oldKey, newKey] of Object.entries(legacy)) {
    if (localStorage.getItem(CFG.NS + ":" + newKey) !== null) continue;
    const raw = localStorage.getItem(oldKey);
    if (!raw) continue;
    try {
      const val = JSON.parse(raw);
      if (newKey === KEYS.sightings)
        lsSet(newKey, (Array.isArray(val) ? val : []).map(s => ({ id: uid(), speciesId: s.id, species: s.name, date: s.date || new Date().toISOString() })));
      else lsSet(newKey, val);
    } catch { /* unreadable legacy blob — keep the clean slate */ }
  }
  const theme = localStorage.getItem("bw_theme_pro");
  if (theme && !localStorage.getItem(CFG.NS + ":" + KEYS.settings)) lsSet(KEYS.settings, { theme, accent: 162, apiBase: "", lastSync: 0 });
  lsSet("version", CFG.VERSION);
})();

/* -------------------------------------------------------------- INDEXEDDB */
let dbPromise = null;
function idb() {
  if (!dbPromise) dbPromise = new Promise((res, rej) => {
    const rq = indexedDB.open(CFG.DB.name, CFG.DB.version);
    rq.onupgradeneeded = () => { if (!rq.result.objectStoreNames.contains(CFG.DB.media)) rq.result.createObjectStore(CFG.DB.media); };
    rq.onsuccess = () => res(rq.result);
    rq.onerror = () => rej(rq.error);
    rq.onblocked = () => rej(new Error("IndexedDB blocked by another tab"));
  }).catch(e => { console.warn("IndexedDB unavailable:", e.message); return null; });
  return dbPromise;
}
async function idbRun(storeName, mode, fn) {
  const d = await idb(); if (!d) return null;
  return new Promise((res, rej) => {
    const tx = d.transaction(storeName, mode), rq = fn(tx.objectStore(storeName));
    tx.oncomplete = () => res(rq && rq.result); tx.onerror = () => rej(tx.error);
  }).catch(e => { console.warn("idbRun:", e.message); return null; });
}
const idbGet = key => idbRun(CFG.DB.media, "readonly", s => s.get(key));
const idbPut = (key, val) => idbRun(CFG.DB.media, "readwrite", s => s.put(val, key));
const idbDel = key => idbRun(CFG.DB.media, "readwrite", s => s.delete(key));

/* --------------------------------------------------------------------- 6. API */
const inflight = new Map();
async function req(url, { timeout = CFG.API.timeoutMs, expect = "json" } = {}) {
  const ac = new AbortController();
  const timer = setTimeout(() => ac.abort(), timeout);
  try {
    const r = await fetch(url, { signal: ac.signal, headers: expect === "json" ? { Accept: "application/json" } : {} });
    if (!r.ok) throw new Error("HTTP " + r.status);
    return expect === "json" ? await r.json() : await r.blob();
  } finally { clearTimeout(timer); }
}
function once(url, opts) {
  if (!inflight.has(url)) inflight.set(url, req(url, opts).finally(() => inflight.delete(url)));
  return inflight.get(url);
}

/* Network → IndexedDB → memory, so the guide keeps working with no connection. */
async function cachedJSON(kind, key, url) {
  const idKey = kind + ":" + key;
  if (cachedJSON.mem.has(idKey)) return cachedJSON.mem.get(idKey);
  let out = null, fromNet = false;
  try { out = await once(url); fromNet = true; }
  catch { const hit = await idbGet(idKey); out = hit && hit.data !== undefined ? hit.data : hit; }
  if (out) {
    cachedJSON.mem.set(idKey, out);
    if (fromNet) idbPut(idKey, { at: Date.now(), data: out });
  }
  return out;
}
cachedJSON.mem = new Map();

const commonsThumb = (file, px = CFG.API.thumbPx) => "https://commons.wikimedia.org/wiki/Special:FilePath/" +
  encodeURIComponent(file.replace(/ /g, "_")) + "?width=" + px;

/* Thumbnail hosts reject resized paths that carry percent-escaped punctuation,
   but Special:FilePath always resolves. Recover the Commons filename instead. */
const wikiFile = src => {
  const path = String(src).split("?")[0].split("#")[0];
  return decodeURIComponent(path.slice(path.lastIndexOf("/") + 1)).replace(/^\d+px-/, "");
};

async function wikiSummary(title) {
  const key = slug(title);
  const raw = await cachedJSON("wiki", key, CFG.API.wiki + encodeURIComponent(title.replace(/ /g, "_")));
  if (!raw) return null;
  const th = raw.thumbnail && raw.thumbnail.source;
  const full = (raw.originalimage && raw.originalimage.source) || "";
  return {
    img: th ? commonsThumb(wikiFile(th)) : commonsThumb(wikiFile(full)),
    file: (th || full) ? wikiFile(th || full) : "",
    full,
    text: raw.extract || "",
    page: (raw.content_urls && raw.content_urls.desktop && raw.content_urls.desktop.page) || "https://en.wikipedia.org/wiki/" + encodeURIComponent(title.replace(/ /g, "_")),
  };
}

async function imageCredit(src) {
  const m = String(src).match(/FilePath\/([^?]+)/);
  const guess = m ? decodeURIComponent(m[1]) : wikiFile(src);
  if (!/\.(jpe?g|png|webp|gif|tiff)$/i.test(guess)) return null;
  const file = guess.replace(/_/g, " ");
  const url = CFG.API.commons + "?action=query&prop=imageinfo&iiprop=extmetadata|url&format=json&origin=*&titles=" +
    encodeURIComponent("File:" + file);
  const raw = await cachedJSON("credit", file, url);
  const page = raw && raw.query && Object.values(raw.query.pages)[0];
  const x = page && page.imageinfo && page.imageinfo[0] && page.imageinfo[0].extmetadata;
  if (!x) return null;
  const clean = h => (h ? String(h).replace(/<[^>]*>/g, "").replace(/\s+/g, " ").trim() : "");
  return { file, artist: clean(x.Artist && x.Artist.value), license: clean(x.LicenseShortName && x.LicenseShortName.value),
    usage: clean(x.LicenseUrl && x.LicenseUrl.value) };
}

/* Last resort for species whose article ships no lead image: first Commons hit
   for the scientific name. */
async function commonsFirstImage(query) {
  const url = CFG.API.commons + "?action=query&generator=search&gsrnamespace=6&gsrlimit=1" +
    "&gsrsearch=" + encodeURIComponent(query) + "&prop=imageinfo&iiprop=url|size&iiurlwidth=" +
    CFG.API.thumbPx + "&format=json&origin=*";
  const raw = await cachedJSON("cimg", query, url);
  const pages = raw && raw.query && raw.query.pages;
  const p = pages && Object.values(pages)[0];
  return (p && p.imageinfo && p.imageinfo[0] && (p.imageinfo[0].thumburl || p.imageinfo[0].url)) || "";
}

/* Walk a list of candidate URLs until one actually loads, else keep the emoji. */function tryImgs(img, urls, done) {
  let i = 0;
  const next = ok => {
    if (ok) { img.classList.add("loaded"); done(true); return; }
    while (i < urls.length && !urls[i]) i++;
    if (i >= urls.length) { done(false); return; }
    const u = urls[i++];
    img.onerror = () => next(false);
    img.onload = () => next(true);
    img.src = u;
  };
  next(false);
}
async function loadPhoto(box, b, px) {
  const ph = box.querySelector(".ph"), img = box.querySelector("img");
  if (!img) return;
  const urls = [];
  if (b.file) urls.push(commonsThumb(b.file, px));
  const w = await wikiSummary(b.wiki).catch(() => null);
  if (w && w.file) {
    const u = commonsThumb(w.file, px);
    b._wikiImg = u;
    urls.push(u, w.full);
  }
  if (!urls.length) {
    const hit = await commonsFirstImage(b.sci).catch(() => "");
    if (hit) { b._wikiImg = hit; urls.push(hit); }
  }
  if (!urls.length) { if (ph) ph.hidden = false; return; }
  tryImgs(img, urls, ok => { if (ph) ph.hidden = !!ok; if (!ok) img.removeAttribute("src"); });
}

/* Xeno-canto v3 needs an API key. It is sent from this device only when the user
 * supplies one; with a community backend configured, the key stays server-side. */
function xenoConfigured() { return !!(store.settings.xenoKey || remote.enabled()); }
async function xenoRecordings(b, qty = 6) {
  const q = 'sp:"' + b.sci + '"';
  const url = remote.enabled()
    ? remote.base + "/recordings?query=" + encodeURIComponent(q)
    : CFG.API.xeno + "?query=" + encodeURIComponent(q) + "&key=" + encodeURIComponent(store.settings.xenoKey) + "&page=1";
  const raw = await cachedJSON("xeno", slug(b.sci), url);
  const list = (raw && raw.recordings) || [];
  return list.slice(0, qty).map(r => ({
    id: r.id, file: String(r.file || r.url || "").replace(/^http:/, "https:"), page: r.url || "",
    who: r.rec || "Unknown", where: [r.loc, r.cnt].filter(Boolean).join(" · "),
    length: r.length || r.len, date: r.date, notes: r.rmk || "",
  })).filter(r => r.file);
}

/* -------------------------------------------------- SONGS: real recordings */
/* A species page that only plays a synthesized chirp is a chart, not a record.
 * This module goes to the catalogues that actually hold a bird's voice and
 * keeps the answer honest: source, licence and a link back to the recorder.
 *
 * Measured behaviour (browser, 2026-10-17):
 *   Wikimedia Commons — keyless and CORS-readable, freely licensed, and rich
 *       for wild species because many files are Xeno-canto mirrors named
 *       "Genus species - Common Name XC123456.mp3". Thin for cage birds that
 *       were never recorded in the field.
 *   Xeno-canto v3     — the deepest catalogue that exists; v2 is retired
 *       (HTTP 404) and v3 answers 401 until the user pastes a free key.
 *   iNaturalist v2    — filters correctly by media_type=sound and returns
 *       photos, but sounds:[] for anonymous calls: file URLs need a read
 *       token, so it only becomes a source once the user adds one.
 *   Internet Archive  — readable, but its bird audio is albums and podcasts
 *       rather than per-species files: kept as a last resort only.
 * Commons returns nothing for a quoted phrase on most names, so queries stay
 * unquoted and relevance is decided here, in the open, on the filename. */
const Song = {
  fmt: /\.(mp3|m4a|aac|ogg|oga|opus|wav|flac)$/i,
  mem: new Map(),
  SRC: { commons: ["Wikimedia Commons", "🌐"], xeno: ["Xeno-canto", "🎙️"], inat: ["iNaturalist", "🔎"],
         archive: ["Internet Archive", "🗄️"] },

  /* Commons files spoken-pronunciation clips beside real recordings. They
     sound like a person saying the name, which is worse than silence. */
  isSpeech(name) {
    const t = String(name);
    return /^(LL-Q|[a-z]{2}(?:-[a-z]{2})?-)/.test(t) || /pronunciation|\(eng\)-|say the name/i.test(t);
  },
  score(item, b) {
    const t = slug(item.file || item.title || "");
    if (!t) return 0;
    const parts = slug(b.sci || "").split("-"), gen = parts[0], epi = parts.slice(1).join("-");
    let v = 0;
    if (gen && epi && t.includes(gen + "-" + epi)) v += 5;
    else { if (gen && t.includes(gen)) v += 2; if (epi && t.includes(epi)) v += 2; }
    if (b.en && t.includes(slug(b.en))) v += 4;
    else {
      const words = String(b.en || "").toLowerCase().split(/\s+/).filter(w => w.length > 3 && slug(w));
      v += Math.min(2, words.filter(w => t.includes(slug(w))).length);
    }
    if (/xc\d{4,}/.test(t)) v += 1;
    if (this.isSpeech(item.file || item.title)) v -= 7;
    if (/human|talking person|alarm|traffic/.test(t)) v -= 2;
    return v;
  },
  /* keep only what a browser can actually play, then the trustworthy names */
  filter(items, b, min = 2) {
    return items.map(x => Object.assign({}, x, { conf: this.score(x, b) }))
      .filter(x => this.fmt.test(String(x.file || x.title || "")))
      .filter(x => x.conf >= min && !this.isSpeech(x.file || x.title))
      .sort((a, c) => c.conf - a.conf || (a.kb || 0) - (c.kb || 0));
  },
  clean(html) { return String(html || "").replace(/<[^>]*>/g, "").replace(/\s+/g, " ").trim(); },

  /* --- provider 1: Wikimedia Commons, no key, the default everywhere ------- */
  commonsUrl(q) {
    return CFG.API.commons + "?action=query&generator=search&gsrnamespace=6&gsrlimit=20&maxlag=5" +
      "&prop=imageinfo&iiprop=" + encodeURIComponent("url|mime|size|extmetadata") +
      "&format=json&origin=*&gsrsearch=" + encodeURIComponent(q);
  },
  async commons(b) {
    const names = [b.sci, b.en].filter(Boolean);
    const qs = uniq(names.map(n => "filetype:audio " + n)).filter(q => q.length > 18);
    const out = [];
    for (const q of qs) {
      let raw = null;
      try { raw = await cachedJSON("songq", slug(q), this.commonsUrl(q)); } catch { raw = null; }
      const pages = Object.values((raw && raw.query && raw.query.pages) || {});
      for (const p of pages) {
        const i = (p.imageinfo || [])[0] || {}, m = i.extmetadata || {};
        const file = String(p.title || "").replace(/^File:/, "");
        out.push({ src: "commons", file, title: file, url: i.url, mime: i.mime,
          kb: Math.round((i.size || 0) / 1024), secs: num(i.duration, 0) || num(m.Duration && m.Duration.value, 0),
          who: this.clean(m.Artist && m.Artist.value) || "Wikimedia contributor",
          lic: this.clean(m.LicenseShortName && m.LicenseShortName.value) || "free licence",
          page: CFG.API.commonsSite + encodeURIComponent(file.replace(/ /g, "_")) });
      }
      if (out.length >= 14) break;                 /* enough: stay polite */
      await nap(140);
    }
    return this.filter(out, b);
  },

  /* --- provider 2: Xeno-canto, only with a key (v3 measures 401 without) -- */
  async xeno(b) {
    if (!xenoConfigured()) return [];
    let recs = [];
    try { recs = await xenoRecordings(b, 8); } catch { return []; }
    return this.filter(recs.map(r => ({ src: "xeno", file: String(r.file).split("/").pop(), title: r.file,
      url: r.file, page: r.page, who: r.who, where: r.where, when: r.date, kb: 0, secs: num(r.length, 0),
      lic: "CC, Xeno-canto terms" })), b, 1);
  },

  /* --- provider 3: iNaturalist, needs the read token the user supplies ---- */
  async inat(b) {
    const tok = store.settings.inatToken;
    if (!tok || !b.sci) return [];
    try {
      const tx = await req(CFG.API.inat + "/v1/taxons?q=" + encodeURIComponent(b.sci) + "&per_page=1&fields[taxons][]=id");
      const id = tx && tx.results && tx.results[0] && tx.results[0].id;
      if (!id) return [];
      const u = CFG.API.inat + "/v2/observations?taxon_id=" + id + "&media_type=sound&per_page=8" +
        "&fields[observations][]=uuid&fields[observations][]=location&fields[observations][]=observed_on" +
        "&fields[sounds][]=file_url&fields[sounds][]=file_flags&fields[users][]=login";
      const r = await fetch(u, { headers: { Accept: "application/json", Authorization: "Bearer " + tok } });
      if (!r.ok) throw new Error("HTTP " + r.status);
      const j = await r.json();
      const items = [];
      for (const o of (j.results || [])) {
        const s = (o.sounds || [])[0]; if (!s || !s.file_url) continue;
        items.push({ src: "inat", file: String(s.file_url).split("/").pop(), title: String(s.file_url).split("/").pop(),
          url: s.file_url.replace(/^http:/, "https:"), page: CFG.API.inatSite + "/observations/" + o.uuid,
          who: (o.user && o.user.login) || "iNaturalist", where: o.location ? round(num(o.location.split(",")[0]), 3) + "°" : "",
          when: o.observed_on, lic: (s.file_flags || []).join(", ") || "iNaturalist terms", kb: 0 });
      }
      return this.filter(items, b, 1);
    } catch { return []; }
  },

  /* --- merge, cache, refresh --------------------------------------------- */
  enabled() {
    return ["commons"].concat(xenoConfigured() ? ["xeno"] : [], store.settings.inatToken ? ["inat"] : []);
  },
  async for(b, opts = {}) {
    if (!b || (!b.sci && !b.en)) return [];
    const key = slug(b.sci || b.en);
    if (!opts.refresh && this.mem.has(key)) return this.mem.get(key);
    const want = opts.only || this.enabled();
    let out = [];
    for (const src of want) {
      const fn = this[src]; if (!fn) continue;
      let list = [];
      try { list = await fn.call(this, b); } catch { list = []; }
      out = out.concat(list);
    }
    const seen = {};
    out = out.filter(x => { const k = slug(x.url); if (seen[k]) return false; seen[k] = 1; return true; })
      .sort((a, c) => c.conf - a.conf).slice(0, 14);
    this.mem.set(key, out);
    return out;
  },
  forget(sci) { const k = slug(sci); this.mem.delete(k); },

  /* How much of the guide actually has a real voice today? Asked, measured,
     answered with a number instead of a promise. */
  async probe(n = 12, onProg) {
    const pool = shuffle(SPECIES.slice());
    let tested = 0, found = 0; const ex = [];
    for (const b of pool) {
      if (tested >= n || !pool.length) break;
      tested++;
      this.forget(b.sci);
      let items = [];
      try { items = await this.for(b, { only: ["commons"] }); } catch { items = []; }
      if (items.length) { found++; if (ex.length < 4) ex.push(b.en || b.sci); }
      if (onProg) onProg(tested, found);
      await nap(130);
    }
    return { tested, found, ex };
  },

  /* --- offline copies: IndexedDB blob + a localStorage index -------------- */
  bkey(url) { return "songblob:" + slug(url).slice(-72); },
  index() { return lsGet(KEYS.songs, []); },
  saved(url) { return this.index().find(x => x.url === url) || null; },
  savedBytes() { return sum(this.index().map(x => x.kb || 0)) * 1024; },
  async save(item) {
    const blob = await req(item.url, { expect: "blob", timeout: 40000 });
    if (!blob || !blob.size) throw new Error(tr("song_fail"));
    const kb = Math.round(blob.size / 1024), cap = (store.settings.songMaxMb || 220) * 1024;
    if (this.savedBytes() + kb > cap) { toast(tr("song_quota"), "warn"); return false; }
    await idbPut(this.bkey(item.url), blob);
    const idx = this.index();
    idx.unshift({ url: item.url, file: item.file || item.title, kb, sci: item.sci || "", at: Date.now() });
    lsSet(KEYS.songs, idx.slice(0, 400));
    toast(tr("song_saved"), "ok");
    return true;
  },
  async drop(url) {
    await idbDel(this.bkey(url));
    lsSet(KEYS.songs, this.index().filter(x => x.url !== url));
    if (this._obj) { this._obj.forEach(u => URL.revokeObjectURL(u)); this._obj = new Map(); }
    return true;
  },
  _obj: new Map(),
  async wipeOffline() {
    for (const x of this.index()) await idbDel(this.bkey(x.url));
    lsSet(KEYS.songs, []);
    this._obj.forEach(u => URL.revokeObjectURL(u));
    this._obj = new Map();
  },
  async localUrl(url) {
    if (this._obj.has(url)) return this._obj.get(url);
    const blob = await idbGet(this.bkey(url));
    if (!blob) return "";
    const u = URL.createObjectURL(blob);
    this._obj.set(url, u);
    return u;
  },
  async play(item, el, wave, spec) {
    const src = (await this.localUrl(item.url)) || item.url;
    const go = cross => new Promise((res, rej) => {
      if (cross) el.setAttribute("crossorigin", "anonymous"); else el.removeAttribute("crossorigin");
      el.src = src; el.load();
      el.play().then(() => res(true), rej);
    });
    /* A crossOrigin element refuses a host that withholds CORS. Losing the
       live spectrogram is a far smaller loss than losing the bird's voice, so
       the plain request is the fallback. */
    try { await go(true); if (wave || spec) attachAnalyser(el, wave, spec); return true; }
    catch { try { await go(false); return true; } catch { toast(tr("play_block"), "warn"); return false; } }
  },
};

/* One list markup + one click path, reused by the species page, the atlas
 * page and the sound quiz so a recording behaves identically everywhere. */
function songMarkup(items, opts = {}) {
  if (!items || !items.length) return "";
  const ar = I18N.lang === "ar";
  return items.map((r, i) => {
    const s = Song.SRC[r.src] || [r.src, "🎧"];
    const meta = [r.who, r.where, r.lic, r.kb ? r.kb + " KB" : "", r.secs ? round(r.secs, 0) + "s" : ""].filter(Boolean).join(" · ");
    const off = Song.saved(r.url);
    return `<div class="bird-item"><div class="avatar">${s[1]}</div>
      <div style="min-width:0">
        <b>${esc(ar ? "تسجيل حقيقي" : "Field recording")}</b>
        <span class="chip" style="margin-inline-start:6px">${esc(s[0])}</span>
        ${r.conf >= 5 ? `<span class="chip">${esc(tr("song_exact"))}</span>` : ""}
        ${off ? `<span class="chip ok">⬇ ${esc(tr("song_offline"))}</span>` : ""}
        <div class="hint" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:min(92vw,520px)">${esc(r.file || r.title || "")}</div>
        <div class="hint">${esc(meta)}</div>
        ${r.page ? `<div class="hint"><a target="_blank" rel="noopener noreferrer" href="${esc(r.page)}">${esc(tr("song_credit"))} ↗</a></div>` : ""}
      </div>
      <div class="row" style="flex-direction:column;gap:4px">
        <button class="btn sm" data-song="${i}">▶</button>
        <button class="btn sm ghost" data-dl="${i}">${off ? "🗑" : "⬇"}</button></div>
    </div>`;
  }).join("");
}
function wireSongs(host, items, el, wave, spec, after) {
  on(host, "click", "[data-song]", async (e, n) => {
    const r = items[+n.dataset.song]; if (!r) return;
    e.preventDefault();
    await Song.play(r, el, wave, spec);
  });
  on(host, "click", "[data-dl]", async (e, n) => {
    const r = items[+n.dataset.dl]; if (!r) return;
    e.preventDefault();
    if (Song.saved(r.url)) { await Song.drop(r.url); toast(tr("song_removed"), "ok"); }
    else { n.textContent = "…"; try { await Song.save(Object.assign({}, r)); } catch { toast(tr("song_fail"), "warn"); } }
    if (after) after();
  });
}


/* The world checklist walks the GBIF backbone (class → order → family → genus →
 * species) and enriches each family with ONE Wikidata query per 60 names, which
 * is what keeps a whole class inside a polite request budget. Imported rows carry
 * no husbandry traits: nothing is invented, and the interface says so. */
const Atlas = {
  rows: [], bySci: new Map(), byFam: new Map(),
  meta: { fams: [], total: 0, at: 0 },
  state: { running: false, cancel: false, phase: "", pulled: 0, cap: 0, fam: "", note: "" },
  loaded: false,
  _p: null,

  key(fk) { return "atlas:fam:" + fk; },
  count() { return this.rows.length; },
  get(sci) { return this.bySci.get(sci); },
  families() { return (this.meta.fams || []).slice().sort((a, b) => String(a.name).localeCompare(String(b.name))); },

  /* One shared read promise: a second caller that arrives while IndexedDB is
     still answering must wait for the same result, not get an empty array. */
  _p: null,
  load() {
    if (this._p) return this._p;
    this._p = (async () => {
      const meta = await idbGet("atlas:meta");
      if (meta && meta.fams && meta.fams.length) {
        this.meta = meta;
        const chunks = await Promise.all(meta.fams.map(f => idbGet(this.key(f.key))));
        meta.fams.forEach((f, i) => (chunks[i] || []).forEach(r => this.adopt(r, f.key)));
        this.meta.total = this.rows.length;
      }
      /* rows written before the label guard can still hold a non-Arabic "ar" */
      for (const r of this.rows) if (r.ar && !isArabicName(r.ar)) r.ar = "";
      if (this.rows.length) this.backfillNames();
      return this.rows;
    })().catch(() => { this._p = null; return this.rows; });
    return this._p;
  },
  /* The curated guide's Arabic name column is not finished. An import carries
     Wikidata Arabic labels, so fill an empty curated cell only from an exact
     scientific-name match — copied from the source, never invented here. */
  backfillNames() {
    let n = 0;
    for (const b of SPECIES) {
      if (b.ar) continue;
      const a = this.bySci.get(b.sci);
      if (a && isArabicName(a.ar) && a.ar !== b.en) { b.ar = a.ar; n++; }
    }
    if (n && typeof AI !== "undefined") AI.invalidate();
    return n;
  },
  adopt(r, fk) {    if (!r || !r.sci || this.bySci.has(r.sci)) return;
    r.atlas = true;
    this.bySci.set(r.sci, r);
    this.rows.push(r);
    if (!this.byFam.has(fk)) this.byFam.set(fk, []);
    this.byFam.get(fk).push(r);
  },
  async flushFam(fk) {
    const rows = this.byFam.get(fk) || [];
    await idbPut(this.key(fk), rows);
    const head = rows[0] || {};
    let f = this.meta.fams.find(x => x.key === fk);
    if (!f) { f = { key: fk }; this.meta.fams.push(f); }
    f.name = head.family || f.name || ""; f.order = head.order || f.order || ""; f.n = rows.length;
    this.meta.total = this.rows.length; this.meta.at = Date.now();
    await idbPut("atlas:meta", this.meta);
  },

  /* One page of the backbone, mirrored to IndexedDB: a 6,000-species pull runs
     for many minutes and a dropped connection or a closed tab must not mean
     starting over — the pages already seen are answered from the device. */
  async pageOf(taxonKey, offset) {
    const url = CFG.API.gbif + "/species/" + taxonKey + "/children?limit=" + CFG.ATLAS.pageSize + "&offset=" + offset;
    const ck = "gbifc:" + taxonKey + "@" + offset;
    try { const j = await once(url, { timeout: 15000 }); idbPut(ck, { at: Date.now(), data: j }); return j; }
    catch (e) { const hit = await idbGet(ck); if (hit) return hit.data || hit; throw e; }
  },

  /* Paged children of one taxon, with one polite retry on a rate-limit. */
  async children(taxonKey) {
    const out = []; let offset = 0, retried = false;
    for (;;) {
      if (this.state.cancel) break;
      let page;
      try { page = await this.pageOf(taxonKey, offset); }
      catch (e) {
        if (!retried && /429|5\d\d/.test(String(e && e.message))) { retried = true; this.state.note = tr("atlas_throttled"); await nap(2500); continue; }
        throw e;
      }
      const rs = page.results || [];
      out.push(...rs);
      offset += rs.length;
      if (page.endOfRecords || !rs.length || offset >= 3000) break;
      await nap(CFG.ATLAS.gapMs);
    }
    return out.filter(x => x && x.key);
  },
  async orders() {
    const raw = await cachedJSON("gbifo", "aves", CFG.API.gbif + "/species/" + CFG.API.avesKey + "/children?limit=200");
    return ((raw && raw.results) || []).filter(x => x.rank === "ORDER")
      .map(x => ({ key: x.key, name: x.canonicalName })).sort((a, b) => a.name.localeCompare(b.name));
  },

  addRow(node, lin, out) {
    const sci = node.canonicalName || node.scientificName;
    if (!sci || out.some(r => r.sci === sci) || this.bySci.has(sci)) return;
    out.push({ id: "a-" + slug(sci), sci, genus: lin.genus || sci.split(" ")[0] || "", family: lin.family,
      order: lin.order, gbif: node.key, fk: lin.fk, atlas: true, en: "", ar: "", file: "", img: "" });
  },
  /* Family node → species, descending at most `depth` extra ranks. */
  async collect(node, lin, out, depth, cap) {
    if (this.state.cancel || out.length >= cap) return;
    let kids;
    try { kids = await this.children(node.key); } catch { return; }
    kids.filter(k => k.rank === "SPECIES").forEach(k => this.addRow(k, lin, out));
    if (depth <= 0) return;
    for (const k of kids.filter(x => x.rank && x.rank !== "SPECIES" && !/SUBSPECIES|VARIETY|FORM$/.test(x.rank))) {
      if (this.state.cancel || out.length >= cap) return;
      await this.collect(k, { ...lin, genus: node.rank === "GENUS" ? (node.canonicalName || lin.genus) : lin.genus }, out, depth - 1, cap);
    }
  },

  /* One query, up to 60 names: English + Arabic labels and a Commons file. */
  async sparql(names) {
    const values = names.map(n => '"' + String(n).replace(/[\\"]/g, "") + '"@mul').join(" ");
    const q = "SELECT ?item ?sci ?en ?ar ?img WHERE { VALUES ?sci {" + values + "} " +
      "?item rdfs:label ?sci ; wdt:P105 ?rank . " +
      'OPTIONAL { ?item rdfs:label ?en FILTER(lang(?en)="en") } ' +
      'OPTIONAL { ?item rdfs:label ?ar FILTER(lang(?ar)="ar") } ' +
      "OPTIONAL { ?item wdt:P18 ?img } } LIMIT 900";
    const j = await req(CFG.API.sparql + "?format=json&query=" + encodeURIComponent(q), { timeout: CFG.API.sparqlTimeoutMs });
    const map = new Map();
    ((j.results || {}).bindings || []).forEach(b => {
      const k = b.sci.value, cur = map.get(k) || {};
      if (b.item && !cur.wd) cur.wd = b.item.value.split("/").pop();
      if (b.en && !cur.en) cur.en = b.en.value;
      if (b.ar && !cur.ar && isArabicName(b.ar.value)) cur.ar = b.ar.value;
      if (b.img && !cur.file) cur.file = decodeURIComponent(b.img.value.split("/").pop()).replace(/_/g, " ");
      map.set(k, cur);
    });
    return map;
  },
  async enrichRows(rows) {
    const touched = new Set();
    for (let i = 0; i < rows.length; i += CFG.ATLAS.sparqlBatch) {
      if (this.state.cancel) break;
      const batch = rows.slice(i, i + CFG.ATLAS.sparqlBatch);
      let map = null;
      try { map = await this.sparql(batch.map(r => r.sci)); } catch { /* offline: keep Latin names */ }
      batch.forEach(r => {
        const hit = map && map.get(r.sci);
        if (!hit) return;
        if (hit.en) r.en = hit.en;
        if (hit.ar && isArabicName(hit.ar)) r.ar = hit.ar;
        if (hit.wd && !r.wd) r.wd = hit.wd;
        if (hit.file && !r.file) { r.file = hit.file; r.img = commonsThumb(hit.file, 600); }
        touched.add(r.fk);
      });
      await nap(50);
    }
    for (const fk of touched) await this.flushFam(fk);
    return touched.size;
  },

  /* opts: { orderKey, orderName, cap, enrich, onProg } */
  async run(opts = {}) {
    if (this.state.running) return { added: 0 };
    await this.load();
    const cap = Math.max(1, Math.min(CFG.ATLAS.maxCap, opts.cap || CFG.ATLAS.defaultCap));
    this.state = { running: true, cancel: false, phase: tr("atlas_running"), pulled: this.rows.length, cap, fam: "", note: "" };
    const before = this.rows.length;
    try {
      const orders = opts.orderKey
        ? [{ key: opts.orderKey, canonicalName: opts.orderName || "", rank: "ORDER" }]
        : (await this.children(CFG.API.avesKey)).filter(x => x.rank === "ORDER");
      const queue = [];
      for (const o of orders) {
        if (this.state.cancel || this.rows.length >= cap) break;
        this.state.phase = o.canonicalName;
        try { if (opts.onProg) opts.onProg(this.state); } catch { /* view was replaced mid-import */ }
        const kids = await this.children(o.key);
        for (const k of kids) {
          if (k.rank === "FAMILY") queue.push({ node: k, order: o.canonicalName });
          else if (k.rank && k.rank !== "SPECIES") {
            const below = await this.children(k.key).catch(() => []);
            below.filter(x => x.rank === "FAMILY").forEach(x => queue.push({ node: x, order: o.canonicalName }));
          }
        }
      }
      /* Families are independent branches of the backbone, so they are pulled
         through a small pool. At a 6,000-species cap the walk is the slow half
         of the import, and GBIF answers four parallel requests happily. */
      const pool = clamp(CFG.ATLAS.concurrency || 3, 1, 6);
      this.state.fams = queue.length; this.state.doneFams = 0;
      let cursor = 0;
      const work = async () => {
        for (;;) {
          if (this.state.cancel || this.rows.length >= cap) return;
          const i = cursor++;
          if (i >= queue.length) return;
          const item = queue[i];
          const lin = { fk: item.node.key, family: item.node.canonicalName, order: item.order, genus: "" };
          try {
            const found = [];
            await this.collect(item.node, lin, found, 2, cap - this.rows.length);
            const novel = found.filter(r => !this.bySci.has(r.sci));
            novel.forEach(r => this.adopt(r, lin.fk));
            if (novel.length) await this.flushFam(lin.fk);
            if (opts.enrich !== false && novel.length) await this.enrichRows(novel);
            if (novel.length) this.backfillNames();
          } catch (e) {
            this.state.note = String((e && e.message) || e);
            if (/abort|Failed to fetch|HTTP /.test(this.state.note)) this.state.note = tr("atlas_off");
          }
          this.state.fam = lin.family; this.state.pulled = this.rows.length; this.state.doneFams++;
          try { if (opts.onProg) opts.onProg(this.state); } catch { /* view was replaced mid-import */ }
        }
      };
      await Promise.all(Array.from({ length: pool }, () => work()));
    } catch (e) {
      this.state.note = String((e && e.message) || e);
      if (/abort|Failed to fetch|HTTP /.test(this.state.note)) this.state.note = tr("atlas_off");
    } finally {
      this.state.running = false;
      this.state.phase = "";
    }
    return { added: this.rows.length - before };
  },
  stop() { this.state.cancel = true; },
  async clear() {
    for (const f of (this.meta.fams || [])) await idbDel(this.key(f.key));
    await idbDel("atlas:meta");
    this.rows = []; this.bySci.clear(); this.byFam.clear();
    this.meta = { fams: [], total: 0, at: 0 };
    this._p = Promise.resolve(this.rows);
  },
  match(q, cap = 80) {
    const s = String(q).toLowerCase().trim();
    if (!s) return [];
    return this.rows.map(r => ({ r, s: Math.max(fuzzyScore(s, r.sci), fuzzyScore(s, r.en || "") * 1.1, fuzzyScore(s, r.ar || "") * 1.2) }))
      .filter(x => x.s > 0).sort((a, b) => b.s - a.s).slice(0, cap).map(x => x.r);
  },
  async stats() {
    await this.load();
    return { n: this.rows.length, withAr: this.rows.filter(r => r.ar).length, withImg: this.rows.filter(r => r.img).length,
      fams: (this.meta.fams || []).length, at: this.meta.at };
  },
};

/* ------------------------------------------------------- REMOTE / COMMUNITY */
const remote = {
  get base() { return CFG.remote; },
  enabled() { return !!this.base; },
  async send(path, body, method = "POST") {
    if (!this.enabled()) throw new Error("no remote configured");
    const r = await fetch(this.base + path, {
      method, headers: { "Content-Type": "application/json" },
      body: method === "GET" ? undefined : JSON.stringify(body),
    });
    if (!r.ok) throw new Error("HTTP " + r.status);
    return r.json().catch(() => ({}));
  },
  async flush() {
    const queue = store.outbox.all();
    if (!this.enabled() || !queue.length) return { pushed: 0, failed: 0 };
    let pushed = 0;
    for (const item of queue.slice()) {
      try { await this.send("/" + item.type, item); store.outbox.del(item.id); pushed++; }
      catch { return { pushed, failed: queue.length - pushed }; }
    }
    return { pushed, failed: 0 };
  },
  async pull() {
    if (!this.enabled()) return 0;
    try {
      const data = await this.send("/sightings?since=" + (store.settings.lastSync || 0), null, "GET");
      const rows = Array.isArray(data) ? data : (data && data.items) || [];
      let added = 0;
      rows.forEach(r => {
        if (!r || !r.species || store.sightings.all().some(l => l.remoteId === r.id)) return;
        store.sightings.items.push({ id: uid(), remoteId: r.id, species: r.species, speciesId: r.species_id || "",
          date: r.date || new Date().toISOString(), lat: r.lat, lng: r.lng, notes: r.notes || "", community: true });
        added++;
      });
      if (added) store.sightings.flush();
      store.settings.lastSync = Date.now(); store.persist();
      return added;
    } catch { return -1; }
  },
  /* First sync ever: local records saved before a backend existed are pushed too. */
  backfill() {
    const ts = new Date().toISOString();
    store.birds.all().forEach(r => store.outbox.add({ type: "birds", op: "create", payload: r, ts }));
    store.sightings.all().filter(r => !r.community).forEach(r =>
      store.outbox.add({ type: "sightings", op: "create", ts,
        payload: { id: r.id, species: r.species, species_id: r.speciesId, date: r.date, lat: r.lat, lng: r.lng, notes: r.notes } }));
  },
  async syncAll() {
    if (!this.enabled()) { toast(tr("remote_off"), "info"); return; }
    if (!store.settings.lastSync && !store.outbox.all().length) this.backfill();
    const { pushed, failed } = await this.flush();
    const pulled = await this.pull();
    if (pulled < 0) { toast(tr("remote_fail"), "error"); return; }
    toast(failed ? tr("remote_fail") : tr("remote_ok") + " (↑" + pushed + " ↓" + pulled + ")", failed ? "error" : "ok");
  },
};
/* Local mode keeps everything in device storage, so nothing is queued until a
   community backend is configured; then writes wait in the outbox until they land. */
function queueWrite(type, op, payload) {
  if (!remote.enabled()) return;
  store.outbox.add({ type, op, payload, ts: new Date().toISOString() });
  remote.flush();
}

/* -------------------------------------------------------------- DERIVED READS */
const speciesName = b => (I18N.lang === "ar" && b.ar ? b.ar : (b.en || b.sci || ""));
/* A Wikidata "ar" label is not always Arabic — one eagle came back in Bengali
   script. Anything without a single Arabic letter is dropped rather than shown,
   and the English name takes over. */
const isArabicName = s => !!s && /[\u0600-\u06FF\u0750-\u077F]/.test(String(s));
const byId = id => SPECIES.find(b => b.id === id);
const isFav = id => store.favs.has(id);
function toggleFav(id) {
  if (isFav(id)) store.favs.delete(id); else store.favs.add(id);
  store.persist(); return isFav(id);
}
const markVisited = id => { if (!store.visits.has(id)) { store.visits.add(id); store.persist(); } };
const noteOf = id => store.notes[id] || "";
/* A row may come from the curated guide, the atlas import, the search index or
   an AI answer. These pick a link and a readable name that exist for whichever
   it is, so an assistant answer never points at a dead page. */
const curatedOf = r => (r && !r.atlas && r.id ? byId(r.id) : null);
const hrefFor = r => { const c = curatedOf(r); return c ? "#/bird/" + encodeURIComponent(c.id)
  : "#/birds?q=" + encodeURIComponent(r ? (r.sci || r.en || "") : ""); };
const nameFor = r => (r ? (speciesName(r) || r.sci || "") : "");

/* ------------------------------------------------- 7b. CANVAS + AUDIO ENGINE */
function setupCanvas(cv, cssH) {
  const dpr = Math.min(2, window.devicePixelRatio || 1);
  const w = (cv && cv.clientWidth) || (cv && cv.parentElement.clientWidth) || 320, h = cssH || (cv && cv.clientHeight) || 180;
  if (!cv) return { ctx: null, w, h, dpr };
  cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr);
  cv.style.height = h + "px";
  const ctx = cv.getContext("2d"); ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  return { ctx, w, h, dpr };
}
const css = name => getComputedStyle(document.documentElement).getPropertyValue(name).trim();

function drawChart(cv, points, { unit = "", label = "" } = {}) {
  const { ctx, w, h } = setupCanvas(cv, 190);
  if (!ctx) return;
  const pad = { l: 46, r: 12, t: 14, b: 26 };
  ctx.clearRect(0, 0, w, h);
  if (!points.length) { ctx.fillStyle = css("--muted"); ctx.font = "13px system-ui"; ctx.fillText(tr("no_data"), pad.l, h / 2); return; }
  const ys = points.map(p => p.y), xs = points.map(p => daysBetween(points[0].x, p.x));
  let lo = Math.min(...ys), hi = Math.max(...ys);
  const span = (hi - lo) || Math.max(1, hi * 0.1);
  lo -= span * 0.15; hi += span * 0.15;
  const X = i => pad.l + (w - pad.l - pad.r) * (xs.length === 1 ? 0.5 : (xs[i] - Math.min(...xs)) / ((Math.max(...xs) - Math.min(...xs)) || 1));
  const Y = v => h - pad.b - (h - pad.t - pad.b) * (v - lo) / (hi - lo);
  ctx.strokeStyle = css("--line"); ctx.lineWidth = 1; ctx.fillStyle = css("--muted"); ctx.font = "11px system-ui";
  for (let g = 0; g <= 4; g++) {
    const v = lo + (hi - lo) * g / 4, y = Y(v);
    ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(w - pad.r, y); ctx.stroke();
    ctx.textAlign = "right"; ctx.fillText(round(v, 1) + unit, pad.l - 6, y + 4);
  }
  ctx.strokeStyle = css("--ac"); ctx.lineWidth = 2.2; ctx.lineJoin = "round"; ctx.beginPath();
  points.forEach((p, i) => i ? ctx.lineTo(X(i), Y(p.y)) : ctx.moveTo(X(i), Y(p.y)));
  ctx.stroke();
  points.forEach((p, i) => {
    ctx.fillStyle = css("--ac"); ctx.beginPath(); ctx.arc(X(i), Y(p.y), 3.4, 0, 7); ctx.fill();
    ctx.fillStyle = css("--muted"); ctx.textAlign = "center";
    if (i === 0 || i === points.length - 1 || points.length < 7) ctx.fillText(new Date(p.x).toLocaleDateString(I18N.lang === "ar" ? "ar-EG" : "en-GB", { day: "2-digit", month: "short" }), X(i), h - 8);
  });
  if (label) { ctx.fillStyle = css("--text"); ctx.textAlign = "left"; ctx.font = "600 12px system-ui"; ctx.fillText(label + " · n=" + points.length, pad.l, 12); }
}

function drawRadar(cv, sets, labels) {
  const { ctx, w, h } = setupCanvas(cv, 320);
  if (!ctx) return;
  const cx = w / 2, cy = h / 2 + 6, R = Math.min(w, h) / 2 - 46, n = labels.length;
  const colors = [css("--ac"), "#f59e0b", "#6366f1"];
  ctx.clearRect(0, 0, w, h);
  ctx.strokeStyle = css("--line"); ctx.fillStyle = css("--muted"); ctx.font = "11px system-ui";
  for (let ring = 1; ring <= 4; ring++) {
    ctx.beginPath();
    for (let i = 0; i < n; i++) {
      const a = -Math.PI / 2 + i * 2 * Math.PI / n, r = R * ring / 4;
      ctx[i ? "lineTo" : "moveTo"](cx + r * Math.cos(a), cy + r * Math.sin(a));
    }
    ctx.closePath(); ctx.stroke();
  }
  for (let i = 0; i < n; i++) {
    const a = -Math.PI / 2 + i * 2 * Math.PI / n;
    ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(cx + R * Math.cos(a), cy + R * Math.sin(a)); ctx.stroke();
    ctx.textAlign = Math.abs(Math.cos(a)) < .3 ? "center" : Math.cos(a) > 0 ? "left" : "right";
    ctx.fillText(labels[i], cx + (R + 14) * Math.cos(a), cy + (R + 14) * Math.sin(a) + 4);
  }
  sets.forEach((s, k) => {
    ctx.beginPath();
    s.forEach((v, i) => {
      const a = -Math.PI / 2 + i * 2 * Math.PI / n, r = R * clamp(v / 5, 0, 1);
      ctx[i ? "lineTo" : "moveTo"](cx + r * Math.cos(a), cy + r * Math.sin(a));
    });
    ctx.closePath();
    ctx.fillStyle = colors[k % 3] + "33"; ctx.fill();
    ctx.strokeStyle = colors[k % 3]; ctx.lineWidth = 2; ctx.stroke();
  });
}

function drawMap(cv, rows, onSelect) {
  const { ctx, w, h } = setupCanvas(cv, (cv && cv.clientHeight) || 420);
  if (!ctx) return;
  ctx.clearRect(0, 0, w, h);
  const proj = { x: lng => (lng + 180) / 360 * w, y: lat => (90 - lat) / 180 * h };
  const hit = (lat, lng) => ({ px: proj.x(lng), py: proj.y(lat) });
  ctx.fillStyle = css("--surface-2"); ctx.fillRect(0, 0, w, h);
  ctx.strokeStyle = css("--line"); ctx.lineWidth = 1; ctx.fillStyle = css("--muted"); ctx.font = "10px system-ui";
  for (let lng = -180; lng <= 180; lng += 30) { const x = proj.x(lng); ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke(); ctx.fillText(lng + "°", x + 2, h - 4); }
  for (let lat = -90; lat <= 90; lat += 30) { const y = proj.y(lat); ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke(); ctx.fillText(lat + "°", 3, y - 3); }
  ctx.strokeStyle = css("--line"); ctx.beginPath(); ctx.moveTo(0, proj.y(0)); ctx.lineTo(w, proj.y(0)); ctx.stroke();
  const geo = rows.filter(r => Number.isFinite(+r.lat) && Number.isFinite(+r.lng));
  const grid = new Map();
  geo.forEach(r => { const k = Math.round(r.lat / 6) + ":" + Math.round(r.lng / 6); grid.set(k, (grid.get(k) || 0) + 1); });
  grid.forEach((n, k) => {
    const [la, ln] = k.split(":").map(Number); const { px, py } = hit(la * 6, ln * 6);
    ctx.fillStyle = "hsl(" + css("--h").trim() + " 70% 45% / " + Math.min(.4, .08 * n) + ")";
    ctx.beginPath(); ctx.arc(px, py, 10 + 5 * n, 0, 7); ctx.fill();
  });
  cv._points = geo.map(r => { const { px, py } = hit(r.lat, r.lng); return { ...r, px, py }; });
  cv._points.forEach(p => {
    ctx.beginPath(); ctx.arc(p.px, p.py, p.community ? 4 : 6, 0, 7);
    ctx.fillStyle = p.community ? "#6366f1" : css("--ac"); ctx.fill();
    ctx.lineWidth = 1.6; ctx.strokeStyle = css("--surface"); ctx.stroke();
  });
  if (!onSelect) return;
  cv.onclick = e => {
    const rect = cv.getBoundingClientRect(), mx = e.clientX - rect.left, my = e.clientY - rect.top;
    let best = null, bd = 18;
    (cv._points || []).forEach(p => { const d = Math.hypot(p.px - mx, p.py - my); if (d < bd) { bd = d; best = p; } });
    if (best) onSelect(best);
  };
}

/* ------------------------------------------- Web Audio: synth + visualiser */
const audio = { ctx: null, node: null, raf: 0, analyser: null, el: null, silentFrames: 0, blocked: false };
function audioCtx() {
  if (!audio.ctx) {
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return null;
    audio.ctx = new AC();
  }
  if (audio.ctx.state === "suspended") audio.ctx.resume();
  return audio.ctx;
}
function playChirp(pitch) {
  const ctx = audioCtx(); if (!ctx) return;
  const t0 = ctx.currentTime, master = ctx.createGain();
  master.gain.value = .9; master.connect(ctx.destination);
  const notes = [[0, 1], [.16, 1.34], [.3, .82], [.46, 1.16]];
  notes.forEach(([at, mul]) => {
    const o = ctx.createOscillator(), g = ctx.createGain(), f = pitch * mul;
    o.type = "sine"; o.frequency.setValueAtTime(f, t0 + at);
    o.frequency.exponentialRampToValueAtTime(f * 1.09, t0 + at + .05);
    o.frequency.exponentialRampToValueAtTime(f * .88, t0 + at + .13);
    g.gain.setValueAtTime(.0001, t0 + at);
    g.gain.exponentialRampToValueAtTime(.28, t0 + at + .02);
    g.gain.exponentialRampToValueAtTime(.0001, t0 + at + .15);
    o.connect(g); g.connect(master); o.start(t0 + at); o.stop(t0 + at + .18);
  });
}
function attachAnalyser(mediaEl, waveCv, specCv) {
  const ctx = audioCtx(); if (!ctx) return;
  detachAnalyser();
  audio.el = mediaEl; audio.blocked = false; audio.silentFrames = 0;
  /* createMediaElementSource may only be called once per element. Reusing the
     node the element already owns is what makes the second recording of a
     session audible: a fresh call here throws, and a thrown attach used to
     leave the element disconnected from the output after the first pause. */
  let src = mediaEl._bwSrc && mediaEl._bwSrc.context === ctx ? mediaEl._bwSrc : null;
  if (!src) { try { src = ctx.createMediaElementSource(mediaEl); mediaEl._bwSrc = src; } catch { return; } }
  const an = ctx.createAnalyser(); an.fftSize = 2048; an.smoothingTimeConstant = .78;
  src.connect(an); an.connect(ctx.destination);
  audio.node = src; audio.analyser = an;
  const td = new Uint8Array(an.fftSize), fd = new Uint8Array(an.frequencyBinCount);
  const wc = waveCv && setupCanvas(waveCv, 110), sc = specCv && setupCanvas(specCv, 130);
  let sweep = 0;
  const tick = () => {
    if (!audio.analyser) return;
    audio.raf = requestAnimationFrame(tick);
    audio.analyser.getByteTimeDomainData(td);
    audio.analyser.getByteFrequencyData(fd);
    const active = td.some(v => v !== 128);
    if (!active && !mediaEl.paused) audio.silentFrames++;
    if (audio.silentFrames > 40 && !audio.blocked) { audio.blocked = true; toast(tr("an_block"), "warn", 3800); }
    if (wc) {
      const { ctx: c, w, h } = wc; c.clearRect(0, 0, w, h);
      c.strokeStyle = css("--line"); c.beginPath(); c.moveTo(0, h / 2); c.lineTo(w, h / 2); c.stroke();
      if (!audio.blocked) {
        c.strokeStyle = css("--ac"); c.lineWidth = 1.6; c.beginPath();
        for (let i = 0; i < td.length; i++) { const v = td[i] / 128 - 1, x = i / td.length * w, y = h / 2 + v * h * .42;
          i ? c.lineTo(x, y) : c.moveTo(x, y); }
        c.stroke();
      }
    }
    if (sc && !audio.blocked) {
      const { ctx: c, w, h } = sc;
      const col = c.createImageData(1, h);
      for (let y = 0; y < h; y++) {
        const bin = Math.floor((h - y) / h * fd.length * .5), v = fd[bin];
        col.data[y * 4] = 16 + v * .2; col.data[y * 4 + 1] = 120 + v * .7; col.data[y * 4 + 2] = 90 + v * .3; col.data[y * 4 + 3] = 255;
      }
      c.putImageData(col, sweep, 0); c.drawImage(specCv, 0, 0, w, h, -1, 0, w, h);
      sweep = (sweep + 1) % Math.max(1, w - 1);
    }
  };
  tick();
}
function detachAnalyser() {
  cancelAnimationFrame(audio.raf); audio.raf = 0; audio.analyser = null;
  if (audio.node) { try { audio.node.disconnect(); } catch { /* already gone */ } audio.node = null; }
}

/* ------------------------------------------------------- ACOUSTIC ENGINE */
/* A hand-written radix-2 FFT and a small set of song measurements. Reference
 * recordings and field recordings pass through exactly the same maths, so a
 * match means the two sounds share pitch range, note rate and band energy.
 * Nothing about a species is assumed: a voice only enters the library after it
 * has been downloaded from a freely licensed file and measured. */
const Acoustic = {
  N: CFG.VOICE.fft,
  /* fingerprint schema version — stored references from an older build are
     measured differently and must never be compared against the current one */
  FV: 4,
  /* log-spaced pitch histogram: 0.3–12 kHz in 32 bins (~13% per bin) covers a
     dove's 400 Hz coo and a wren's 9 kHz trill on the same axis */
  PH: { n: 32, lo: 0.3, hi: 12 },
  edges: CFG.VOICE.bands.map(f => f * 1000),

  fft(re, im) {
    const n = re.length;
    for (let i = 1, j = 0; i < n; i++) {
      let bit = n >> 1;
      for (; j & bit; bit >>= 1) j ^= bit;
      j ^= bit;
      if (i < j) { let t = re[i]; re[i] = re[j]; re[j] = t; t = im[i]; im[i] = im[j]; im[j] = t; }
    }
    for (let len = 2; len <= n; len <<= 1) {
      const ang = -2 * Math.PI / len, wr = Math.cos(ang), wi = Math.sin(ang), half = len >> 1;
      for (let i = 0; i < n; i += len) {
        let cr = 1, ci = 0;
        for (let k = 0; k < half; k++) {
          const a = i + k, b = a + half;
          const xr = re[b] * cr - im[b] * ci, xi = re[b] * ci + im[b] * cr;
          re[b] = re[a] - xr; im[b] = im[a] - xi;
          re[a] += xr; im[a] += xi;
          const nr = cr * wr - ci * wi; ci = cr * wi + ci * wr; cr = nr;
        }
      }
    }
  },
  mono(buf) {
    const chs = Math.max(1, buf.numberOfChannels), out = new Float32Array(buf.length);
    for (let c = 0; c < chs; c++) { const d = buf.getChannelData(c); for (let i = 0; i < out.length; i++) out[i] += d[i] / chs; }
    return { data: out, sr: buf.sampleRate };
  },
  q(arr, p) { const s = arr.slice().sort((a, b) => a - b); return s.length ? s[clamp(Math.round(p * (s.length - 1)), 0, s.length - 1)] : 0; },

  /* AudioBuffer → fingerprint */
  analyse(buf, maxSec = 22) {
    if (!buf || !buf.length) return null;
    const m = this.mono(buf), sr = m.sr;
    let data = m.data;
    if (data.length > sr * maxSec) data = data.subarray(0, Math.floor(sr * maxSec));
    const N = this.N, hop = N >> 1;
    if (data.length < N * 4) return null;
    const nb = this.edges.length - 1, binHz = sr / N;
    const binBand = new Int8Array(N / 2).fill(-1);
    for (let k = 1; k < N / 2; k++) {
      const hz = k * binHz;
      for (let b = 0; b < nb; b++) if (hz >= this.edges[b] && hz < this.edges[b + 1]) { binBand[k] = b; break; }
    }
    const win = new Float32Array(N);
    for (let i = 0; i < N; i++) win[i] = 0.5 - 0.5 * Math.cos(2 * Math.PI * i / (N - 1));
    const re = new Float32Array(N), im = new Float32Array(N), pr = new Float32Array(N), pi = new Float32Array(N);
    const frames = Math.floor((data.length - N) / hop) + 1;
    const bandE = new Float64Array(frames * nb);
    const cent = [], flux = [], rms = [], flat = [], pings = [], doms = [], tons = [];
    let prevMag = null;
    const lagLo = Math.max(3, Math.floor(sr / 11000)), lagHi = Math.min(N - 2, Math.floor(sr / 650));

    for (let fr = 0; fr < frames; fr++) {
      const off = fr * hop;
      let sq = 0;
      for (let i = 0; i < N; i++) sq += data[off + i] * data[off + i];
      const e = Math.sqrt(sq / N);
      for (let i = 0; i < N; i++) { re[i] = data[off + i] * win[i]; im[i] = 0; }
      this.fft(re, im);
      const half = N / 2, mag = new Float32Array(half);
      let tot = 0, logs = 0, ce = 0, cw = 0;
      for (let k = 1; k < half; k++) {
        const mm = Math.hypot(re[k], im[k]);
        mag[k] = mm; tot += mm; logs += Math.log(mm + 1e-9);
        const b = binBand[k];
        if (b < 0) continue;
        bandE[fr * nb + b] += mm * mm;
        ce += mm * mm; cw += mm * mm * (k * binHz);
      }
      cent.push(ce > 1e-12 ? cw / ce / 1000 : 0);
      flat.push(tot > 1e-6 ? Math.exp(logs / (half - 1)) / (tot / (half - 1) + 1e-9) : 1);
      rms.push(e);
      let f = 0;
      if (prevMag) { for (let k = 1; k < half; k++) { const d = mag[k] - prevMag[k]; if (d > 0) f += d; } }
      flux.push(f);
      if (prevMag) { for (let k = 1; k < half; k++) prevMag[k] = mag[k]; } else { prevMag = new Float32Array(half); prevMag.set(mag); }
      /* tonal pitch from the autocorrelation of the same window */
      let ping = 0, ton = 0;
      if (e > 0.004) {
        for (let k = 0; k < N; k++) {
          const kk = k < half ? k : N - k;
          const v = kk === 0 ? tot / half : (kk < half ? mag[kk] : mag[half - 1]);
          pr[k] = v * v; pi[k] = 0;
        }
        this.fft(pr, pi);
        /* the ACF decays monotonically at first, so only a local maximum counts
           as a period — otherwise the estimate sticks to the smallest lag */
        let best = -1, bestLag = 0, r0 = pr[0] || 1;
        const peaks = [];
        for (let lag = lagLo; lag <= lagHi; lag++) {
          if (pr[lag] <= pr[lag - 1] || (lag < lagHi && pr[lag] < pr[lag + 1])) continue;
          const v = pr[lag] / r0;
          peaks.push([lag, v]);
          if (v > best) { best = v; bestLag = lag; }
        }
        /* an overtone-rich note repeats at half its true period too, so take the
           shortest near-equal peak instead of the octave-down reading */
        for (const [lag, v] of peaks) {
          if (lag < bestLag && v >= best * 0.82) { best = v; bestLag = lag; break; }
        }
        if (best > 0.3 && bestLag) { ping = sr / bestLag / 1000; ton = clamp(best, 0, 1); }
      }
      pings.push(ping); tons.push(ton);
      /* dominant frequency: the tallest spectral peak inside the note's own
         band. Starting the search just below the detected pitch keeps low
         callers (doves, owls, waterfowl) intact while excluding the wind
         rumble and insect floor that always sit under a song and would
         otherwise win the global peak — that is what made a chaffinch
         measure 0.6 kHz instead of 3.5 kHz. */
      let dom = 0;
      if (ping > 0) {
        const lo = Math.max(2, Math.floor(Math.max(0.22, ping * 0.72) * 1000 / binHz));
        const hi = Math.min(half - 2, Math.ceil(12.5 * 1000 / binHz));
        let bv = 0, bp = 0;
        for (let k = lo; k <= hi; k++) if (mag[k] > bv) { bv = mag[k]; bp = k; }
        if (bp > 1 && bp < half - 1) {
          const al = Math.log(mag[bp - 1] + 1e-9), be = Math.log(mag[bp] + 1e-9), gi = Math.log(mag[bp + 1] + 1e-9);
          const den = al - 2 * be + gi;
          dom = (bp + (den ? clamp(0.5 * (al - gi) / den, -1, 1) : 0)) * binHz / 1000;
        }
      }
      doms.push(dom);
    }
    /* voice gate, then note onsets: a flux peak above the voiced median with a
       60 ms refractory, so hiss and insects cannot inflate the note rate */
    const sortedRms = rms.slice().sort((a, b) => a - b);
    const floor = sortedRms.length ? sortedRms[Math.floor(sortedRms.length * 0.1)] : 0;
    const voiceCut = Math.max(floor * 3.2, 0.0035);
    const vf = [];
    for (let i = 1; i < flux.length; i++) if (rms[i] >= voiceCut) vf.push(i);
    const fs = vf.map(i => flux[i]).sort((a, b) => a - b);
    const fMed = fs.length ? fs[Math.floor(fs.length / 2)] : 0;
    const fSpread = fs.length ? Math.max(fs[Math.floor(fs.length * 0.9)] - fMed, fMed * 0.25, 1e-9) : 1;
    const thr = fMed + Math.max(fSpread * 0.85, fMed * 0.1);
    const refr = Math.max(2, Math.round(0.06 * sr / hop));
    let notes = 0, lastNote = -999;
    for (const i of vf) {
      if (i - lastNote < refr || flux[i] <= thr) continue;
      if (flux[i] < flux[i - 1] || flux[i] < flux[Math.min(flux.length - 1, i + 1)]) continue;
      notes++; lastNote = i;
    }
    const voicedSec = vf.length * hop / sr;
    const voiced = round(vf.length / Math.max(1, frames), 3);
    const rate = voicedSec > 0.25 ? round(notes / voicedSec, 2) : 0;
    /* descriptors come from the voiced frames only: a 20 s clip that is 15 s of
       wind still normalises to the bird, not to the wind. With too few voiced
       frames (a nearly silent take) fall back to everything rather than emit 0 */
    const src = vf.length >= 8 ? vf : Array.from({ length: frames }, (_, i) => i);
    const bands = new Float64Array(nb);
    for (const i of src) for (let b = 0; b < nb; b++) bands[b] += bandE[i * nb + b];
    const bandSum = sum(Array.from(bands)) || 1;
    const sec = data.length / sr;
    const pingList = src.map(i => pings[i]).filter(v => v > 0);
    const domList = src.map(i => doms[i]).filter(v => v > 0.25);
    const centList = src.map(i => cent[i]).filter(v => v > 0);
    const flatList = src.map(i => flat[i]);
    const pMin = this.q(pingList, 0.08), pMed = this.q(pingList, 0.5), pMax = this.q(pingList, 0.92);
    const domMed = this.q(domList, 0.5), domHi = this.q(domList, 0.9);
    /* the descriptor that actually separates songbirds: where the notes sit
       across the octave scale, kept as a distribution instead of a median. A
       great tit is a spike at 4 kHz and a blackbird a broad mass from 2.5 to
       8 kHz — they can share a median, so the shape is compared, not the centre */
    const P = this.PH, ph = new Float64Array(P.n), ps = new Float64Array(P.n);
    const plo = Math.log(P.lo), pspan = Math.log(P.hi / P.lo), rMed = this.q(rms, 0.5) || 1;
    for (const i of src) {
      const f = doms[i];
      if (!(f > P.lo)) continue;
      const w = clamp(rms[i] / rMed, 0.25, 3) * (0.35 + 0.65 * tons[i]);
      const x = clamp((Math.log(f) - plo) / pspan, 0, 0.99999) * P.n;
      const b0 = Math.floor(x), fr = x - b0;
      ph[b0] += w * (1 - fr);
      if (b0 + 1 < P.n) ph[b0 + 1] += w * fr;
    }
    /* one 3-tap smoothing pass: a little pitch drift between mics must not read
       as a different song */
    for (let i = 0; i < P.n; i++)
      ps[i] = 0.5 * ph[i] + 0.25 * ph[Math.max(0, i - 1)] + 0.25 * ph[Math.min(P.n - 1, i + 1)];
    const phSum = sum(Array.from(ps)) || 1;
    return {
      V: this.FV,
      dur: round(sec, 2), sr,
      bands: Array.from(bands, v => round(v / bandSum, 4)),
      ph: Array.from(ps, v => round(v / phSum, 4)),
      centroid: round(this.q(centList, 0.5), 2),
      flatness: round(this.q(flatList, 0.5), 3),
      dom: round(domMed, 2), domHi: round(domHi, 2),
      pMin: round(pMin, 2), pMed: round(pMed, 2), pMax: round(pMax, 2),
      /* ratios survive a bad mic and a distant perch: where the energy sits
         relative to the note's own pitch, and how wide the pitch range is */
      tone: round(domMed / (pMed || domMed || 1), 3),
      span: round(pMax / Math.max(0.12, pMin), 3),
      notes, rate, voiced,
      frames, at: Date.now(),
    };
  },

  /* weighted distance: shape terms first, absolute frequencies as minority votes */
  compare(a, b) {
    if (!a || !b || !a.bands || !b.bands) return { d: 1, score: 0, why: [] };
    const prof = (x, y) => {
      let dot = 0, na = 0, nb2 = 0, l1 = 0;
      for (let i = 0; i < x.length; i++) { dot += x[i] * y[i]; na += x[i] ** 2; nb2 += y[i] ** 2; l1 += Math.abs(x[i] - y[i]); }
      return { cos: dot / (Math.sqrt(na * nb2) + 1e-9), l1: clamp(l1 / 2, 0, 1) };
    };
    /* 1-D Wasserstein distance on the pitch histogram: the least "work" needed
       to move one song's mass onto the other's. Tolerates a whole-tone shift
       between two mics, which a bin-by-bin difference would punish as a
       different species */
    const wass = (x, y) => { let c = 0, acc = 0; for (let i = 0; i < x.length; i++) { acc += x[i] - y[i]; c += Math.abs(acc); } return clamp(c / x.length * 2.6, 0, 1); };
    const inter = (x, y) => { let m = 0; for (let i = 0; i < x.length; i++) m += Math.min(x[i], y[i]); return clamp(1 - m, 0, 1); };
    const same = a.ph && b.ph && a.ph.length === b.ph.length;
    const bp = prof(a.bands, b.bands);
    const lr = (x, y) => clamp(Math.abs(Math.log((x + 0.06) / (y + 0.06))) / 1.2, 0, 1);
    const rr = (x, y) => clamp(Math.abs(Math.log((x + 0.02) / (y + 0.02))) / 0.55, 0, 1);
    const parts = {
      shape: same ? wass(a.ph, b.ph) : bp.l1,
      tone: same ? inter(a.ph, b.ph) : 1 - bp.cos,
      band: 1 - bp.cos, spread: bp.l1,
      dom: lr(a.dom, b.dom), pitch: lr(a.pMed, b.pMed), hi: lr(a.pMax, b.pMax),
      span: rr(a.span, b.span), rate: lr(a.rate, b.rate),
      cent: clamp(Math.abs(a.centroid - b.centroid) / 3.5, 0, 1),
      voice: clamp(Math.abs(a.voiced - b.voiced) / 0.6, 0, 1),
    };
    const w = { shape: .34, tone: .13, band: .11, spread: .05, dom: .08, pitch: .08,
                hi: .04, span: .07, rate: .06, cent: .03, voice: .02 };
    const d = sum(Object.keys(w).map(k => w[k] * parts[k])) / sum(Object.values(w));
    const pct = v => Math.round(clamp(1 - v, 0, 1) * 100);
    const why = [
      [tr("id_shape"), pct(parts.shape), ""],
      [tr("id_pitch"), pct(parts.dom), round(a.dom, 1) + " / " + round(b.dom, 1) + " kHz"],
      [tr("id_rate2"), pct(parts.rate), round(a.rate, 1) + " / " + round(b.rate, 1)],
      [tr("id_feats"), pct(parts.span), round(a.span, 2) + " / " + round(b.span, 2) + "×"],
    ];
    return { d: round(d, 4), score: clamp(Math.round(100 * Math.exp(-5 * d)), 1, 99), parts, why };
  },

  /* ------------------------------------------------- reference voice library */
  lib: { index: null, building: false, cancel: false, done: 0, total: 0, note: "" },
  keyOf: sci => "fp:" + sci,
  async index() {
    if (this.lib.index) return this.lib.index;
    const idx = await idbGet("fp:index");
    this.lib.index = idx || [];
    return this.lib.index;
  },
  async entries() {
    const idx = await this.index();
    const rows = await Promise.all(idx.map(s => idbGet(this.keyOf(s))));
    /* voices measured by an older fingerprint schema are silently dropped —
       they would be compared on a different scale than the live engine */
    return rows.filter(Boolean)
      .map(r => Object.assign({}, r, { voices: (r.voices || []).filter(v => v && v.fp && v.fp.V === this.FV) }))
      .filter(r => r.voices.length);
  },
  /* freely licensed recordings, keyless on Commons by default; the same list
     the species page shows, so what you hear and what the matcher learns are
     never two different things */
  async candidates(sci) {
    const b = SPECIES.find(x => x.sci === sci) || Atlas.get(sci) || { sci };
    const items = await Song.for(b);
    return items.filter(x => this.PLAY.test(String(x.url || x.file)))
      .map(x => ({ file: x.file || x.title, url: x.url, mime: x.mime, kb: x.kb, secs: round(x.secs || 0, 1) }))
      .filter(x => x.url && x.secs >= 6 && x.secs <= 140 && x.kb > 20 && x.kb < 4200)
      .sort((a, b2) => Math.abs(a.secs - 20) - Math.abs(b2.secs - 20));
  },
  PLAY: /\.(mp3|m4a|aac|ogg|oga|opus|wav)$/i,
  async fetchBuffer(url) {
    const blob = await req(url, { expect: "blob", timeout: 30000 });
    const ctx = audioCtx() || new (window.AudioContext || window.webkitAudioContext)();
    try { return await ctx.decodeAudioData(await blob.arrayBuffer()); } catch { return null; }
  },
  /* measure several freely licensed files and keep the ones that agree: a single
     noisy take must not define a species, and one species needs several voices
     because a 7 s clip and a 60 s song measure differently */
  async addReference(sci) {
    const files = (await this.candidates(sci)).slice(0, 8);
    if (!files.length) return null;
    const measured = [];
    for (const f of files) {
      const buf = await this.fetchBuffer(f.url);
      const fp = buf && this.analyse(buf);
      if (fp && fp.dom > 0.3 && fp.voiced >= 0.04) measured.push({ fp, file: f.file, url: f.url, secs: f.secs });
      if (measured.length >= 6) break;
    }
    if (!measured.length) return null;
    let voices = measured;
    if (measured.length > 2) {
      const means = measured.map((m, i) => avg(measured.filter((_, j) => j !== i).map(o => this.compare(m.fp, o.fp).d)));
      const cut = this.q(means, 0.65);
      const kept = measured.filter((_, i) => means[i] <= cut);
      if (kept.length >= 2) voices = kept.slice(0, 5);
    }
    const row = { sci, voices, at: Date.now() };
    await idbPut(this.keyOf(sci), row);
    const idx = await this.index();
    if (!idx.includes(sci)) { idx.push(sci); await idbPut("fp:index", idx); }
    return row;
  },
  async build(list, onProg) {
    if (this.lib.building) return 0;
    const want = uniq(list.filter(Boolean)).slice(0, 400);
    this.lib = Object.assign(this.lib, { building: true, cancel: false, done: 0, total: want.length, note: "" });
    let ok = 0;
    for (const sci of want) {
      if (this.lib.cancel) break;
      try { if (await this.addReference(sci)) ok++; } catch (e) { this.lib.note = String(e.message || e); }
      this.lib.done++;
      if (onProg) onProg(this.lib);
      await nap(120);
    }
    this.lib.building = false;
    this.lib.index = null;
    return ok;
  },
  stopBuild() { this.lib.cancel = true; },
  async removeReference(sci) {
    await idbDel(this.keyOf(sci));
    const idx = (await this.index()).filter(s => s !== sci);
    this.lib.index = idx;
    await idbPut("fp:index", idx);
  },
  async clearLibrary() {
    const idx = await this.index();
    for (const s of idx) await idbDel(this.keyOf(s));
    await idbDel("fp:index");
    this.lib.index = [];
  },

  /* A wind-only or silent take must report "nothing to compare", not a
     confident wrong answer — that is the difference between a tool people
     trust and one that quietly misleads them about a live animal. */
  quality(fp) {
    if (!fp) return { ok: false, why: tr("id_noaudio") };
    if (!(fp.dom > 0.3) || !(fp.pMed > 0)) return { ok: false, why: tr("id_notonal") };
    if (fp.voiced < 0.03) return { ok: false, why: tr("id_quiet") };
    return { ok: true };
  },

  /* rank the library (or a candidate subset) against one fingerprint.
     `score` is acoustic similarity; `conf` is the share of probability this
     species holds among the candidates actually compared — with a small library
     both numbers are high, which is exactly why the view shows the library size */
  async identify(fp, only) {
    if (!fp) return [];
    let rows = await this.entries();
    if (only && only.length) { const set = new Set(only); rows = rows.filter(r => set.has(r.sci)); }
    const ranked = [];
    for (const r of rows) {
      /* rank on the MEAN distance to a species' references, not the closest
         single voice: leave-one-out over 21 real recordings gave 5/6 top-1 with
         the mean against 4/6 with best-match, because one fluke recording should
         not carry a whole species. `best` still drives the displayed score. */
      let best = null, agree = 0, tot = 0;
      for (const v of r.voices) {
        const c = this.compare(fp, v.fp);
        tot += c.d;
        if (c.d < 0.22) agree++;
        if (!best || c.score > best.score) best = c;
      }
      if (best) ranked.push({ sci: r.sci, row: r, score: best.score, why: best.why,
        d: round(tot / r.voices.length, 4), near: best.d,
        voices: r.voices.length, agree, conf: 0 });
    }
    ranked.sort((a, b) => a.d - b.d);
    const T = 0.12, es = ranked.map(r => Math.exp(-r.d / T)), tot = sum(es) || 1;
    ranked.forEach((r, i) => { r.conf = Math.round(100 * es[i] / tot); });
    if (ranked.length > 1) ranked[0].amb = ranked[0].conf - ranked[1].conf < 12;
    return ranked;
  },

  /* -------------------------------------------------------------- recording */
  rec: { mr: null, chunks: [], stream: null, started: 0, timer: 0 },
  supported() { return !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia && window.MediaRecorder); },
  async start() {
    if (!this.supported()) throw new Error(tr("id_mic_no"));
    const stream = await navigator.mediaDevices.getUserMedia({
      audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false } });
    const mr = new MediaRecorder(stream);
    this.rec = { mr, chunks: [], stream, started: Date.now(), timer: 0 };
    mr.ondataavailable = e => { if (e.data && e.data.size) this.rec.chunks.push(e.data); };
    mr.start(200);
    return mr;
  },
  async finish() {
    const { mr, stream } = this.rec;
    if (!mr) return null;
    const blob = new Promise(res => { mr.onstop = () => res(new Blob(this.rec.chunks, { type: mr.mimeType || "audio/webm" })); });
    try { mr.stop(); } catch { /* already stopped */ }
    (stream.getTracks() || []).forEach(t => t.stop());
    this.rec = { mr: null, chunks: [], stream: null, started: 0, timer: 0 };
    const b = await blob;
    const ctx = audioCtx() || new (window.AudioContext || window.webkitAudioContext)();
    try { return await ctx.decodeAudioData(await b.arrayBuffer()); } catch { return null; }
  },
  cancelRec() {
    const { mr, stream } = this.rec;
    try { if (mr && mr.state !== "inactive") mr.stop(); } catch { /* ignore */ }
    (stream && stream.getTracks() || []).forEach(t => t.stop());
    this.rec = { mr: null, chunks: [], stream: null, started: 0, timer: 0 };
  },
  /* deterministic signal for the built-in self-test: pitch and rate are known */
  synth({ freq = 2400, notes = 8, dur = 2, sr = 44100 } = {}) {
    const n = Math.floor(sr * dur), data = new Float32Array(n), per = n / notes;
    for (let i = 0; i < n; i++) {
      const t = (i - Math.floor(i / per) * per) / per;
      const env = Math.sin(Math.PI * clamp(t, 0, 1)) ** 2;
      const ph = 2 * Math.PI * freq * (i / sr);
      data[i] = (Math.sin(ph) + .35 * Math.sin(2 * ph) + .12 * Math.sin(3 * ph)) * env * .4;
    }
    const buf = (audioCtx() || new (window.AudioContext || window.webkitAudioContext)()).createBuffer(1, n, sr);
    buf.copyToChannel(data, 0);
    return buf;
  },
};

/* band-energy bars for the identification screen */
function drawBands(cv, a, b) {
  const s = setupCanvas(cv, 150), { ctx, w, h } = s;
  if (!ctx) return;
  const nb = a.bands.length, pad = 22, bw = (w - pad) / nb;
  ctx.clearRect(0, 0, w, h);
  ctx.strokeStyle = css("--line"); ctx.lineWidth = 1;
  ctx.beginPath(); ctx.moveTo(pad, h - 14); ctx.lineTo(w, h - 14); ctx.stroke();
  ctx.font = "10px system-ui"; ctx.fillStyle = css("--muted");
  for (let i = 0; i < nb; i++) {
    const x = pad + i * bw;
    const scale = Math.max(...a.bands, ...(b ? b.bands : [0]), 0.02);
    const ha = (h - 22) * a.bands[i] / scale;
    ctx.fillStyle = css("--ac");
    ctx.fillRect(x + 2, h - 14 - ha, bw / 2 - 3, ha);
    if (b) {
      const hb = (h - 22) * b.bands[i] / scale;
      ctx.strokeStyle = css("--text"); ctx.lineWidth = 1.6; ctx.strokeRect(x + bw / 2, h - 14 - hb, bw / 2 - 3, hb);
    }
    ctx.fillStyle = css("--muted");
    ctx.fillText(CFG.VOICE.bands[i] + "k", x + 2, h - 3);
  }
}

/* ================================================================== AI ====
   Two engines behind one box. local() reasons over what is already in this
   device: the trait table of the curated species, the atlas rows, and your own
   birds with their weight and symptom log. cloud() sends the same grounded
   facts to a model you configure — off until you give it a base URL.
   The local half is deliberately not a chatbot: it answers the four questions
   a keeper actually asks (is this serious / which bird suits me / what does
   this species need / compare these two) with numbers it can show its work on.
   ====================================================================== */
const AI = {
  bi(en, ar) { return I18N.lang === "ar" ? ar : en; },

  /* ------------------------------------------------------------- text --- */
  /* Arabic-Indic (٠–٩) and extended-Arabic (۰–۹) digits fold to ASCII before
     anything else, so "٥ كغ" reads exactly like "5 kg" for the numeric parser
     below and still indexes like a Latin word. */
  digits(s) {
    return String(s == null ? "" : s)
      .replace(/[٠-٩]/g, c => String(c.charCodeAt(0) - 0x660))
      .replace(/[۰-۹]/g, c => String(c.charCodeAt(0) - 0x6f0));
  },
  norm(s) {
    return this.digits(s).toLowerCase()
      .replace(/[`\u064B-\u0652\u0670\u0640]/g, "")
      .replace(/[أإآ]/g, "ا").replace(/ى/g, "ي").replace(/ة/g, "ه")
      /* ي and ئ fold to a single letter, otherwise "يأكل" normalises to
         "ياكل" while a pattern written with ي never matches it */
      .replace(/[ئء]/g, "ي")
      .replace(/[^\p{L}\p{N}\s]+/gu, " ").replace(/\s+/g, " ").trim();
  },
  STOP: new Set(("a an the of and or to in is are was be do does did i you it we they this that with for on my me your some any " +
    "ما which التي الذي هؤلاء ذاك تلك في من على عن هل انا انت هو هي نحن ان كان يكون لماذا كيف اي" +
    " " + "how what which why best good should would could can tell give").split(/\s+/)),
  words(s) { return this.norm(s).split(" ").map(w => this.stripAr(w)).filter(w => w.length > 1 && !this.STOP.has(w)); },

  /* ---------------------------------------------- reading the numbers --- */
  /* A keeper writes "كم يطعم ٣ طيور وزنها ٤٥ غ في الشهر؟" — one sentence with a
     count, a body weight and a period. figures() takes every number out and
     classifies the word glued to it, so the practical answers can do arithmetic
     instead of reciting prose. Counts (birds, eggs, pairs) accumulate because
     "two cocks and four hens" is six birds; measurements keep the first value,
     which is the one people write. */
  UNITS: [
    ["kg", /^(kg|kgs|كغ|كيلو|كيلوغرام|كيلوغرامات)$/],
    ["g", /^(g|gm|gms|gram|grams|غ|غم|غرام|غرامات|جرام|جرامات)$/],
    ["cm", /^(cm|cms|سم|سنتيم|سنتيمتر|سنتيمترات)$/],
    ["mm", /^(mm|ملم|مم)$/],
    ["m", /^(m|meters?|meter|feet|foot|ft|متر|امتار|مترين|قدم|ارجل)$/],
    ["days", /^(d|day|days|يوم|يومان|يومين|ايام|ایام)$/],
    ["weeks", /^(w|week|weeks|اسبوع|اسبوعان|اسبوعين|اسابيع)$/],
    ["months", /^(mo|month|months|شهر|شهران|شهرين|اشهر|شهور)$/],
    ["years", /^(y|yr|yrs|year|years|سنه|سنة|سنين|سنوات|عام|اعوام|اعوام)$/],
    ["eggs", /^(egg|eggs|بيضة|بيض|بيضان|بيضتين)$/],
    ["birds", /^(bird|birds|طائر|طيور|طير|طائرين|عصفور|عصافير|فرد|افراد|units?)$/],
    ["pairs", /^(pair|pairs|زوج|زوجان|زوجين|ازواج|thulay|ثلاثي)$/],
    ["pct", /^(%|بالميه|نسبه)$/]
  ],
  figures(q) {
    const s = this.digits(String(q)).replace(/[،٫]\d/g, m => "." + m[1]).replace(/٬/g, "").replace(/[,]/g, " ");
    const out = { raw: [], kg: null, g: null, cm: null, mm: null, m: null, days: null, weeks: null, months: null, years: null, eggs: null, birds: null, pairs: null, pct: null, bare: null };
    const add = (k, v) => {
      if (k === "birds" || k === "eggs" || k === "pairs") out[k] = round((out[k] || 0) + v, 2);
      else if (out[k] == null) out[k] = v;
    };
    const re = /(\d+(?:\.\d+)?)\s*([^\s\d.,]*)/g;
    let mt;
    while ((mt = re.exec(s))) {
      const v = parseFloat(mt[1]);
      if (!Number.isFinite(v)) continue;
      const word = this.norm(mt[2] || "");
      const hit = this.UNITS.find(([, rx]) => rx.test(word));
      const k = hit ? hit[0] : (word ? null : "bare");
      out.raw.push({ v, u: word || null, k: k || "none" });
      if (k === "bare" && out.bare == null) out.bare = v;
      else if (k && k !== "bare") add(k, v);
    }
    /* "كم غ" with no number typed is not a figure; "كم 3" with a bare 3 in a
       food question almost always means grams, in a cage question centimetres */
    out.grams = out.g != null ? out.g : out.kg != null ? out.kg * 1000 : null;
    out.cmVal = out.cm != null ? out.cm : out.mm != null ? out.mm / 10 : out.m != null ? out.m * 100 : null;
    /* a period named without a digit — "في الشهر" — still asks for one month */
    const tn = this.norm(String(q));
    if (out.months == null && /شهر|شهري|month/.test(tn)) out.months = 1;
    if (out.weeks == null && out.months == null && /اسبوع|week/.test(tn)) out.weeks = 1;
    return out;
  },

  /* ---------------------------------------- what we were just talking --- */
  /* Follow-up questions carry no name: "وكم يحتاج من الأكل؟" only makes sense
     against the previous answer, so the last species and the last logged bird
     are persisted for this device and reused when a new question resolves to
     nothing on its own. The chip in the chat shows which answer was reused. */
  ctxGet() {
    const c = lsGet(KEYS.ctx, null);
    return c && typeof c === "object" ? c : null;
  },
  ctxSet(patch) {
    const c = Object.assign(this.ctxGet() || {}, patch);
    c.at = Date.now();
    lsSet(KEYS.ctx, c);
    return c;
  },
  ctxClear() { try { localStorage.removeItem(CFG.NS + ":" + KEYS.ctx); } catch { /* nothing to clear */ } },
  ctxSpecies() {
    const c = this.ctxGet();
    if (!c) return null;
    return (c.id && byId(c.id)) || (c.sci && SPECIES.find(x => x.sci === c.sci)) ||
      (c.sci && Atlas.get ? Atlas.get(c.sci) : null) || null;
  },
  ctxBird() {
    const c = this.ctxGet();
    if (!c || !c.birdId) return null;
    return store.birds.all().find(b => b.id === c.birdId) || null;
  },
  /* ------------------------------------------- market and pen names --- */
  /* Keepers rarely write the name the guide stores. "بدجي" and "كاسكو" and
     "زيبرا" are how the birds are bought and sold, and each of these points at
     one scientific name so a wrong entry is checkable instead of a fuzzy guess.
     Only names that unambiguously mean that bird are listed. */
  ALIAS: {
    "Melopsittacus undulatus": ["بدجي", "البدجي", "استرالي", "ببغاء استرالي", "budgie", "budgerygah"],
    "Nymphicus hollandicus": ["كوكاتيل", "الكوكاتيل", "cockatiel"],
    "Psittacus erithacus": ["كاسكو", "الكاسكو", "الببغاء الرمادي", "african grey", "grey parrot"],
    "Psittacula krameri": ["رينغ نك", "الرينغ", "ببغاء مطوق", "ringneck", "ring neck"],
    "Ara ararauna": ["الرا", "اراس", "ماكاو", "macaw", "blue and yellow"],
    "Cacatua galerita": ["كوكاتو", "الكوكاتو", "cockatoo"],
    "Trichoglossus moluccanus": ["لوري", "الببغاء اللوري", "lorikeet", "lorrie"],
    "Serinus canaria domestica": ["كناري", "الكناري", "canary"],
    "Taeniopygia guttata": ["زيبرا", "الزيبرا", "دوري مخطط", "zebra finch", "zebra"],
    "Chloebia gouldiae": ["جولديان", "الفنش الملون", "gouldian"],
    "Lonchura striata domestica": ["بنت الجافا", "سوسايتي", "bengalese", "society finch"],
    "Amandava amandava": ["المنيا الحمراء", "افادافات", "avadavat", "red munia"],
    "Poephila acuticauda": ["فنش طويل الذيل", "long tailed finch"],
    "Columba livia": ["حمام", "الحمام", "زاجل", "pigeon"],
    "Streptopelia capicola": ["يمام", "اليمام", "قمري", "dove"],
    "Streptopelia risoria": ["قمرية", "اليمامة الموضوة", "barbary dove"],
    "Geopelia cuneata": ["حمام ماسي", "diamond dove"],
    "Gallus gallus domesticus": ["دجاج", "الدجاج", "ديك", "كتكوت", "chicken", "hen", "rooster"],
    "Coturnix japonica": ["سمان", "السمان", "السماني", "quail"],
    "Phasianus colchicus": ["تدرج", "التدرج", "pheasant"],
    "Pavo cristatus": ["طاووس", "الطاووس", "peacock", "peafowl"],
    "Numida meleagris": ["دجاج غيني", "الغينية", "guinea fowl"],
    "Alectoris barbara": ["حجل", "الحجل", "partridge"],
    "Anas platyrhynchos": ["بط", "البط", "بط أخضر الرأس", "duck", "mallard"],
    "Cairina moschata": ["بط مسكوفي", "المسكوفي", "moscovy"],
    "Anser anser": ["وز", "إوز", "الإوز", "goose", "greylag"],
    "Branta canadensis": ["إوز كندي", "canada goose"],
    "Cygnus olor": ["بجع", "البجع الآخرس", "swan"],
    "Falco peregrinus": ["شاهين", "الصقر", "peregrine", "falcon"],
    "Falco tinnunculus": ["كسترجل", "الكسترجل", "هوارة", "kestrel"],
    "Parabuteo unicinctus": ["هاريس", "صقر هاريس", "harris hawk"],
    "Tyto alba": ["بوم", "الهامة", "بومة الحظائر", "barn owl", "owl"],
    "Bubo bubo": ["بومة نسرية", "eagle owl"],
    "Acridotheres tristis": ["مينا", "المينا", "هدهد هندي", "myna", "minah"],
    "Leiothrix lutea": ["ليوثريكس", "red billed leiothrix"],
    "Zosterops japonicus": ["زوستروب", "عين ابيض", "white eye", "white-eye"],
    "Fringilla coelebs": ["كمرية", "chaffinch"],
    "Carduelis carduelis": ["حسون", "الحسون", "goldfinch"],
    "Phoenicopterus roseus": ["نحام", "Flamingo", "flamingo"],
    "Aptenodytes forsteri": ["بطريق", "البطريق", "penguin"],
    "Struthio camelus": ["نعامة", "النعامة", "ostrich"],
    "Casuarius casuarius": ["كازوار", "كاسواري", "cassowary"],
    "Nestor notabilis": ["كيا", "kea"]
  },
  /* Longest alias wins per species: "ببغاء استرالي" must beat a stray "ببغاء", and
     words are compared whole (clitics folded) so "البدجي" finds "بدجي". Every
     species named in the sentence comes back in the order it appeared, which is
     what makes "قارن بين الكناري والزيبرا" find two birds instead of one. */
  aliasAll(t) {
    const toks = String(t).split(" ").map(x => this.stripAr(x));
    const found = [];
    for (const [sci, list] of Object.entries(this.ALIAS)) {
      let best = null, bestPos = -1;
      for (const a of list) {
        const at = this.norm(a).split(" ").map(x => this.stripAr(x));
        if (!at[0]) continue;
        for (let i = 0; i + at.length <= toks.length; i++) {
          let ok = true;
          for (let j = 0; j < at.length; j++) if (toks[i + j] !== at[j]) { ok = false; break; }
          if (ok && (!best || at.length > best || (at.length === best && bestPos > i))) { best = at.length; bestPos = i; }
        }
      }
      if (best) found.push([sci, bestPos]);
    }
    return found.sort((a, b) => a[1] - b[1]).map(x => x[0]);
  },
  aliasHit(t) { return this.aliasAll(t)[0] || null; },
  aliasOf(sci) { return this.ALIAS[sci] || []; },
  ctxLabel() {
    const parts = [], b = this.ctxBird(), r = this.ctxSpecies();
    if (b) parts.push(this.bi("bird", "الطائر") + " " + (b.nick || b.id));
    if (r) parts.push(this.bi("species", "النوع") + " " + speciesName(r));
    return parts.length ? parts.join(" · ") : "";
  },

  /* ------------------------------------------- semantic index (TF-IDF) --- */
  ix: null,
  invalidate() { this.ix = null; },
  corpus() {
    const rows = SPECIES.concat(Atlas.rows);
    return rows.map(r => ({ r, text: this.norm([r.en, r.ar, r.sci, r.origin, r.tip, r.habitat,
      GROUPS[r.g] ? GROUPS[r.g].en + " " + GROUPS[r.g].ar : "", r.family, r.order,
      /* market names enter the index so "كاسكو" and "بدجي"-style queries reach
         the same row a scientific name does */
      this.aliasOf ? this.aliasOf(r.sci).join(" ") : ""].filter(Boolean).join(" ")) }));
  },
  build() {
    const docs = this.corpus(), df = new Map();
    docs.forEach(d => {
      d.tf = new Map();
      for (const w of this.words(d.text)) d.tf.set(w, (d.tf.get(w) || 0) + 1);
      d.len = Math.sqrt(sum(Array.from(d.tf.values(), v => v * v)) || 1);
      for (const w of d.tf.keys()) df.set(w, (df.get(w) || 0) + 1);
    });
    const N = docs.length;
    this.ix = { docs, idf: new Map(Array.from(df, ([w, n]) => [w, Math.log(N / (n + 1)) + 1])) };
    return this.ix;
  },
  /* rank every species and atlas row by weighted word overlap — this is what
     makes "small quiet bird for an apartment" find the right animal */
  semantic(q, k = 8) {
    if (!this.ix) this.build();
    const ws = uniq(this.words(q).flatMap(w => w.length > 4 ? [w, w.slice(0, Math.max(3, w.length - 2))] : [w]));
    const vw = new Map();
    ws.forEach(w => vw.set(w, (vw.get(w) || 0) + (this.ix.idf.get(w) || 0.4)));
    const scored = this.ix.docs.map(d => {
      let dot = 0;
      vw.forEach((wv, w) => { const tf = d.tf.get(w); if (tf) dot += wv * (1 + Math.log(tf)); });
      return { r: d.r, s: dot / (d.len || 1) };
    }).filter(x => x.s > 0).sort((a, b) => b.s - a.s);
    return scored.slice(0, k);
  },

  /* --------------------------------------------- husbandry word → range --- */
  WANT: [
    [/quiet|silent|neighbo|apartment|flat|هادي|هدوء|سكون|شقه|جيران|ضوضاء قليله/, { noise: [1, 2] }, "quiet"],
    [/small|tiny|space|compact|صغي|مساحه|ضيق|مكان صغير|حجم صغير/, { space: [1, 2], sizeMax: 45 }, "small"],
    [/big|large|aviary|garden|outdoor|roomy|كبي|حديقه|حظيره|خارج|فناء/, { space: [4, 5] }, "large"],
    [/beginner|first|new|hobby|easy|simple|مبتدي|للمبتد|سهل|اول|جديد|هاوي|بسيط/, { difficulty: [1, 2] }, "easy"],
    [/cheap|low cost|budget|afford|inexpensive|رخي|تكلف|ميزاني|اقل تكلفه|اقتصادي/, { cost: [1, 2] }, "cheap"],
    [/talk|speak|mimic|imitate|vocal|word|يقلد|كلام|يتكلم|نطق|يحكي|كلم/, { talk: true }, "talking"],
    [/song|sing|warbl|melod|tune|chirp|غناء|تغريد|لحن|صوت جميل|مغرد/, { g: ["fi", "so"] }, "songster"],
    [/child|kid|famil|hand|tame|pet|touch|طفل|اطفال|عائل|اليف|يد|لمس|رفيق/, { sociability: [4, 5] }, "family-friendly"],
    [/alone|solo|independ|low maint|busy|work|منفرد|وحيد|مستقل|انشغالي|عمل|دوام/, { sociability: [1, 2] }, "independent"],
    [/long live|longevity|years|decades|عمر طويل|معمر|سنين|سنوات|يبقى طويلا/, { longevity: [18, 80] }, "long-lived"],
    [/egg|meat|breed|hatch|brood|تفريخ|بيض|لحم|تكاثر|انتاج/, { g: ["po", "wa", "do"] }, "productive"],
    [/color|colou|beaut|plumage|pretty|جمال|الوان|تلوين|جميل|زينة/, { noise: [1, 4] }, "ornamental"],
    [/flight|fly|soar|hover|طيران|يطير|جوي/, { space: [4, 5], g: ["ra", "so"] }, "flyer"],
    [/calm|gentle|docile|friendly|هدوء|هادء|لطيف|ودود|مسالم/, { sociability: [3, 5], difficulty: [1, 3] }, "gentle"],
  ],
  wants(q) { const t = this.norm(q); return this.WANT.filter(([re]) => re.test(t)); },
  /* The third WANT entry is a tag id used in routing and logs; the answer
     screen shows these readable names instead of the raw slug. */
  WISHNAME: {
    quiet: ["Quiet", "هادئ"], small: ["Small space", "مساحة صغيرة"], large: ["Large space", "مساحة واسعة"],
    easy: ["Beginner", "للمبتدئين"], cheap: ["Low cost", "رخيص"], talking: ["Talks", "يقلّد الكلام"],
    songster: ["Sings", "مُغَرِّد"], "family-friendly": ["With children", "مناسب للاطفال"],
    independent: ["Stays alone", "يتحمّل الوحدة"], "long-lived": ["Long lived", "طويل العمر"],
    productive: ["Eggs or meat", "للانتاج"], ornamental: ["Showy", "للزينة"], flyer: ["Strong flyer", "قوي الطيران"],
    gentle: ["Gentle", "لطيف"]
  },
  wishName(slug) { const w = this.WISHNAME[slug]; return w ? this.bi(w[0], w[1]) : slug; },

  /* ------------------------------------------------ health vocabulary --- */
  SYMPTOMS: [
    { k: "breathing", en: "open-mouthed breathing, tail bobbing, wheeze, click when breathing, blue tongue",
